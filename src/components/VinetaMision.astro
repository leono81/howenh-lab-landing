---
// Viñeta de la Misión Salesiana para el mapa: la capilla (1898) en tres cuartos, como en
// flow/ref-mision-30.png, con la escuela larga detrás y el cerco de tablas adelante.
// Va dentro del <svg> del mapa; (x, y) es el punto de la capilla en el mapa.
interface Props {
  x: number;
  y: number;
  escala?: number;
}
const { x, y, escala = 1 } = Astro.props;

type P = [number, number];
// proyección oblicua: x a lo ancho del frente, y hacia arriba negativo, d en profundidad (atrás a la derecha)
const p = (px: number, py: number, d: number): P => [px + d * 0.85, py - d * 0.32];
const pol = (...pts: P[]) => 'M' + pts.map(([a, b]) => `${a.toFixed(1)} ${b.toFixed(1)}`).join('L') + 'Z';
const lin = (...pts: P[]) => 'M' + pts.map(([a, b]) => `${a.toFixed(1)} ${b.toFixed(1)}`).join('L');
// rayado entre dos bordes: n líneas que van de a1→a2 a b1→b2 (para tablas y chapas)
const rayas = (a1: P, a2: P, b1: P, b2: P, n: number) => {
  let d = '';
  for (let i = 1; i < n; i++) {
    const t = i / n;
    d += lin([a1[0] + (b1[0] - a1[0]) * t, a1[1] + (b1[1] - a1[1]) * t], [a2[0] + (b2[0] - a2[0]) * t, a2[1] + (b2[1] - a2[1]) * t]);
  }
  return d;
};

// escuela: bloque largo y bajo detrás, a la izquierda
const E = { x0: -78, x1: -8, h: 15, d: 34, prof: 14 };
const escFrente = pol(p(E.x0, 0, E.d), p(E.x1, 0, E.d), p(E.x1, -E.h, E.d), p(E.x0, -E.h, E.d));
const escTecho = pol(p(E.x0, -E.h, E.d), p(E.x1, -E.h, E.d), p(E.x1, -E.h - 6, E.d + E.prof / 2), p(E.x0, -E.h - 6, E.d + E.prof / 2));
const escVentanas = Array.from({ length: 9 }, (_, i) => {
  const vx = E.x0 + 5 + i * 7.4;
  return pol(p(vx, -9, E.d), p(vx + 3.6, -9, E.d), p(vx + 3.6, -6, E.d), p(vx, -6, E.d));
}).join('');

// capilla
const A = 13; // medio ancho del frente
const fachada = pol(p(-A, 0, 0), p(A, 0, 0), p(A, -30, 0), p(0, -44, 0), p(-A, -30, 0));
const lateral = pol(p(A, 0, 0), p(A, 0, 56), p(A, -23, 56), p(A, -23, 0));
const techo = pol(p(A, -23, 3), p(A, -23, 58), p(0, -37, 58), p(0, -37, 3));
const techoRayas = rayas(p(A, -23, 3), p(0, -37, 3), p(A, -23, 58), p(0, -37, 58), 16);
const tablasLat = rayas(p(A, -23, 0), p(A, -23, 56), p(A, 0, 0), p(A, 0, 56), 9);
// crucero: ala que sale del costado, con su hastial
const C0 = 22, C1 = 38, CX = 28;
const cruceroFrente = pol(p(A, 0, C0), p(CX, 0, C0), p(CX, -19, C0), p(A, -19, C0));
const cruceroHastial = pol(p(CX, 0, C0), p(CX, 0, C1), p(CX, -19, C1), p(CX, -28, (C0 + C1) / 2), p(CX, -19, C0));
const cruceroTecho = pol(p(A, -19, C0), p(CX, -19, C0), p(CX, -28, (C0 + C1) / 2), p(A, -28, (C0 + C1) / 2));
const cruceroRayas = rayas(p(A, -19, C0), p(A, -28, (C0 + C1) / 2), p(CX, -19, C0), p(CX, -28, (C0 + C1) / 2), 7);
const ventanaLat = [10, 44].map((d) => pol(p(A, -15, d), p(A, -15, d + 4), p(A, -8, d + 4), p(A, -8, d))).join('');
// torre: sale de atrás del frontón
const T = 5.5, T0 = 2, T1 = 10;
const torreFrente = pol(p(-T, -36, T0), p(T, -36, T0), p(T, -66, T0), p(-T, -66, T0));
const torreLado = pol(p(T, -36, T0), p(T, -36, T1), p(T, -66, T1), p(T, -66, T0));
const techoTorreF = pol(p(-T - 1, -66, T0 - 1), p(T + 1, -66, T0 - 1), p(0, -82, (T0 + T1) / 2));
const techoTorreL = pol(p(T + 1, -66, T0 - 1), p(T + 1, -66, T1 + 1), p(0, -82, (T0 + T1) / 2));
const rayasTorreF = rayas(p(-T - 1, -66, T0 - 1), p(0, -82, (T0 + T1) / 2), p(T + 1, -66, T0 - 1), p(0, -82, (T0 + T1) / 2), 6);
const rayasTorreL = rayas(p(T + 1, -66, T0 - 1), p(0, -82, (T0 + T1) / 2), p(T + 1, -66, T1 + 1), p(0, -82, (T0 + T1) / 2), 4);
const [cx, cy] = p(0, -82, (T0 + T1) / 2);
// campanario: arco abierto con la campana
const [ax, ay] = p(0, -54, T0);
// puerta con su abanico
const [px0, py0] = p(0, -12, 0);
const abanico = Array.from({ length: 5 }, (_, i) => {
  const a = Math.PI + (Math.PI * (i + 1)) / 6;
  return `M${px0} ${py0}l${(Math.cos(a) * 5).toFixed(1)} ${(Math.sin(a) * 5).toFixed(1)}`;
}).join('');
// cerco de tablas adelante
const cerco = Array.from({ length: 26 }, (_, i) => {
  const fx = -44 + i * 3.6;
  return lin(p(fx, 9, -8), p(fx, 4, -8));
}).join('') + lin(p(-45, 7.5, -8), p(49, 7.5, -8));
---
<g class="vineta-mision" transform={`translate(${x} ${y}) scale(${escala})`} fill="none" stroke="var(--tinta)" stroke-linejoin="round" stroke-linecap="round">
  <!-- escuela -->
  <path d={escTecho} fill="var(--papel)" stroke-width="0.8" />
  <path d={rayas(p(E.x0, -E.h, E.d), p(E.x0, -E.h - 6, E.d + E.prof / 2), p(E.x1, -E.h, E.d), p(E.x1, -E.h - 6, E.d + E.prof / 2), 22)} stroke-width="0.45" />
  <path d={escFrente} fill="var(--papel)" stroke-width="0.8" />
  <path d={escVentanas} fill="none" stroke-width="0.5" />

  <!-- capilla: costado, crucero y techos (las chapas rojas van rayadas) -->
  <path d={lateral} fill="var(--papel)" stroke-width="0.9" />
  <path d={tablasLat} stroke="var(--tinta-suave)" stroke-width="0.35" />
  <path d={ventanaLat} fill="var(--tinta)" stroke="none" />
  <path d={techo} fill="var(--papel)" stroke-width="0.9" />
  <path d={techoRayas} stroke-width="0.55" />
  <path d={cruceroHastial} fill="var(--papel)" stroke-width="0.9" />
  <path d={cruceroFrente} fill="var(--papel)" stroke-width="0.9" />
  <path d={cruceroTecho} fill="var(--papel)" stroke-width="0.9" />
  <path d={cruceroRayas} stroke-width="0.55" />

  <!-- torre -->
  <path d={torreLado} fill="var(--papel)" stroke-width="0.9" />
  <path d={rayas(p(T, -36, T0), p(T, -36, T1), p(T, -66, T0), p(T, -66, T1), 8)} stroke="var(--tinta-suave)" stroke-width="0.35" />
  <path d={torreFrente} fill="var(--papel)" stroke-width="0.9" />
  <path d={`M${ax - 3} ${ay + 5}V${ay - 1}a3 3 0 0 1 6 0V${ay + 5}Z`} fill="var(--tinta)" stroke="none" />
  <path d={`M${ax - 1.3} ${ay + 1.8}q1.3 -3.2 2.6 0Z`} fill="var(--papel)" stroke="none" />
  <path d={lin(p(-T, -46, T0), p(T, -46, T0), p(T, -46, T1))} stroke-width="1.1" />
  <path d={lin(p(-T, -64, T0), p(T, -64, T0), p(T, -64, T1))} stroke-width="1.1" />
  <path d={techoTorreL} fill="var(--papel)" stroke-width="0.9" />
  <path d={rayasTorreL} stroke-width="0.6" />
  <path d={techoTorreF} fill="var(--papel)" stroke-width="0.9" />
  <path d={rayasTorreF} stroke-width="0.6" />
  <path d={`M${cx} ${cy}v-7M${cx - 2.4} ${cy - 4.8}h4.8`} stroke-width="0.9" />

  <!-- frente: frontón con molduras (las verdes, en tinta llena), puerta con abanico -->
  <path d={fachada} fill="var(--papel)" stroke-width="1" />
  <path d={lin(p(-A, -30, 0), p(0, -44, 0), p(A, -30, 0))} stroke-width="1.8" />
  <path d={lin(p(-A - 1, -30, 0), p(A + 1, -30, 0))} stroke-width="1.8" />
  <path d={lin(p(-A - 1, -19, 0), p(A + 1, -19, 0))} stroke-width="1.4" />
  <path d={lin(p(-A + 4, 0, 0), p(-A + 4, -19, 0)) + lin(p(A - 4, 0, 0), p(A - 4, -19, 0))} stroke="var(--tinta-suave)" stroke-width="0.5" />
  <path d={`M${px0 - 5} ${py0}a5 5 0 0 1 10 0Z`} fill="var(--papel)" stroke-width="1" />
  <path d={abanico} stroke-width="0.4" />
  <path d={`M${px0 - 5} ${py0}h10v12h-10Z`} fill="var(--tinta)" stroke="none" />
  <path d={`M${px0 - 2.5} ${py0 + 4}l1.6 2.6l-1.6 2.6l-1.6 -2.6ZM${px0 + 2.5} ${py0 + 4}l1.6 2.6l-1.6 2.6l-1.6 -2.6Z`} fill="var(--papel)" stroke="none" />

  <!-- cerco -->
  <path d={cerco} stroke-width="0.6" />
</g>
