---
// Vista del Cabo Domingo desde la playa, al sudeste, en grabado de una tinta.
// Dibujada a partir de fotografías (flow/ref-cabo-24.png y 26.png): meseta plana que sube
// hacia la punta, borde de roca casi vertical arriba, ladera con cárcavas abajo, y la baliza
// en el punto más alto, al filo. Las formas están en coordenadas de la foto 24 (500 x 333).
const W = 960, H = 340;
const X = (x: number) => 40 + x * 1.72;
const Y = (y: number) => 262 - (238 - y) * 1.3;
type P = [number, number];
const camino = (pts: P[], cerrar = true) => 'M' + pts.map(([x, y]) => `${X(x).toFixed(1)} ${Y(y).toFixed(1)}`).join('L') + (cerrar ? 'Z' : '');

// silueta, de la meseta (izquierda) a la punta (derecha) y abajo hasta la playa
const silueta: P[] = [
  [-40, 99], [0, 97], [30, 95], [60, 97], [85, 92], [100, 86], [118, 78], [135, 73], [160, 69], [190, 67], [225, 66], [255, 64],
  [272, 61], [290, 62], [308, 64], [316, 66], [322, 70], [326, 77], [328, 92], [331, 108], [338, 118], [347, 127],
  [352, 140], [357, 153], [366, 166], [371, 181], [374, 196], [382, 208], [392, 222], [406, 237],
];
const BASE = 238;
// borde superior de la pared que mira al mar (separa la meseta de la ladera)
const borde: P[] = [[88, 97], [120, 93], [160, 91], [200, 89], [240, 87], [275, 83], [300, 79], [312, 74], [320, 69]];
const cara: P[] = [...silueta, [406, BASE], [-40, BASE]];
const meseta: P[] = [...silueta.filter(([x]) => x <= 320), ...[...borde].reverse(), [-40, 101]];
const roca: P[] = [[240, 87], [275, 83], [300, 79], [312, 74], [320, 69], [326, 77], [328, 92], [331, 108], [338, 118], [300, 126], [272, 116], [248, 102]];
const rocaBaja: P[] = [
  [338, 118], [347, 127], [352, 140], [357, 153], [366, 166], [371, 181], [374, 196], [382, 208], [392, 222], [406, 237],
  [406, BASE], [302, BASE], [272, 205], [258, 165], [252, 132], [272, 116], [300, 126],
];
const carcavas: P[][] = [
  [[195, 91], [205, 112], [217, 138], [233, 176], [250, 212], [260, 237]],
  [[150, 93], [156, 120], [166, 160], [175, 200], [180, 236]],
  [[110, 98], [113, 130], [118, 175], [121, 236]],
  [[262, 100], [266, 130], [272, 170], [285, 210], [292, 236]],
];
// cornisas de la roca baja (capas que sobresalen)
const cornisas: P[][] = [
  [[305, 126], [322, 129], [344, 129]],
  [[285, 150], [312, 153], [350, 149]],
  [[300, 179], [330, 182], [369, 181]],
  [[318, 207], [350, 209], [383, 210]],
  [[262, 140], [280, 143]],
  [[268, 192], [290, 194]],
];

// trazo a mano: subdivide y mueve un poco cada punto
function amano(pts: P[], amp: number): P[] {
  const out: P[] = [];
  for (let i = 0; i < pts.length - 1; i++) {
    const [a, b] = [pts[i], pts[i + 1]];
    for (let k = 0; k < 4; k++) {
      const t = k / 4;
      out.push([a[0] + (b[0] - a[0]) * t + (azar() - 0.5) * amp, a[1] + (b[1] - a[1]) * t + (azar() - 0.5) * amp]);
    }
  }
  out.push(pts[pts.length - 1]);
  return out;
}
// rayado: líneas paralelas con ángulo y separación, para recortar con un clipPath
let semilla = 23;
const azar = () => (semilla = (semilla * 16807) % 2147483647) / 2147483647;
function rayado(angulo: number, sep: number, x0 = 0, x1 = W, corte = 1) {
  const a = (angulo * Math.PI) / 180, dx = Math.cos(a), dy = Math.sin(a);
  const nx = -dy, ny = dx, L = W + H;
  let d = '';
  for (let t = -L; t < L; t += sep * (0.85 + azar() * 0.3)) {
    if (azar() > corte) continue;
    const cx = W / 2 + nx * t, cy = H / 2 + ny * t;
    const x1c = cx - dx * L, y1c = cy - dy * L, x2c = cx + dx * L, y2c = cy + dy * L;
    if (Math.max(x1c, x2c) < x0 || Math.min(x1c, x2c) > x1) continue;
    d += `M${x1c.toFixed(1)} ${y1c.toFixed(1)}L${x2c.toFixed(1)} ${y2c.toFixed(1)}`;
  }
  return d;
}
// pasto de la meseta: rayitas cortas horizontales sueltas
const cornisasD = cornisas.map((c) => camino(amano(c, 2.2), false));
const carcavasD = carcavas.map((c) => camino(amano(c, 2.6), false));
const pasto = Array.from({ length: 260 }, () => {
  const x = X(azar() * 320), y = Y(62 + azar() * 38), l = 3 + azar() * 6;
  return `M${x.toFixed(1)} ${y.toFixed(1)}h${l.toFixed(1)}`;
}).join('');
// canto rodado de la playa
const piedras = Array.from({ length: 140 }, () => {
  const x = X(-20 + azar() * 380), y = Y(BASE) + 3 + azar() * 16;
  return `M${x.toFixed(1)} ${y.toFixed(1)}h${(1 + azar() * 2.2).toFixed(1)}`;
}).join('');
const mar = Array.from({ length: 16 }, (_, k) => {
  const y = Y(BASE) + 2 + k * k * 0.32 + k * 1.6;
  return `M${X(406) + 6} ${y.toFixed(1)}H${W}`;
}).join('');
const playaMar = Array.from({ length: 9 }, (_, k) => {
  const y = Y(BASE) + 24 + k * 4.2 + k * k * 0.5;
  return `M0 ${y.toFixed(1)}H${W}`;
}).join('');
const [fx, fy] = [X(272), Y(61)];
---
<figure class="vista">
  <svg viewBox={`0 0 ${W} ${H}`} aria-hidden="true">
    <defs>
      <clipPath id="v-cara"><path d={camino(cara)} /></clipPath>
      <clipPath id="v-meseta"><path d={camino(meseta)} /></clipPath>
      <clipPath id="v-roca"><path d={camino(roca)} /></clipPath>
      <clipPath id="v-roca-baja"><path d={camino(rocaBaja)} /></clipPath>
      <linearGradient id="v-fundido" x1="0" x2="1">
        <stop offset="0" stop-color="#fff" stop-opacity="0" />
        <stop offset="0.2" stop-color="#fff" />
        <stop offset="0.92" stop-color="#fff" />
        <stop offset="1" stop-color="#fff" stop-opacity="0" />
      </linearGradient>
      <linearGradient id="v-fundido-abajo" x1="0" x2="0" y1={Y(BASE)} y2={H} gradientUnits="userSpaceOnUse">
        <stop offset="0" stop-color="#fff" />
        <stop offset="1" stop-color="#fff" stop-opacity="0" />
      </linearGradient>
      <mask id="v-bordes" maskUnits="userSpaceOnUse" x="0" y="0" width={W} height={H}>
        <rect width={W} height={H} fill="url(#v-fundido)" />
      </mask>
      <!-- la sombra crece hacia la punta: la luz viene de la izquierda -->
      <linearGradient id="v-sombra-g" x1={X(120)} x2={X(300)} y1="0" y2="0" gradientUnits="userSpaceOnUse">
        <stop offset="0" stop-color="#fff" stop-opacity="0" />
        <stop offset="1" stop-color="#fff" />
      </linearGradient>
      <mask id="v-sombra" maskUnits="userSpaceOnUse" x="0" y="0" width={W} height={H}>
        <rect width={W} height={H} fill="url(#v-sombra-g)" />
      </mask>
      <mask id="v-abajo" maskUnits="userSpaceOnUse" x="0" y="0" width={W} height={H}>
        <rect width={W} height={H} fill="url(#v-fundido-abajo)" />
      </mask>
    </defs>

    <g mask="url(#v-bordes)" fill="none" stroke="var(--tinta)" stroke-linecap="round">
      <!-- mar y playa -->
      <g mask="url(#v-abajo)">
        <path d={mar} stroke="var(--tinta-suave)" stroke-width="0.6" />
        <path d={playaMar} stroke="var(--tinta-suave)" stroke-width="0.5" />
        <path d={piedras} stroke-width="0.9" />
      </g>

      <!-- ladera que mira al mar: rayado oblicuo, y más cerrado hacia la roca -->
      <g clip-path="url(#v-cara)">
        <path d={rayado(66, 4.4)} stroke-width="0.5" />
        <path d={rayado(90, 3.2, 0, W, 0.85)} stroke-width="0.45" mask="url(#v-sombra)" />
      </g>
      <!-- meseta: clara, con pasto -->
      <path d={camino(meseta)} fill="var(--papel)" stroke="none" />
      <g clip-path="url(#v-meseta)">
        <path d={rayado(-4, 6.5, 0, W, 0.7)} stroke="var(--tinta-suave)" stroke-width="0.4" />
        <path d={pasto} stroke="var(--tinta-suave)" stroke-width="0.6" />
      </g>
      <!-- borde de roca arriba: capas horizontales y grietas verticales -->
      <path d={camino(roca)} fill="var(--papel)" stroke="none" />
      <g clip-path="url(#v-roca)">
        <path d={rayado(1, 3.2)} stroke-width="0.75" />
        <path d={rayado(92, 4.5, 0, W, 0.6)} stroke-width="0.45" />
      </g>
      <!-- roca baja, a la sombra: vertical cerrado -->
      <path d={camino(rocaBaja)} fill="var(--papel)" stroke="none" />
      <g clip-path="url(#v-roca-baja)">
        <path d={rayado(88, 2.2)} stroke-width="0.7" />
        <path d={rayado(30, 5, 0, W, 0.5)} stroke-width="0.4" />
      </g>
      {cornisasD.map((d) => <path d={d} stroke-width="1.1" />)}
      {carcavasD.map((d) => <path d={d} stroke-width="1.2" />)}
      <path d={camino(borde, false)} stroke-width="1.2" />

      <!-- silueta y playa -->
      <path d={camino(silueta, false)} stroke-width="2.2" stroke-linejoin="round" />
      <path d={`M${X(-40)} ${Y(BASE)}H${X(406)}`} stroke-width="1.4" />
    </g>

    <!-- la baliza, en el punto más alto: torre de reticulado blanca, panel de tablillas, linterna -->
    <g class="baliza" transform={`translate(${fx} ${fy})`} fill="none" stroke="var(--tinta)" stroke-linecap="round">
      <path d="M-3.4 0L-1 -19M3.4 0L1 -19" stroke-width="1.1" />
      <path d="M-2.9 -4L2.4 -8.5M2.9 -4L-2.4 -8.5M-2.3 -9L1.8 -13.5M2.3 -9L-1.8 -13.5" stroke-width="0.5" />
      <rect x="-4.2" y="-18.5" width="8.4" height="6.5" fill="var(--papel)" stroke-width="0.8" />
      <path d="M-4.2 -16.3h8.4M-4.2 -14.2h8.4" stroke-width="0.5" />
      <path d="M-1 -19L-10 0M1 -19L10 0" stroke-width="0.3" stroke-dasharray="1 1.4" />
      <rect x="-1.8" y="-23" width="3.6" height="4" fill="var(--papel)" stroke-width="0.8" />
      <path d="M-2.3 -23L0 -25L2.3 -23" stroke-width="0.8" />
    </g>
  </svg>
  <figcaption>Vista desde la playa, al sudeste · dibujo a partir de fotografías</figcaption>
</figure>

<style>
  .vista {
    margin: 0;
  }
  svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  figcaption {
    margin-top: 6px;
    text-align: center;
    font: 400 10px var(--mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--tinta-suave);
  }
</style>
