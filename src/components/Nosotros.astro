---
// Nosotros (solo letra) y Contacto, que cierra con el cabo de la maqueta y su luz encendida
// (elegido en el canvas, opción C, 2026-11-11). Sin nombres de personas (Leono, 2026-11-10), sin
// significados de las palabras hasta que estén confirmados y sin nombrar la ciudad (Leono,
// 2026-11-11): quien es de acá la reconoce.
// El cabo no se dibuja de nuevo: es la misma lámina del hero (#maqueta-lamina) y el mismo haz
// (#haz-baliza), reusados con <use> y vistos por una ventana sobre la baliza.
// Debajo de Desde la isla, a todo el ancho, un albatros de ceja negra planea sobre el mar grabado
// (canvas «Desde la isla: aves», 2026-11-12; src/scripts/albatros.ts, que baja recién al acercarse).
const agenda = 'https://calendar.app.google/ucnmS77YVC4ax2TE9';
const ventana = '1424.4 312.2 214.5 214.5'; // unidades de la maqueta, con la linterna a 154,59 del borde
---
<section class="seccion nosotros" id="nosotros" aria-labelledby="nos-titulo">
  <h2 id="nos-titulo">Desde la isla</h2>
  <div class="cuerpo">
    <p class="dicho">Howenh Labs trabaja sobre la costa atlántica de Tierra del Fuego. Hacemos software para el lugar donde vivimos y, desde acá, para el resto del país.</p>
    <p>Esta tierra tenía nombre mucho antes de llamarse Tierra del Fuego. Ahí tiene raíz nuestra identidad, y de ahí vienen nuestros nombres: de las lenguas de sus pueblos originarios, las primeras voces de la isla.</p>
  </div>
  <noscript><style>.mar { display: none; }</style></noscript>
  <figure class="mar">
    <svg role="img" aria-label="Un albatros de ceja negra planea sobre el mar, con su sombra en el agua"></svg>
  </figure>
</section>

<script>
  // el albatros: su código baja recién cuando la sección se acerca a la pantalla
  const lienzo = document.querySelector<SVGSVGElement>('.mar svg');
  if (lienzo) {
    const io = new IntersectionObserver(
      ([e]) => {
        if (!e.isIntersecting) return;
        io.disconnect();
        import('../scripts/albatros').then((m) => m.iniciar(lienzo));
      },
      { rootMargin: '600px 0px' },
    );
    io.observe(lienzo);
  }
</script>

<slot /><!-- lo que va entre Desde la isla y Hablemos (los programas) -->

<section class="seccion contacto" id="contacto" aria-labelledby="contacto-titulo">
  <div class="texto">
    <h2 id="contacto-titulo">Hablemos</h2>
    <p class="entrada">Contanos qué necesitás y coordinamos una reunión. Si querés trabajar con nosotros, también es por acá.</p>
    <div class="acciones">
      <a class="primario" href={agenda} target="_blank" rel="noopener">Agendar una reunión →</a>
      <a class="secundario" href="mailto:contacto@howenh-labs.com">contacto@howenh-labs.com</a>
    </div>
  </div>
  <figure class="cabo">
    <svg viewBox={ventana} role="img" aria-label="El cabo de la lámina de arriba, con la baliza encendida sobre el acantilado y el mar abajo">
      <use href="#maqueta-lamina" />
    </svg>
    <!-- la luz en su propia capa, como en el hero: lo que se mueve no redibuja el grabado -->
    <svg class="luz" viewBox={ventana} aria-hidden="true">
      <use href="#haz-baliza" />
    </svg>
  </figure>
</section>

<style>
  .nosotros {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 32px clamp(40px, 6vw, 112px);
  }
  .cuerpo p {
    font-size: clamp(16px, 1.25vw, 18px);
    line-height: 1.55;
    max-width: 52ch;
  }
  .cuerpo .dicho {
    margin-bottom: 24px;
    font: 400 clamp(24px, 2.4vw, 36px) / 1.22 var(--serif);
    max-width: 24em;
    text-wrap: pretty;
  }
  /* el mar del albatros: a sangre por los dos lados, y se apaga en el papel por los cuatro (papel
     pintado encima, sin rectas ni máscaras) */
  .mar {
    grid-column: 1 / -1;
    position: relative;
    margin: 8px calc(-1 * var(--margen)) 0;
    height: clamp(240px, 27vw, 380px);
  }
  .mar svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .mar::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(to right, var(--papel), rgb(246 247 251 / 0) 14%, rgb(246 247 251 / 0) 86%, var(--papel)),
      linear-gradient(to bottom, var(--papel), rgb(246 247 251 / 0) 22%, rgb(246 247 251 / 0) 78%, var(--papel));
  }
  /* Hablemos a la izquierda y, a sangre por la derecha, el cabo que se apaga en el papel */
  .contacto {
    padding-top: clamp(24px, 4vw, 72px);
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    align-items: start;
    gap: 0 clamp(40px, 6vw, 112px);
  }
  .contacto .texto {
    padding-top: clamp(80px, 11vw, 190px);
  }
  .contacto .acciones {
    margin-top: 28px;
  }
  .cabo {
    position: relative;
    justify-self: end;
    width: min(680px, 100% + var(--margen));
    aspect-ratio: 1;
    margin: calc(-1 * clamp(30px, 5vw, 90px)) calc(-1 * var(--margen)) 0 0;
  }
  .cabo svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .cabo .luz {
    pointer-events: none;
    will-change: transform;
  }
  /* el apagado: papel pintado encima (sin máscaras), hacia el texto, hacia el pie y arriba */
  .cabo::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(to right, var(--papel), rgb(246 247 251 / 0.85) 14%, transparent 38%),
      linear-gradient(to top, var(--papel), rgb(246 247 251 / 0.8) 11%, transparent 30%),
      linear-gradient(to bottom, var(--papel), transparent 10%);
  }
  @media (max-width: 900px) {
    .nosotros,
    .contacto {
      grid-template-columns: 1fr;
    }
    .contacto {
      padding-top: 72px;
    }
    .contacto .texto {
      padding-top: 0;
    }
    /* a sangre por los dos lados en el teléfono; en tablet, contra la derecha */
    .cabo {
      width: min(600px, 100% + 2 * var(--margen));
      margin-top: 8px;
    }
  }
</style>
