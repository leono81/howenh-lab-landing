---
// Viñeta de la Antigua Torre de Aguas (plaza Almirante Brown) para el mapa, según
// flow/3-torre-de-agua-dia.jpg: torre ochavada apenas ahusada, cornisa saliente arriba,
// óculos, reloj, dos ventanas angostas y pórtico con frontón en la base.
// Va dentro del <svg> del mapa; (x, y) es la base de la torre.
interface Props {
  x: number;
  y: number;
  escala?: number;
}
const { x, y, escala = 1 } = Astro.props;

const ALTO = 62;
// octógono visto de frente: cara central = 0,414 del ancho, laterales escorzadas
const ancho = (v: number) => 22 - (4 * -v) / ALTO; // 22 abajo, 18 arriba
const borde = (v: number) => (ancho(v) * 0.414) / 2; // mitad de la cara central
const f = (n: number) => n.toFixed(1);
const cuerpo = `M${f(-ancho(0) / 2)} 0L${f(ancho(0) / 2)} 0L${f(ancho(-ALTO) / 2)} ${-ALTO}L${f(-ancho(-ALTO) / 2)} ${-ALTO}Z`;
const caraIzq = `M${f(-ancho(0) / 2)} 0L${f(-borde(0))} 0L${f(-borde(-ALTO))} ${-ALTO}L${f(-ancho(-ALTO) / 2)} ${-ALTO}Z`;
const caraDer = `M${f(borde(0))} 0L${f(ancho(0) / 2)} 0L${f(ancho(-ALTO) / 2)} ${-ALTO}L${f(borde(-ALTO))} ${-ALTO}Z`;
const aristas = `M${f(-borde(0))} 0L${f(-borde(-ALTO))} ${-ALTO}M${f(borde(0))} 0L${f(borde(-ALTO))} ${-ALTO}`;
// sombra: rayado vertical en las caras laterales (la izquierda, más oscura)
const rayado = (x0: number, x1: number, n: number) =>
  Array.from({ length: n }, (_, i) => {
    const t = (i + 0.5) / n;
    const xb = x0 + (x1 - x0) * t;
    const xt = xb * (ancho(-ALTO) / ancho(0));
    return `M${f(xb)} 0L${f(xt)} ${-ALTO}`;
  }).join('');
---
<g class="vineta-torre" transform={`translate(${x} ${y}) scale(${escala})`} fill="none" stroke="var(--tinta)" stroke-linejoin="round" stroke-linecap="round">
  <!-- recorte de papel alrededor, para que se lea sobre las manzanas rayadas -->
  <path d={cuerpo + 'M-8 0V-12L0 -18L8 -12V0Z' + 'M-12 -62H12V-67H-10V-69H10V-67'} stroke="var(--papel)" stroke-width="5" fill="var(--papel)" />

  <path d={cuerpo} fill="var(--papel)" stroke-width="1" />
  <path d={caraIzq} fill="var(--papel)" stroke="none" />
  <path d={rayado(-ancho(0) / 2, -borde(0), 6)} stroke-width="0.6" />
  <path d={rayado(borde(0), ancho(0) / 2, 3)} stroke="var(--tinta-suave)" stroke-width="0.4" />
  <path d={aristas} stroke-width="0.7" />
  <path d={cuerpo} stroke-width="1" />

  <!-- cornisa saliente y remate plano -->
  <path d="M-11.5 -62H11.5V-66H-11.5Z" fill="var(--papel)" stroke-width="1" />
  <path d="M-11.5 -64H11.5" stroke-width="0.5" />
  <path d="M-10 -66V-68.5H10V-66" fill="var(--papel)" stroke-width="0.9" />
  <!-- óculos en las caras laterales -->
  <circle cx="-6.6" cy="-58" r="1.1" fill="var(--tinta)" stroke="none" />
  <circle cx="6.6" cy="-58" r="1.1" fill="var(--papel)" stroke-width="0.6" />
  <!-- reloj -->
  <circle cx="0" cy="-53" r="3.4" fill="var(--papel)" stroke-width="0.9" />
  <path d="M0 -53V-55.4M0 -53L1.6 -52.2" stroke-width="0.6" />
  <!-- ventanas angostas -->
  <path d="M-1 -42h2v-6h-2ZM-1 -29h2v-6h-2Z" fill="var(--tinta)" stroke="none" />
  <!-- pórtico con frontón y puerta -->
  <path d="M-7 0V-11L0 -17L7 -11V0" fill="var(--papel)" stroke-width="0.9" />
  <path d="M-7.6 -11L0 -17.6L7.6 -11" stroke-width="1.2" />
  <path d="M-2.6 0V-6a2.6 2.6 0 0 1 5.2 0V0Z" fill="var(--tinta)" stroke="none" />
  <path d="M-12 0.5H12" stroke-width="0.9" />
</g>
