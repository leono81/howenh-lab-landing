---
// Facturación y contabilidad, debajo de Kenos (Leono eligió la «recomendada» del canvas
// «Facturación · bosquejos», 2026-11-11). A la izquierda, Hown y Yon (facturan) y Kaux (contable);
// a la derecha, una mesa grabada donde se ve el recorrido: el comprobante sale de Hown o de Yon,
// pasa por Teken (el motor interno, no se ofrece al público) a ARCA y vuelve con el CAE; Kaux trae
// de ARCA el libro de IVA, el contador lo revisa y lo sube él (todavía no es automático).
// Todo lo de la mesa corre con un solo reloj SMIL de 18 s; el script de abajo lee ese reloj para
// marcar la fila del producto que actúa y mostrar su recuadro de detalle (como en un atlas).
const DUR = 18;
type Paso = [number, string | number];
const k = (t: number) => +(t / DUR).toFixed(4);
// una animación SMIL a partir de pares [segundo, valor]; dos valores iguales seguidos son una pausa
const anim = (pasos: Paso[], curva?: string) => ({
  dur: `${DUR}s`,
  repeatCount: 'indefinite',
  values: pasos.map(([, v]) => v).join(';'),
  keyTimes: pasos.map(([t]) => k(t)).join(';'),
  ...(curva && { calcMode: 'spline', keySplines: pasos.slice(1).map(() => curva).join(';') }),
});
const CAE_CURVA = '0.3 0.7 0.2 1';
// se ve entre a y b
const entre = (a: number, b: number, fin = DUR): Paso[] => [[0, 0], [a, 0], [a + 0.06, 1], [b, 1], [b + 0.06, 0], [fin, 0]];
// se traza entre a y b (con pathLength="1") y queda
const traza = (a: number, b: number): Paso[] => [[0, 1], [a, 1], [b, 0], [DUR, 0]];

// los caminos, en el plano de la mesa (u a lo largo, v hacia adelante)
const R = {
  hown: 'M20 13C32 13 38 27 48 27',
  yon: 'M28 38C36 38 40 33 48 33',
  ida: 'M64 26C74 26 80 15 88 14',
  cae: 'M88 18C80 19 74 30 64 30',
  trae: 'M100 22C100 30 92 33 88 38',
  sube: 'M104 40C108 33 108 27 106 22',
};
// lo que viaja: comprobantes, el CAE (magenta) y el libro de IVA
const viaja = (d: string, a: number, b: number) => ({
  mov: { path: d, keyPoints: '0;0;1;1', keyTimes: `0;${k(a)};${k(b)};1`, calcMode: 'linear', dur: `${DUR}s`, repeatCount: 'indefinite' },
  op: anim(entre(a, b)),
});
const viajes = {
  hown: viaja(R.hown, 1.2, 3),
  ida: viaja(R.ida, 4, 5.4),
  cae: viaja(`${R.cae}L48 27C38 27 32 13 20 13`, 5.4, 6.9),
  cola: [
    viaja('M31.5 43C38 43 42 33 48 33', 9.5, 10.4),
    viaja('M35.5 43C40 43 43 33 48 33', 9.9, 10.8),
    viaja('M39.5 43C42 43 44 33 48 33', 10.3, 11.2),
  ],
  trae: viaja(R.trae, 11.3, 12.6),
  sube: viaja(R.sube, 14.4, 15.8),
};
// la fila de espera de Yon cuando no hay señal
const cola = [
  { x: 30.2, ve: 8.5, sale: 9.5 },
  { x: 34.2, ve: 8.8, sale: 9.9 },
  { x: 38.2, ve: 9.1, sale: 10.3 },
];
// los renglones del libro de IVA que se escriben en el escritorio de Kaux
const renglones = ['M3.2 6H11.5', 'M3.2 7.5H10.5', 'M3.2 9H11.5', 'M14.2 4.5H22.5', 'M14.2 6H21.5', 'M14.2 7.5H22.5', 'M14.2 9H20.5'];
// la voz en la pantalla del celular: barras que suben y bajan, cada una a su ritmo
const voz = [
  [1.43, 1.2, 0.7], [2.13, 2.6, 0.95], [2.83, 3.8, 0.8], [3.53, 2, 1.05], [4.23, 4.2, 0.75], [4.93, 2.8, 0.9], [5.63, 1.4, 1],
].map(([x, h, d]) => ({ x, y: 6.5 - h / 2, h, d }));
// y la del recuadro del chat
const vozChat = [4, 8, 12, 6, 14, 10, 5, 12, 9, 15, 7, 11, 4, 8].map((h, i) => ({ x: 1 + i * 3.6, y: 8 - h / 2, h, d: [0.7, 0.95, 0.8, 1.05, 0.75, 0.9, 1][i % 7], r: -((i * 0.37) % 0.8) }));
const rayasMesa = Array.from({ length: 29 }, (_, i) => `M${(i + 1) * 2} 0v3`).join('');
---

<div class="facturacion">
  <h3>Facturación y contabilidad, conectadas a ARCA</h3>
  <div class="cuerpo">
    <div class="textos">
      <section aria-labelledby="fact-facturacion">
        <p class="rubro" id="fact-facturacion">Facturación</p>
        <div class="fila" data-producto="hown">
          <h4><img class="marca-producto" src="/hown-logo-tinta.svg" alt="" width="44" height="44" />Hown</h4>
          <div>
            <p class="para">Quien factura sin mostrador</p>
            <p class="texto">Un bot de Telegram: le mandás un audio o un texto y te devuelve la factura de ARCA (A, B o C) con su PDF.</p>
            <p class="sitio"><a href="https://hown.howenh-labs.com/" target="_blank" rel="noopener">hown.howenh-labs.com ↗</a></p>
          </div>
        </div>
        <!-- yon.com.ar existe pero todavía no tiene landing: se enlaza cuando la tenga -->
        <div class="fila" data-producto="yon">
          <h4><img class="marca-producto" src="/yon-logo-tinta.svg" alt="" width="44" height="44" />Yon</h4>
          <div>
            <p class="para">Comercios de mostrador</p>
            <p class="texto">Una web app para vender y facturar: clientes, productos y stock, con métricas e historial. Si se corta la señal, sigue vendiendo y factura cuando vuelve.</p>
          </div>
        </div>
      </section>
      <section aria-labelledby="fact-contabilidad">
        <p class="rubro" id="fact-contabilidad">Contabilidad</p>
        <div class="fila kaux" data-producto="kaux">
          <div class="kaux-cabeza">
            <h4>Kaux</h4>
            <p class="que">Sistema contable para contadores y estudios.</p>
          </div>
          <p class="texto">Trae de ARCA los libros de IVA para que el contador los revise y los corrija antes de subirlos, y liquida los sueldos con los convenios incluidos.</p>
          <ul class="funciones">
            <li>Conexión con ARCA</li>
            <li>Libros de IVA traídos de ARCA</li>
            <li>Sueldos con los convenios incluidos</li>
          </ul>
        </div>
      </section>
    </div>

    <figure class="mesa">
      <svg class="mesa-arca" viewBox="-4 -72 166 110" role="img" aria-label="Una mesa grabada: el comprobante de Hown viaja por Teken, el motor interno, hasta ARCA y vuelve con el CAE; Yon sigue facturando sin señal y manda sus facturas cuando vuelve la conexión; Kaux trae de ARCA el libro de IVA, el contador lo revisa y lo sube, y se suma un recibo de sueldo" data-vive data-quieto="17.5">
        <!-- la mesa -->
        <g transform="matrix(0.866 0.5 0 1 0 0)"><rect class="cara" width="60" height="3"></rect><path class="sombra" d={rayasMesa}></path></g>
        <g transform="matrix(0.866 -0.5 0 1 51.96 30)"><rect class="cara" width="120" height="3"></rect></g>
        <g transform="matrix(0.866 -0.5 0.866 0.5 0 0)">
          <rect class="tabla" width="120" height="60"></rect>
          <path class="ruta" d={R.ida}></path>
          <path class="ruta-cae" d={R.cae}></path>
          <g class="obj obj-hown">
            <path class="ruta" d={R.hown}></path>
            <text class="t-tinta rotulo" x="27" y="5">HOWN</text>
            <text class="t-suave nota" x="27" y="7.8">bot de Telegram</text>
          </g>
          <g class="obj obj-yon">
            <path class="ruta" d={R.yon}></path>
            <text class="t-tinta rotulo" x="8" y="50.5">YON</text>
            <text class="t-suave nota" x="17" y="50.5">app de mostrador</text>
            {
              cola.map((q) => (
                <rect class="hoja-espera" x={q.x} y="41.4" width="2.6" height="3.2" opacity="0">
                  <animate attributeName="opacity" {...anim(entre(q.ve, q.sale))} />
                </rect>
              ))
            }
            <text class="t-suave" x="30.2" y="48" font-size="1.8" opacity="0">
              SIN SEÑAL
              <animate attributeName="opacity" {...anim(entre(8.4, 9.45))} />
            </text>
          </g>
          <g class="obj obj-kaux">
            <path class="ruta" d={R.trae}></path>
            <path class="ruta-mano" d={R.sube}></path>
            <text class="t-tinta rotulo" x="74" y="56.8">KAUX</text>
            <text class="t-suave nota" x="86" y="56.8">sistema contable</text>
          </g>
          <!-- los pasos del recorrido -->
          {
            [[34.75, 20, 1], [38, 35.5, 1], [77, 22.4, 2], [95.5, 31.1, 3], [107.25, 30.25, 4]].map(([x, y, n]) => (
              <g class="marca">
                <circle cx={x} cy={y} r="2.2"></circle>
                <text x={x} y={y + 0.8}>{n}</text>
              </g>
            ))
          }
          <!-- lo que viaja por los caminos -->
          <g class="obj obj-hown">
            <g opacity="0">
              <animate attributeName="opacity" {...viajes.hown.op} />
              <animateMotion {...viajes.hown.mov} />
              <rect class="hoja" x="-1.3" y="-1.6" width="2.6" height="3.2"></rect>
            </g>
          </g>
          <g opacity="0">
            <animate attributeName="opacity" {...viajes.ida.op} />
            <animateMotion {...viajes.ida.mov} />
            <rect class="hoja" x="-1.3" y="-1.6" width="2.6" height="3.2"></rect>
          </g>
          <!-- el CAE (magenta) vuelve de ARCA, pasa por Teken y llega a Hown -->
          <g opacity="0">
            <animate attributeName="opacity" {...viajes.cae.op} />
            <animateMotion {...viajes.cae.mov} />
            <circle class="halo" r="1.9"></circle>
            <circle class="acento" r="1"></circle>
          </g>
          <g class="obj obj-yon">
            {
              viajes.cola.map((v) => (
                <g opacity="0">
                  <animate attributeName="opacity" {...v.op} />
                  <animateMotion {...v.mov} />
                  <rect class="hoja" x="-1.3" y="-1.6" width="2.6" height="3.2"></rect>
                </g>
              ))
            }
          </g>
          <g class="obj obj-kaux">
            {
              [viajes.trae, viajes.sube].map((v) => (
                <g opacity="0">
                  <animate attributeName="opacity" {...v.op} />
                  <animateMotion {...v.mov} />
                  <rect class="hoja" x="-1.6" y="-1.4" width="3" height="3.2"></rect>
                  <rect class="hoja" x="-1" y="-2" width="3" height="3.2"></rect>
                </g>
              ))
            }
          </g>
        </g>

        <!-- ARCA, al fondo: la escalinata, las pilastras, el frontón y su nombre en el friso -->
        <g transform="matrix(0.866 0.5 0 1 79.67 -44.5)"><rect class="cara" width="18" height="2.5"></rect></g>
        <g transform="matrix(0.866 -0.5 0 1 95.26 -35.5)"><rect class="cara" width="26" height="2.5"></rect><path class="suave" d="M0 0.8h26M0 1.6h26"></path></g>
        <g transform="matrix(0.866 -0.5 0.866 0.5 79.67 -44.5)"><rect class="cara" width="26" height="18"></rect></g>
        <g transform="matrix(0.866 0.5 0 1 84.87 -56.5)"><rect class="cara" width="12" height="12"></rect><path class="sombra" d="M1.5 0v12M3 0v12M4.5 0v12M6 0v12M7.5 0v12M9 0v12M10.5 0v12"></path></g>
        <g transform="matrix(0.866 -0.5 0 1 95.26 -50.5)">
          <rect class="cara" width="20" height="12"></rect>
          <path class="trazo" d="M0 2.4H20M2.5 2.4V12M5 2.4V12M7.5 2.4V12M10 2.4V12M12.5 2.4V12M15 2.4V12M17.5 2.4V12"></path>
          <text class="t-tinta" x="10" y="1.85" font-size="1.7" font-weight="500" text-anchor="middle">ARCA</text>
        </g>
        <g transform="matrix(0.866 -0.5 0.866 0.5 84.87 -56.5)"><rect class="cara" width="20" height="12"></rect></g>
        <g transform="matrix(0.866 -0.5 0 1 95.26 -50.5)"><path class="cara" d="M-1 0L10 -5L21 0Z"></path></g>

        <!-- Kaux: el escritorio con el libro de IVA y, al lado, los sueldos -->
        <g class="obj obj-kaux">
          <g transform="matrix(0.866 0.5 0 1 96.99 -24)"><rect class="cara" width="14" height="6"></rect><path class="sombra" d="M1.75 0v6M3.5 0v6M5.25 0v6M7 0v6M8.75 0v6M10.5 0v6M12.25 0v6"></path></g>
          <g transform="matrix(0.866 -0.5 0 1 109.12 -17)"><rect class="cara" width="26" height="6"></rect></g>
          <g transform="matrix(0.866 -0.5 0.866 0.5 96.99 -24)">
            <rect class="cara" width="26" height="14"></rect>
            <rect class="hoja" x="2" y="2" width="11" height="10"></rect>
            <rect class="hoja" x="13" y="2" width="11" height="10"></rect>
            <text class="t-tinta" x="3.2" y="4.2" font-size="1.4" font-weight="500">LIBRO IVA</text>
            {
              renglones.map((d, i) => (
                <path class="escribe" pathLength="1" d={d}>
                  <animate attributeName="stroke-dashoffset" {...anim(traza(12.6 + 0.17 * i, 12.85 + 0.17 * i))} />
                </path>
              ))
            }
            <!-- revisado por el contador -->
            <path class="tilde" pathLength="1" d="M17.5 10.4L19 11.6L22 8.8">
              <animate attributeName="stroke-dashoffset" {...anim(traza(13.9, 14.3))} />
            </path>
          </g>
          <g transform="matrix(0.866 0.5 0 1 122.97 -34)"><rect class="cara" width="12" height="3"></rect><path class="suave" d="M0 1h12M0 2h12"></path></g>
          <g transform="matrix(0.866 -0.5 0 1 133.36 -28)"><rect class="cara" width="12" height="3"></rect><path class="suave" d="M0 1h12M0 2h12"></path></g>
          <g transform="matrix(0.866 -0.5 0.866 0.5 122.97 -34)">
            <rect class="pestana" x="8.5" y="11.5" width="2.5" height="2"></rect>
            <rect class="hoja" width="12" height="12"></rect>
            <text class="t-tinta" x="1.5" y="3.5" font-size="1.8" font-weight="500">SUELDOS</text>
            <text class="t-suave" x="1.5" y="6" font-size="1.4">CONVENIO</text>
            <path class="suave" d="M1.5 8H10M1.5 9.5H9"></path>
          </g>
          <!-- un recibo nuevo cae sobre la pila -->
          <g opacity="0">
            <animate attributeName="opacity" {...anim([[0, 0], [16, 0], [16.12, 1], [17.9, 1], [DUR, 0]])} />
            <animateTransform attributeName="transform" type="translate" {...anim([[0, '0 -10'], [16, '0 -10'], [16.6, '0 0'], [DUR, '0 0']], CAE_CURVA)} />
            <g transform="matrix(0.866 -0.5 0.866 0.5 122.97 -34.4)">
              <rect class="pestana" x="3" y="11.5" width="2.5" height="2"></rect>
              <rect class="hoja" width="12" height="12"></rect>
              <text class="t-tinta" x="1.5" y="3.5" font-size="1.8" font-weight="500">RECIBO</text>
              <path class="suave" d="M1.5 5.5H10M1.5 7H9M1.5 8.5H10"></path>
            </g>
          </g>
        </g>

        <!-- Teken: el motor interno, una caja cerrada; sus ranuras se trazan mientras trabaja -->
        <g transform="matrix(0.866 0.5 0 1 60.62 -23)"><rect class="cara" width="16" height="10"></rect><path class="sombra" d="M1.6 0v10M3.2 0v10M4.8 0v10M6.4 0v10M8 0v10M9.6 0v10M11.2 0v10M12.8 0v10M14.4 0v10"></path></g>
        <g transform="matrix(0.866 -0.5 0 1 74.48 -15)">
          <rect class="cara" width="16" height="10"></rect>
          <path class="suave" d="M3 3H13M3 4.6H13M3 6.2H13"></path>
          {
            ['M3 3H13', 'M3 4.6H13', 'M3 6.2H13'].map((d, i) => (
              <path class="escribe ranura" pathLength="1" d={d} stroke-dashoffset="1">
                <animate attributeName="stroke-dashoffset" {...anim(traza(3 + 0.3 * i, 3.3 + 0.3 * i))} />
                <animate attributeName="opacity" {...anim([[0, 1], [4.2, 1], [5.4, 0], [DUR, 0]])} />
              </path>
            ))
          }
        </g>
        <g transform="matrix(0.866 -0.5 0.866 0.5 60.62 -23)">
          <rect class="cara" width="16" height="16"></rect>
          <text class="t-tinta" x="2" y="6" font-size="3" font-weight="500">TEKEN</text>
          <text class="t-suave" x="2" y="10" font-size="1.45">motor interno</text>
        </g>

        <!-- Hown: el celular con la voz y la factura que vuelve con su CAE -->
        <g class="obj obj-hown">
          <g transform="matrix(0.866 0.5 0 1 17.32 -15)"><rect class="canto" width="1.4" height="13"></rect></g>
          <g transform="matrix(0.866 -0.5 0 1 18.53 -14.3)">
            <rect class="cara" width="7" height="13"></rect>
            <rect class="pantalla" x="0.8" y="1.2" width="5.4" height="10.6"></rect>
            {
              voz.map((b) => (
                <rect class="t-tinta" x={b.x} y={b.y} width="0.35" height={b.h}>
                  <animate attributeName="height" values={`${b.h};${b.h * 0.2};${b.h}`} dur={`${b.d}s`} repeatCount="indefinite" />
                  <animate attributeName="y" values={`${b.y};${b.y + b.h * 0.4};${b.y}`} dur={`${b.d}s`} repeatCount="indefinite" />
                </rect>
              ))
            }
          </g>
          <g transform="matrix(0.866 -0.5 0.866 0.5 17.32 -15)"><rect class="cara" width="7" height="1.4"></rect></g>
          <g opacity="0">
            <animate attributeName="opacity" {...anim([[0, 0], [6.88, 0], [7.1, 1], [17.9, 1], [DUR, 0]])} />
            <animateTransform attributeName="transform" type="translate" {...anim([[0, '0 -6'], [6.88, '0 -6'], [7.1, '0 0'], [DUR, '0 0']], CAE_CURVA)} />
            <g transform="matrix(0.866 -0.5 0.866 0.5 19.05 1.7)">
              <rect class="hoja" width="10" height="12"></rect>
              <text class="t-tinta" x="1" y="2.6" font-size="1.4" font-weight="500">FACTURA C</text>
              <path class="suave" d="M1 4.5H8M1 6H7M1 7.5H8"></path>
              <!-- el sello del CAE (magenta) baja sobre la factura -->
              <g transform="translate(3.5 10)">
                <g opacity="0">
                  <animate attributeName="opacity" {...anim([[0, 0], [7, 0], [7.25, 1], [DUR, 1]])} />
                  <animateTransform attributeName="transform" type="scale" {...anim([[0, 1.7], [7, 1.7], [7.25, 1], [DUR, 1]], '0.55 0 1 0.45')} />
                  <rect class="cae" x="-2.5" y="-1" width="5" height="2"></rect>
                  <text class="t-acento" x="-1.9" y="0.5" font-size="1.3">CAE</text>
                </g>
              </g>
            </g>
          </g>
        </g>

        <!-- Yon: el mostrador con la tablet y la impresora que saca el ticket -->
        <g class="obj obj-yon">
          <g transform="matrix(0.866 0.5 0 1 38.1 7)"><rect class="cara" width="8" height="7"></rect><path class="sombra" d="M1.6 0v7M3.2 0v7M4.8 0v7M6.4 0v7"></path></g>
          <g transform="matrix(0.866 -0.5 0 1 45.03 11)"><rect class="cara" width="20" height="7"></rect><path class="suave" d="M0 2.3h20M0 4.6h20"></path></g>
          <g transform="matrix(0.866 -0.5 0.866 0.5 38.1 7)"><rect class="cara" width="20" height="8"></rect></g>
          <g transform="matrix(0.866 0.5 0 1 42 5.05)"><rect class="canto" width="4.5" height="1.2"></rect></g>
          <g transform="matrix(0.866 -0.5 0 1 45.9 7.3)"><rect class="cara" width="6" height="1.2"></rect></g>
          <g transform="matrix(0.866 -0.5 0.866 0.5 42 5.05)"><rect class="cara" width="6" height="4.5"></rect><rect class="pantalla" x="0.6" y="0.6" width="4.8" height="3.3"></rect></g>
          <g transform="matrix(0.866 0.5 0 1 49.8 -1.25)"><rect class="cara" width="4.5" height="3"></rect><path class="sombra" d="M1.5 0v3M3 0v3"></path></g>
          <g transform="matrix(0.866 -0.5 0 1 53.69 1)"><rect class="cara" width="5" height="3"></rect></g>
          <g transform="matrix(0.866 -0.5 0.866 0.5 49.8 -1.25)"><rect class="cara" width="5" height="4.5"></rect><path class="trazo" d="M1 2.2H4"></path></g>
          <g transform="matrix(0.866 -0.5 0 1 52.39 -0.75)">
            <g>
              <animateTransform attributeName="transform" type="scale" {...anim([[0, '1 0'], [7.8, '1 0'], [8.4, '1 1'], [17.9, '1 1'], [DUR, '1 0']])} />
              <rect class="hoja" x="0.5" y="-6" width="3" height="6"></rect>
              <path class="suave" d="M1 -4.6H3M1 -3.6H2.6M1 -2.6H3"></path>
            </g>
          </g>
        </g>

        <!-- las lupas: marcan el producto que se cuenta en el recuadro de abajo -->
        <g class="lupa lupa-hown" opacity="0"><animate attributeName="opacity" {...anim([[0, 0], [0.12, 1], [7.7, 1], [7.8, 0], [DUR, 0]])} /><circle cx="22" cy="-8" r="10"></circle><path d="M22 2V38"></path></g>
        <g class="lupa lupa-yon" opacity="0"><animate attributeName="opacity" {...anim(entre(7.8, 11.1))} /><circle cx="48" cy="3" r="12"></circle><path d="M48 15V38"></path></g>
        <g class="lupa lupa-kaux" opacity="0"><animate attributeName="opacity" {...anim([[0, 0], [11.2, 0], [11.34, 1], [17.88, 1], [DUR, 0]])} /><circle cx="117" cy="-20" r="16"></circle><path d="M117 -4V38"></path></g>
      </svg>

