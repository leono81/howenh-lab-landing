<script>
  // la fila y el recuadro siguen al reloj de la mesa (el svg corre solo en pantalla, Base.astro);
  // al pasar por una fila, la mesa se queda con ese producto y su recuadro se ve completo.
  // Sin JS: se ve el recuadro de Hown. Con movimiento reducido: la mesa quieta, todo a la vista.
  const sec = document.querySelector<HTMLElement>('.facturacion');
  const mesa = sec?.querySelector<SVGSVGElement>('.mesa-arca');
  if (sec && mesa) {
    const CICLO = 18;
    const TRAMOS: [string, number][] = [['kaux', 11.2], ['yon', 7.8], ['hown', 0]];
    const FIN: Record<string, number> = { hown: 7.79, yon: 11.19, kaux: 17.99 };
    const marcables = [...sec.querySelectorAll<HTMLElement>('.fila, .ficha')];
    const pasos = [...sec.querySelectorAll<HTMLElement>('[data-desde]')];
    const cae = sec.querySelector<HTMLElement>('.cae-numero');
    const quieto = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let fijo: string | null = null, visible = false, cuadro = 0;
    const pintar = () => {
      cuadro = 0;
      const t = quieto ? FIN.kaux : mesa.getCurrentTime() % CICLO;
      const actual = fijo ?? TRAMOS.find(([, d]) => t >= d)![0];
      const tf = fijo ? FIN[fijo] : t;
      marcables.forEach((m) => m.toggleAttribute('data-actual', m.dataset.producto === actual));
      pasos.forEach((p) => p.toggleAttribute('data-ve', tf >= +p.dataset.desde! && tf < +(p.dataset.hasta ?? CICLO)));
      if (cae) cae.textContent = cae.dataset.numero!.slice(0, Math.max(0, Math.min(14, Math.floor(((tf - 7) / 0.6) * 14))));
      if (visible && !quieto) cuadro = requestAnimationFrame(pintar);
    };
    sec.classList.add('al-ritmo');
    sec.querySelectorAll<HTMLElement>('.fila').forEach((f) => {
      const fijar = (p: string | null) => () => {
        fijo = p;
        sec.dataset.fijo = p ?? '';
        if (!cuadro) pintar();
      };
      f.addEventListener('pointerenter', fijar(f.dataset.producto!));
      f.addEventListener('pointerleave', fijar(null));
      f.addEventListener('focusin', fijar(f.dataset.producto!));
      f.addEventListener('focusout', fijar(null));
    });
    new IntersectionObserver(([v]) => {
      visible = v.isIntersecting;
      if (visible && !cuadro) pintar();
    }).observe(sec);
    pintar();
  }
</script>

