---
// La Antigua Torre de Aguas (plaza Almirante Brown) en la maqueta, según
// flow/3-torre-de-agua-dia.jpg: prisma ochavado apenas ahusado, cornisa saliente y remate
// plano, óculos, reloj, dos ventanas angostas y pórtico con frontón. Se ven tres de sus ocho
// caras. Hacia dónde mira la puerta no está verificado: va en la cara que queda de frente.
// Medidas en metros aproximados; (x, y) es el pie de la torre en la maqueta.
import { iso, pol, lin, rayas, type P } from '../data/iso';
interface Props {
  x: number;
  y: number;
  escala?: number;
}
const { x, y, escala = 1.2 } = Astro.props;

const H = 30, R0 = 4.7, R1 = 4; // alto; apotema abajo y arriba
const K = Math.cos(Math.PI / 8);
// vértice k del octógono de apotema r a la altura z (el 5, 6, 7 y 8 son los que dan al frente)
const v = (k: number, r: number, z: number): P => {
  const a = ((22.5 + 45 * k) * Math.PI) / 180;
  return iso((r / K) * Math.cos(a), (r / K) * Math.sin(a), z);
};
const cara = (k: number, r0: number, z0: number, r1: number, z1: number) => pol(v(k, r0, z0), v(k + 1, r0, z0), v(k + 1, r1, z1), v(k, r1, z1));
const anillo = (r: number, z: number) => pol(...Array.from({ length: 8 }, (_, k) => v(k, r, z)));
const r = (z: number) => R0 + ((R1 - R0) * z) / H;
// punto de la cara del frente: s a lo ancho (positivo hacia la izquierda), z de altura, e despegado de la pared
const frente = (s: number, z: number, e = 0): P => {
  const q = (r(z) + e) * Math.SQRT1_2;
  return iso(q + s * Math.SQRT1_2, -q + s * Math.SQRT1_2, z);
};
const [rx, ry] = [frente(0, 24.5), frente(0, 28)];
const arcoPuerta = Array.from({ length: 9 }, (_, i) => frente(-1.1 * Math.cos((Math.PI * i) / 8), 2.4 + 1.1 * Math.sin((Math.PI * i) / 8), 1.3));
---
<g class="maqueta-torre" transform={`translate(${x} ${y}) scale(${escala})`} fill="none" stroke="var(--tinta)" stroke-linejoin="round" stroke-linecap="round">
  <!-- recorte de papel alrededor, para que se lea sobre las manzanas rayadas -->
  <path d={pol(v(5, R0, 0), v(6, R0, 0), v(7, R0, 0), v(8, R0, 0), v(8, R1 + 1, H + 2.8), v(5, R1 + 1, H + 2.8))} fill="var(--papel)" stroke="var(--papel)" stroke-width="4" />

  <!-- cuerpo: la cara que mira a la ciudad va en sombra -->
  <path d={cara(5, R0, 0, R1, H) + cara(6, R0, 0, R1, H) + cara(7, R0, 0, R1, H)} fill="var(--papel)" stroke-width="0.9" />
  <path d={rayas(v(7, R0, 0), v(7, R1, H), v(8, R0, 0), v(8, R1, H), 6)} stroke-width="0.4" />
  <path d={rayas(v(5, R0, 0), v(5, R1, H), v(6, R0, 0), v(6, R1, H), 4)} stroke="var(--tinta-suave)" stroke-width="0.35" />

  <!-- cornisa saliente y remate plano; la cornisa va rayada en la segunda tinta: es el hito de la ciudad -->
  <path d={cara(5, R1 + 1, H, R1 + 1, H + 1.8) + cara(6, R1 + 1, H, R1 + 1, H + 1.8) + cara(7, R1 + 1, H, R1 + 1, H + 1.8)} fill="var(--papel)" stroke-width="0.9" />
  <path d={[5, 6, 7].map((k) => rayas(v(k, R1 + 1, H), v(k, R1 + 1, H + 1.8), v(k + 1, R1 + 1, H), v(k + 1, R1 + 1, H + 1.8), 7)).join('')} stroke="var(--acento)" stroke-width="0.45" />
  <path d={anillo(R1 + 1, H + 1.8)} fill="var(--papel)" stroke-width="0.9" />
  <path d={anillo(R1 - 0.2, H + 1.8)} stroke-width="0.5" />
  <path d={lin(v(5, R1 + 0.2, H - 0.9), v(6, R1 + 0.2, H - 0.9), v(7, R1 + 0.2, H - 0.9), v(8, R1 + 0.2, H - 0.9))} stroke-width="0.5" />

  <!-- reloj, óculos y ventanas angostas -->
  <ellipse cx={rx[0]} cy={rx[1]} rx="1.75" ry="1.55" fill="var(--papel)" stroke="var(--acento)" stroke-width="0.9" />
  <path d={`M${rx[0]} ${rx[1]}v-1.1M${rx[0]} ${rx[1]}l0.9 0.4`} stroke-width="0.5" />
  <ellipse cx={ry[0]} cy={ry[1]} rx="0.6" ry="0.5" fill="var(--tinta)" stroke="none" />
  <path d={pol(frente(-0.45, 16.5), frente(0.45, 16.5), frente(0.45, 20.5), frente(-0.45, 20.5)) + pol(frente(-0.45, 9.5), frente(0.45, 9.5), frente(0.45, 13.5), frente(-0.45, 13.5))} fill="var(--tinta)" stroke="none" />

  <!-- pórtico con frontón y puerta -->
  <path d={pol(frente(-2.4, 0, 1.3), frente(2.4, 0, 1.3), frente(2.4, 4.4, 1.3), frente(0, 6.3, 1.3), frente(-2.4, 4.4, 1.3))} fill="var(--papel)" stroke-width="0.8" />
  <path d={lin(frente(-2.8, 4.4, 1.3), frente(0, 6.6, 1.3), frente(2.8, 4.4, 1.3))} stroke="var(--acento)" stroke-width="1.1" />
  <path d={pol(frente(-1.1, 0, 1.3), ...arcoPuerta, frente(1.1, 0, 1.3))} fill="var(--tinta)" stroke="none" />
</g>
