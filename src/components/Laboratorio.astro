---
// Laboratorio: el índice. Las cuatro líneas de trabajo, cada una con el enlace a su prueba más abajo.
// Con parte="programas" dibuja en cambio los programas que eligieron a Howenh (canvas «Programas en la
// landing», D1, 2026-11-12), que van al final, antes de Hablemos: armados igual que el índice (comparten
// estilo y entrada) pero al revés, con el título a la derecha. Anthropic va en texto (su logo pide
// aprobación previa); ElevenLabs con su logo oficial en negro, como da su guía de marca.
const { parte = 'indice' } = Astro.props as { parte?: 'indice' | 'programas' };
const lineas = [
  {
    titulo: 'Inteligencia artificial e ingeniería',
    texto: 'Inteligencia artificial dentro de nuestras aplicaciones, e ingeniería agéntica: agentes que trabajan con el equipo para diseñar, construir y probar el software.',
    enlaces: [],
  },
  {
    titulo: 'Vigilancia de incendios',
    texto: 'Lo que ven los satélites sobre la isla y lo que mide el Servicio Meteorológico Nacional, en un solo mapa para quienes combaten el fuego.',
    enlaces: [['Penon', '#penon']],
  },
  {
    titulo: 'Estación terrena',
    texto: 'Una estación propia en la isla, armada para recibir las señales de satélites pequeños y compartirlas con una red abierta.',
    enlaces: [['La estación', '#estacion']],
  },
  {
    titulo: 'Software en producción',
    texto: 'Sistemas para profesionales de la salud, comercios y estudios contables, en uso con clientes reales.',
    enlaces: [['Productos', '#productos']],
  },
];
---
{parte === 'indice' && (
<section class="seccion laboratorio" id="laboratorio" aria-labelledby="lab-titulo">
  <div class="cabeza aparece">
    <h2 id="lab-titulo">Qué hace el laboratorio</h2>
    <p class="entrada">Howenh Labs es un laboratorio de software e inteligencia artificial de Tierra del Fuego. Trabaja en cuatro líneas.</p>
  </div>
  <dl class="lineas">
    {
      lineas.map((l) => (
        <div class="linea aparece">
          <dt>{l.titulo}</dt>
          <dd>
            <p>{l.texto}</p>
            {l.enlaces.length > 0 && (
              <p class="ver">
                {l.enlaces.map(([t, h]) => (
                  <a href={h}>{t} ↓</a>
                ))}
              </p>
            )}
          </dd>
        </div>
      ))
    }
  </dl>
</section>
)}

{parte === 'programas' && (
<section class="seccion programas" id="programas" aria-labelledby="prog-titulo">
  <div class="cabeza aparece">
    <h2 id="prog-titulo">Programas que nos eligieron</h2>
    <p class="entrada">Dos empresas de inteligencia artificial sumaron a Howenh Labs a sus programas para startups.</p>
  </div>
  <dl class="lineas">
    <div class="linea aparece">
      <dt><span class="marca-programa rotulo">ANTHROPIC</span>Claude Startups</dt>
      <dd><p>El programa de Anthropic para startups que construyen con Claude. Con Claude funciona Taiyin, el asistente de esta página.</p></dd>
    </div>
    <div class="linea aparece">
      <dt>
        <a class="marca-programa" href="https://elevenlabs.io" target="_blank" rel="noopener"><img src="/elevenlabs-logo-black.svg" alt="ElevenLabs" width="123" height="16" /></a>
        ElevenLabs Startup Grant
      </dt>
      <dd><p>La beca para startups de ElevenLabs, la plataforma de voz con inteligencia artificial.</p></dd>
    </div>
  </dl>
</section>
)}

<style>
  .laboratorio,
  .programas {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 40px clamp(40px, 6vw, 112px);
    align-items: start;
  }
  /* los programas, al revés: la lista a la izquierda y el título a la derecha (en el HTML el título
     va primero, para leerlo y para el teléfono). Vienen enseguida del albatros de Desde la isla, que
     ya deja su aire al apagarse: sin el aire entero de una sección, se leen de corrido. */
  .programas {
    padding-top: clamp(32px, 3.5vw, 64px);
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    /* abajo viene Hablemos, con el cabo del mismo lado que el título: la letra va encima por si el
       cabo se acerca, que arriba ya se apaga solo. Sin fondo propio: un papel que termina en el borde
       de la sección corta el dibujo con una recta. */
    position: relative;
    z-index: 1;
  }
  .programas .cabeza {
    grid-area: 1 / 2;
  }
  .programas .lineas {
    grid-area: 1 / 1;
  }
  /* arriba de cada programa, quién lo da: en mono, o el logo. Alrededor del logo, aire igual a su
     alto (la guía de ElevenLabs) */
  .marca-programa {
    display: flex;
    align-items: center;
    height: 16px;
    margin-bottom: 16px;
  }
  .marca-programa img {
    display: block;
    width: auto;
    height: 16px;
  }
  .lineas {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 clamp(24px, 3vw, 48px);
  }
  .linea {
    position: relative;
    padding: 18px 0 36px;
  }
  /* el filete de arriba, aparte, para poder trazarlo */
  .linea::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: var(--tinta-suave);
    transform-origin: left;
  }

  /* la entrada (.aparece, en Base): además, el filete se traza de izquierda a derecha como la costa
     del hero, antes que la letra */
  .espera::before {
    transform: scaleX(0);
  }
  .llega::before {
    transition: transform 1.2s cubic-bezier(0.16, 0.6, 0.2, 1) calc(var(--n) * 140ms);
  }
  dt {
    font-weight: 600;
    font-size: clamp(17px, 1.35vw, 19px);
    line-height: 1.3;
  }
  dd p:first-child {
    margin-top: 10px;
    font-size: 16px;
    line-height: 1.55;
    max-width: 40ch;
  }
  .ver {
    margin-top: 14px;
    display: flex;
    gap: 20px;
    font: 500 12px var(--mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  @media (max-width: 900px) {
    .laboratorio,
    .programas {
      grid-template-columns: 1fr;
    }
    .programas .cabeza,
    .programas .lineas {
      grid-area: auto;
    }
  }
  @media (max-width: 600px) {
    .lineas {
      grid-template-columns: 1fr;
    }
    .linea {
      padding-bottom: 28px;
    }
  }
</style>
