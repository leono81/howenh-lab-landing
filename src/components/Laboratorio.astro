---
// Laboratorio: el índice. Las cuatro líneas de trabajo, cada una con el enlace a su prueba más abajo.
// Abajo de la presentación, en voz baja, los programas que eligieron a Howenh (canvas «Programas: dónde
// van», opción A, 2026-11-12): son una credencial y suman acá, donde alguien se hace la idea del
// laboratorio; como sección propia al final pesaban de más entre el albatros y el cabo. Anthropic va en
// texto (su logo pide aprobación previa); ElevenLabs con su logo oficial en negro, como da su guía de
// marca. «Taiyin» abre el asistente: la línea se prueba ahí mismo.
const lineas = [
  {
    titulo: 'Inteligencia artificial e ingeniería',
    texto: 'Inteligencia artificial dentro de nuestras aplicaciones, e ingeniería agéntica: agentes que trabajan con el equipo para diseñar, construir y probar el software.',
    enlaces: [],
  },
  {
    titulo: 'Vigilancia de incendios',
    texto: 'Lo que ven los satélites sobre la isla y lo que mide el Servicio Meteorológico Nacional, en un solo mapa para quienes combaten el fuego.',
    enlaces: [['Penon', '#penon']],
  },
  {
    titulo: 'Estación terrena',
    texto: 'Una estación propia en la isla, armada para recibir las señales de satélites pequeños y compartirlas con una red abierta.',
    enlaces: [['La estación', '#estacion']],
  },
  {
    titulo: 'Software en producción',
    texto: 'Sistemas para profesionales de la salud, comercios y estudios contables, en uso con clientes reales.',
    enlaces: [['Productos', '#productos']],
  },
];
---
<section class="seccion laboratorio" id="laboratorio" aria-labelledby="lab-titulo">
  <div class="cabeza aparece">
    <h2 id="lab-titulo">Qué hace el laboratorio</h2>
    <p class="entrada">Howenh Labs es un laboratorio de software e inteligencia artificial de Tierra del Fuego. Trabaja en cuatro líneas.</p>
  </div>
  <dl class="lineas">
    {
      lineas.map((l) => (
        <div class="linea aparece">
          <dt>{l.titulo}</dt>
          <dd>
            <p>{l.texto}</p>
            {l.enlaces.length > 0 && (
              <p class="ver">
                {l.enlaces.map(([t, h]) => (
                  <a href={h}>{t} ↓</a>
                ))}
              </p>
            )}
          </dd>
        </div>
      ))
    }
  </dl>
  <div class="respaldo aparece">
    <p class="rotulo">PROGRAMAS QUE NOS ELIGIERON</p>
    <p>
      <span class="marca-programa rotulo">ANTHROPIC</span><strong>Claude Startups.</strong> Con Claude funciona <a class="a-taiyin" href="#taiyin"><svg class="destello" width="11" height="11" viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="1.6" fill="currentColor"></circle><path d="M11.5 8H15M10.5 10.5l2.5 2.5M8 11.5V15M5.5 10.5L3 13M4.5 8H1M5.5 5.5L3 3M8 4.5V1M10.5 5.5L13 3" stroke="currentColor" stroke-width="1.3" fill="none"></path></svg>Taiyin</a>, el asistente de esta página.
    </p>
    <p>
      <a class="marca-programa" href="https://elevenlabs.io" target="_blank" rel="noopener"><img src="/elevenlabs-logo-black.svg" alt="ElevenLabs" width="123" height="16" /></a>
      <strong>Startup Grant.</strong> La beca para startups de la plataforma de voz con inteligencia artificial.
    </p>
  </div>
</section>


<style>
  .laboratorio {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 40px clamp(40px, 6vw, 112px);
    align-items: start;
  }
  /* los programas, en voz baja: abajo de la cabeza del índice, a la altura de la última fila */
  .laboratorio .cabeza {
    grid-area: 1 / 1;
  }
  .laboratorio .lineas {
    grid-area: 1 / 2 / span 2;
  }
  .respaldo {
    grid-area: 2 / 1;
    align-self: end;
    position: relative;
    padding: 18px 0 36px;
    max-width: 40ch;
    font-size: 15px;
    line-height: 1.5;
  }
  .respaldo p + p {
    margin-top: 18px;
  }
  .respaldo .marca-programa {
    height: 14px;
    margin-bottom: 8px;
  }
  .respaldo .marca-programa img {
    height: 13px;
  }
  .respaldo strong {
    font-weight: 600;
  }
  /* el enlace a Taiyin, con su destello: al pasar, el destello gira un octavo */
  .a-taiyin {
    color: var(--tinta);
    text-underline-offset: 3px;
    white-space: nowrap;
  }
  .a-taiyin .destello {
    display: inline-block;
    margin-right: 4px;
    vertical-align: -1px;
    color: var(--acento);
    transition: transform 0.6s cubic-bezier(0.16, 0.6, 0.2, 1);
  }
  .a-taiyin:hover .destello,
  .a-taiyin:focus-visible .destello {
    transform: rotate(45deg);
  }
  @media (prefers-reduced-motion: reduce) {
    .a-taiyin .destello {
      transition: none;
    }
  }
  .respaldo > .rotulo {
    margin-bottom: 16px;
  }
  /* en la compu, sin filete: quedaría casi a la altura del de la segunda fila, y no igual */
  .respaldo::before {
    display: none;
  }
  /* arriba de cada programa, quién lo da: en mono, o el logo. Alrededor del logo, aire igual a su
     alto (la guía de ElevenLabs) */
  .marca-programa {
    display: flex;
    align-items: center;
    height: 16px;
    margin-bottom: 16px;
  }
  .marca-programa img {
    display: block;
    width: auto;
    height: 16px;
  }
  .lineas {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 clamp(24px, 3vw, 48px);
  }
  .linea {
    position: relative;
    padding: 18px 0 36px;
  }
  /* el filete de arriba, aparte, para poder trazarlo */
  .linea::before,
  .respaldo::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: var(--tinta-suave);
    transform-origin: left;
  }

  /* la entrada (.aparece, en Base): además, el filete se traza de izquierda a derecha como la costa
     del hero, antes que la letra */
  .espera::before {
    transform: scaleX(0);
  }
  .llega::before {
    transition: transform 1.2s cubic-bezier(0.16, 0.6, 0.2, 1) calc(var(--n) * 140ms);
  }
  dt {
    font-weight: 600;
    font-size: clamp(17px, 1.35vw, 19px);
    line-height: 1.3;
  }
  dd p:first-child {
    margin-top: 10px;
    font-size: 16px;
    line-height: 1.55;
    max-width: 40ch;
  }
  .ver {
    margin-top: 14px;
    display: flex;
    gap: 20px;
    font: 500 12px var(--mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  @media (max-width: 900px) {
    .laboratorio {
      grid-template-columns: 1fr;
    }
    .laboratorio .cabeza,
    .laboratorio .lineas,
    .respaldo {
      grid-area: auto;
    }
    /* en una columna, después de las cuatro líneas: con su filete, a todo el ancho */
    .respaldo {
      max-width: none;
    }
    .respaldo::before {
      display: block;
    }
  }
  @media (max-width: 600px) {
    .lineas {
      grid-template-columns: 1fr;
    }
    .linea {
      padding-bottom: 28px;
    }
  }
</style>
