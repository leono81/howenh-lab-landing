---
// La Misión Salesiana en la maqueta: la capilla de 1898 (frente con frontón hacia la Ruta 3 y
// el mar, torre campanario, nave, crucero), la escuela larga detrás y el cerco de tablas.
// Según flow/ref-mision-28..31 y la huella de OSM (el cuerpo del frente mira al mar).
// Medidas en metros aproximados. (x, y) es el punto de la capilla en la maqueta y ahí va su
// frente: el dibujo es mucho más grande que el edificio y crece hacia tierra adentro, así el
// cerco no se come los 190 m que la separan de la ruta.
import { iso, pol, lin, rayas, type P } from '../data/iso';
interface Props {
  x: number;
  y: number;
  escala?: number;
}
const { x, y, escala = 1.15 } = Astro.props;

type Pieza = { d: string; w?: number; papel?: boolean; tinta?: boolean; suave?: boolean; techo?: boolean };
// casa con techo a dos aguas; eje = dirección de la cumbrera. Devuelve las piezas de atrás para adelante.
function casa(x0: number, x1: number, y0: number, y1: number, h: number, c: number, eje: 'x' | 'y', chapas: number): Pieza[] {
  const xm = (x0 + x1) / 2, ym = (y0 + y1) / 2;
  if (eje === 'y')
    return [
      { d: pol(iso(x0, y0, h), iso(x0, y1, h), iso(xm, y1, c), iso(xm, y0, c)), papel: true },
      { d: pol(iso(x1, y0, 0), iso(x1, y1, 0), iso(x1, y1, h), iso(x1, y0, h)), papel: true },
      { d: pol(iso(x1, y0, h), iso(x1, y1, h), iso(xm, y1, c), iso(xm, y0, c)), papel: true },
      { d: rayas(iso(x1, y0, h), iso(xm, y0, c), iso(x1, y1, h), iso(xm, y1, c), chapas), w: 0.45, techo: true },
      { d: pol(iso(x0, y0, 0), iso(x1, y0, 0), iso(x1, y0, h), iso(xm, y0, c), iso(x0, y0, h)), papel: true },
    ];
  return [
    { d: pol(iso(x0, y1, h), iso(x1, y1, h), iso(x1, ym, c), iso(x0, ym, c)), papel: true },
    { d: pol(iso(x1, y0, 0), iso(x1, y1, 0), iso(x1, y1, h), iso(x1, ym, c), iso(x1, y0, h)), papel: true },
    { d: pol(iso(x0, y0, 0), iso(x1, y0, 0), iso(x1, y0, h), iso(x0, y0, h)), papel: true },
    { d: pol(iso(x0, y0, h), iso(x1, y0, h), iso(x1, ym, c), iso(x0, ym, c)), papel: true },
    { d: rayas(iso(x0, y0, h), iso(x0, ym, c), iso(x1, y0, h), iso(x1, ym, c), chapas), w: 0.45, techo: true },
  ];
}
// hueco con arco de medio punto en una pared que mira al mar (plano y = cte) o a la ciudad (plano x = cte)
const arco = (cara: 'y' | 'x', fijo: number, centro: number, z0: number, z1: number, r: number) => {
  const p = (s: number, z: number): P => (cara === 'y' ? iso(centro + s, fijo, z) : iso(fijo, centro + s, z));
  const pts: P[] = [p(-r, z0), p(-r, z1)];
  for (let i = 1; i < 8; i++) pts.push(p(-r * Math.cos((Math.PI * i) / 8), z1 + r * Math.sin((Math.PI * i) / 8)));
  pts.push(p(r, z1), p(r, z0));
  return pol(...pts);
};
const ventana = (cara: 'y' | 'x', fijo: number, s0: number, s1: number, z0: number, z1: number) => {
  const p = (s: number, z: number): P => (cara === 'y' ? iso(s, fijo, z) : iso(fijo, s, z));
  return pol(p(s0, z0), p(s1, z0), p(s1, z1), p(s0, z1));
};

const F = 0, N0 = 5, N1 = 23; // frente del cuerpo de entrada; nave de N0 a N1
const TY0 = F + 0.6, TY1 = F + 4.2, TC = (TY0 + TY1) / 2; // torre
const CERCO = F - 3.2, LADO = 21;
const piezas: Pieza[] = [
  // escuela: bloque largo detrás
  ...casa(-32, 34, 36, 44, 4.5, 7.6, 'x', 34),
  { d: Array.from({ length: 15 }, (_, i) => ventana('y', 36, -29.5 + i * 4.2, -27.3 + i * 4.2, 1.6, 3.2)).join('') + ventana('x', 34, 38, 39.6, 1.6, 3.2) + ventana('x', 34, 40.6, 42.2, 1.6, 3.2), tinta: true },
  // brazo del crucero que mira al cabo (queda detrás de la nave)
  ...casa(-9, -4, 12, 18, 4.6, 7.4, 'x', 4),
  // nave
  ...casa(-4, 4, N0, N1, 5.6, 9.2, 'y', 15),
  { d: rayas(iso(4, N0, 0), iso(4, N0, 5.6), iso(4, N1, 0), iso(4, N1, 5.6), 16), w: 0.3, suave: true },
  { d: ventana('x', 4, N0 + 2.4, N0 + 3.7, 2, 4.2) + ventana('x', 4, N1 - 3.4, N1 - 2.1, 2, 4.2), tinta: true },
  // brazo del crucero que mira a la ciudad, con su hastial
  ...casa(4, 9, 12, 18, 4.6, 7.4, 'x', 4),
  { d: ventana('x', 9, 14.3, 15.7, 1.8, 3.8), tinta: true },
  // cuerpo de entrada, más alto, con el frontón
  ...casa(-4, 4, F, N0, 7.4, 11, 'y', 5),
  // torre campanario
  { d: pol(iso(1.8, TY0, 9.4), iso(1.8, TY1, 9.4), iso(1.8, TY1, 19), iso(1.8, TY0, 19)), papel: true },
  { d: pol(iso(-1.8, TY0, 9), iso(1.8, TY0, 9), iso(1.8, TY0, 19), iso(-1.8, TY0, 19)), papel: true },
  { d: arco('y', TY0, 0, 14.6, 16.4, 0.95) + arco('x', 1.8, TC, 14.6, 16.4, 0.95), tinta: true },
  { d: lin(iso(-1.9, TY0, 13.6), iso(1.9, TY0, 13.6), iso(1.9, TY1, 13.6)) + lin(iso(-2, TY0, 19), iso(2, TY0, 19), iso(2, TY1, 19)), w: 0.9 },
  { d: pol(iso(2.1, TY0 - 0.3, 19), iso(2.1, TY1 + 0.3, 19), iso(0, TC, 25)), papel: true },
  { d: rayas(iso(2.1, TY0 - 0.3, 19), iso(0, TC, 25), iso(2.1, TY1 + 0.3, 19), iso(0, TC, 25), 5), w: 0.45, techo: true },
  { d: pol(iso(-2.1, TY0 - 0.3, 19), iso(2.1, TY0 - 0.3, 19), iso(0, TC, 25)), papel: true },
  { d: rayas(iso(-2.1, TY0 - 0.3, 19), iso(0, TC, 25), iso(2.1, TY0 - 0.3, 19), iso(0, TC, 25), 5), w: 0.45, techo: true },
  { d: lin(iso(0, TC, 25), iso(0, TC, 28.4)) + lin(iso(-0.9, TC, 27.2), iso(0.9, TC, 27.2)), w: 0.8 },
  // frente: molduras del frontón (las verdes, en tinta llena), puerta bajo el abanico
  { d: pol(iso(-4, F, 7.4), iso(0, F, 11), iso(4, F, 7.4)), papel: true },
  { d: lin(iso(-4.3, F, 7.4), iso(0, F, 11.2), iso(4.3, F, 7.4)) + lin(iso(-4.3, F, 7.4), iso(4.3, F, 7.4)), w: 1.3 },
  { d: lin(iso(-4.2, F, 4.7), iso(4.2, F, 4.7)), w: 1 },
  { d: arco('y', F, 0, 0, 2.7, 1.25), tinta: true },
  // cerco de tablas, con la tranquera en el eje de la entrada
  { d: Array.from({ length: 2 * LADO / 1.5 + 1 }, (_, i) => -LADO + i * 1.5).filter((v) => Math.abs(v) > 2).map((v) => lin(iso(v, CERCO, 0), iso(v, CERCO, 1.7))).join('') + lin(iso(-LADO, CERCO, 1.1), iso(-2.2, CERCO, 1.1)) + lin(iso(2.2, CERCO, 1.1), iso(LADO, CERCO, 1.1)), w: 0.5 },
  { d: Array.from({ length: 9 }, (_, i) => CERCO + 1.5 + i * 1.5).map((v) => lin(iso(LADO, v, 0), iso(LADO, v, 1.7))).join('') + lin(iso(LADO, CERCO, 1.1), iso(LADO, CERCO + 13.5, 1.1)), w: 0.5 },
];
---
<g class="maqueta-mision" transform={`translate(${x} ${y}) scale(${escala})`} fill="none" stroke="var(--tinta)" stroke-linejoin="round" stroke-linecap="round">
  {piezas.map((p) => (
    <path d={p.d} fill={p.tinta ? 'var(--tinta)' : p.papel && p.w === undefined ? 'var(--papel)' : 'none'} stroke={p.tinta ? 'none' : p.techo ? 'var(--acento)' : p.suave ? 'var(--tinta-suave)' : p.papel && p.w !== undefined ? 'var(--papel)' : 'var(--tinta)'} stroke-width={p.w ?? 0.7} />
  ))}
</g>
