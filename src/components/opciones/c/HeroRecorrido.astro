---
// Opción C · Recorrido con el scroll. El hero arranca de cerca sobre el Cabo Domingo y, al
// bajar, la cámara se aleja hasta dejar la costa entera (la misma lámina de HeroMaqueta).
// El alejamiento es una sola escala alrededor de un punto fijo (--ax, --ay), así nada salta:
// el script solo escribe --p (avance de 0 a 1) y el CSS hace el resto.
// Sin script, con prefers-reduced-motion o en pantallas muy bajas no hay recorrido: --p vale 1
// y se ve la costa entera, con la vista del cabo desde la playa para que se lea bien.
import Maqueta from '../../Maqueta.astro';
import Vista from '../../Vista.astro';
import m from '../../../data/maqueta.json';
const agenda = 'https://calendar.app.google/ucnmS77YVC4ax2TE9';

// grados decimales → grados, minutos y segundos
const gms = (v: number) => {
  const t = Math.round(Math.abs(v) * 3600);
  return `${Math.floor(t / 3600)}°${String(Math.floor((t % 3600) / 60)).padStart(2, '0')}′${String(t % 60).padStart(2, '0')}″`;
};
// Paradas: coordenadas de docs/lugar/mapa-rio-grande.md; (x, y) es el remate de cada hito en
// la maqueta (de ahí sube el rótulo); «desde» y «tel» son el avance en que ese punto ya entró
// en cuadro, en escritorio y en teléfono.
const { baliza, mision, torre } = m.lugares;
const paradas = [
  { lat: -53.687288, lon: -67.847593, x: baliza[0], y: baliza[1] - 26, desde: -1, tel: -1 }, // baliza, node/3607789181
  { lat: -53.7247, lon: -67.7989, x: mision[0] - 2, y: mision[1] - 45, desde: 0.3, tel: 0.62 }, // capilla de la Misión, way/1058700771
  { lat: -53.78558, lon: -67.69586, x: torre[0], y: torre[1] - 56, desde: 0.84, tel: 0.9, borde: true }, // Antigua Torre de Aguas, way/828268896
];
// la linterna de la baliza (MaquetaBaliza: 10,2 m de alto a escala 2,1), de donde sale el haz
const linterna = [baliza[0], baliza[1] - 21.4];
const pct = (v: number, total: number) => `${((v / total) * 100).toFixed(3)}%`;
---
<section class="recorrido" aria-labelledby="hero-titulo" style={`--prop:${(m.ancho / m.alto).toFixed(4)}`}>
  <div class="fija">
    <div class="ventana">
      <!-- la maqueta en mapa de bits, solo mientras se mueve (la llena el script) -->
      <canvas class="capa foto" aria-hidden="true"></canvas>
      <div class="capa arte" role="img" aria-label="Maqueta grabada de la costa norte de Río Grande, Tierra del Fuego, vista desde el mar. Primero, de cerca, el Cabo Domingo con su baliza en lo más alto del acantilado; al alejarse aparecen la Misión Salesiana y la Ruta 3 y, al final, la ciudad con la Torre de Agua junto a la desembocadura del río Grande.">
        <Maqueta />
        {paradas.map((p) => (
          <p class:list={['rotulo', { borde: p.borde }]} style={`left:${pct(p.x, m.ancho)};top:${pct(p.y, m.alto)};--d:${p.desde};--t:${p.tel}`}>
            <span>{gms(p.lat)} S<br />{gms(p.lon)} O</span>
          </p>
        ))}
      </div>
      <!-- el haz va aparte de la maqueta: gira solo en la placa de video y no la hace redibujar -->
      <div class="capa luz" aria-hidden="true">
        <div class="plano" style={`left:${pct(linterna[0], m.ancho)};top:${pct(linterna[1], m.alto)}`}>
          <svg class="haz" viewBox="0 0 100 12">
            <linearGradient id="c-haz" gradientUnits="userSpaceOnUse" x1="0" x2="100">
              <stop offset="0" stop-color="var(--tinta)" stop-opacity="0.5" />
              <stop offset="0.5" stop-color="var(--tinta)" stop-opacity="0.2" />
              <stop offset="1" stop-color="var(--tinta)" stop-opacity="0" />
            </linearGradient>
            <path d="M0 6L100 0V12Z" fill="url(#c-haz)" />
            <path d="M0 6L100 0M0 6L100 12M0 6H100" fill="none" stroke="url(#c-haz)" stroke-width="0.3" />
          </svg>
        </div>
      </div>
      <div class="velo"></div>
      <div class="velo barra"></div>
    </div>

    <div class="texto">
      <p class="coordenadas">53°47′09″ S · 67°42′07″ O</p>
      <h1 id="hero-titulo">Un laboratorio en el borde del continente</h1>
      <p class="bajada">Inteligencia artificial, satélites y software en producción. Hechos con tiempo, cerca del mar.</p>
      <div class="acciones">
        <a class="primario" href={agenda} target="_blank" rel="noopener">Agendar una reunión →</a>
        <a class="secundario" href="#laboratorio">Conocer el laboratorio ↓</a>
      </div>
    </div>

    <div class="lamina" role="img" aria-label="El Cabo Domingo visto desde la playa, al sudeste: meseta que sube hacia la punta, borde de roca y la baliza en lo más alto.">
      <Vista />
    </div>
  </div>
</section>

<script is:inline>
  // Avance del recorrido: --p de 0 (cabo de cerca) a 1 (costa entera), atado al scroll.
  // ?p=0.5 lo deja fijo, para capturas.
  (() => {
    const s = document.currentScript.previousElementSibling;
    if (matchMedia('(prefers-reduced-motion: reduce), (max-height: 520px)').matches) return;
    const prueba = new URLSearchParams(location.search).get('p');
    const fijo = prueba === null ? null : String(Math.min(1, Math.max(0, +prueba || 0)));
    let pedido = 0, antes, foto = false, parar;
    const medir = () => {
      pedido = 0;
      const tramo = s.offsetHeight - s.firstElementChild.offsetHeight;
      // el último 15 % del tramo queda quieto, con la costa entera, antes de soltar la página
      const p = fijo ?? Math.min(1, Math.max(0, -s.getBoundingClientRect().top / (tramo * 0.85))).toFixed(4);
      if (p === antes) return;
      s.style.setProperty('--p', (antes = p));
      // Redibujar la maqueta entera en cada cuadro es caro: mientras se mueve se muestra su foto
      // (escalarla no cuesta nada) y, al parar, vuelve el dibujo, nítido.
      if (!foto) return;
      s.classList.add('moviendo');
      clearTimeout(parar);
      parar = setTimeout(() => s.classList.remove('moviendo'), 200);
    };
    const pedir = () => pedido || (pedido = requestAnimationFrame(medir));
    s.classList.add('anda');
    medir();
    addEventListener('scroll', pedir, { passive: true });
    addEventListener('resize', pedir);
    // fuera de pantalla, el haz se queda quieto
    new IntersectionObserver(([e]) => s.classList.toggle('fuera', !e.isIntersecting)).observe(s);

    // La foto: la maqueta pasada una vez a un canvas. Si algo falla, el recorrido sigue con el dibujo.
    const sacar = async () => {
      const svg = s.querySelector('.maqueta'), lienzo = s.querySelector('.foto'), estilo = getComputedStyle(svg);
      const [, , vw, vh] = svg.getAttribute('viewBox').split(' ');
      // más grande que la lámina final, para que de cerca no se vea blanda; 4096 es el tope seguro de un canvas
      const w = Math.min(4096, Math.round(svg.parentElement.offsetWidth * devicePixelRatio * 2.6)), h = Math.round((w * vh) / vw);
      const tintas = ['--papel', '--tinta', '--tinta-suave'].map((v) => `${v}:${estilo.getPropertyValue(v)}`).join(';');
      const texto = new XMLSerializer().serializeToString(svg).replace('<svg', `<svg width="${w}" height="${h}" style="${tintas}"`);
      const img = new Image();
      img.src = URL.createObjectURL(new Blob([texto], { type: 'image/svg+xml' }));
      await img.decode();
      lienzo.width = w;
      lienzo.height = h;
      const ctx = lienzo.getContext('2d');
      ctx.drawImage(img, 0, 0, w, h);
      ctx.getImageData(0, 0, 1, 1); // obliga a pintarla ahora y no en el primer cuadro del scroll
      URL.revokeObjectURL(img.src);
      foto = true;
    };
    addEventListener('load', () => setTimeout(() => sacar().catch(() => {}), 300));
  })();
</script>

<style>
  .recorrido {
    --alto: max(560px, 100svh);
    --w: min(100vw, var(--alto) * var(--prop));
    --aw: calc(var(--w) * 1.08); /* ancho de la lámina al final */
    --p: 1;
    /* cuánto más cerca arranca, y el punto de la lámina que no se mueve al alejarse */
    --z0: 3.5;
    --ax: 88.5%;
    --ay: 20.3%;
    position: relative;
  }
  .recorrido.anda {
    height: calc(var(--alto) * 3);
  }
  .fija {
    --z: pow(var(--z0), calc(1 - var(--p)));
    position: sticky;
    top: 0;
    height: var(--alto);
    overflow: hidden;
  }
  .ventana {
    position: absolute;
    inset: 0;
  }
  /* la foto, la maqueta y el haz: las tres capas comparten lugar y cámara */
  .capa {
    position: absolute;
    right: calc(var(--w) * -0.068);
    bottom: 0;
    width: var(--aw);
    aspect-ratio: var(--prop);
    transform-origin: var(--ax) var(--ay);
    transform: scale(var(--z));
  }
  .luz {
    pointer-events: none;
  }
  /* quieta no existe: así no arrastra a la maqueta a una capa de video y el dibujo queda nítido */
  .foto {
    display: none;
  }
  .moviendo .foto {
    display: block;
  }
  .moviendo .arte :global(.maqueta) {
    visibility: hidden;
  }

  /* rótulos de coordenadas: suben desde el hito y no cambian de tamaño con la cámara */
  .rotulo {
    position: absolute;
    width: 0;
    height: 0;
    transform-origin: 0 0;
    transform: scale(calc(1 / var(--z)));
    opacity: clamp(0, calc((var(--p) - var(--desde, var(--d))) * 14), 1);
    font: 400 10px/1.55 var(--mono);
    letter-spacing: 0.1em;
    white-space: nowrap;
  }
  .rotulo::before {
    content: '';
    position: absolute;
    left: 0;
    bottom: 3px;
    height: 46px;
    border-left: 1px solid var(--tinta);
  }
  .rotulo span {
    position: absolute;
    right: 7px;
    bottom: 22px;
    padding: 2px 4px;
    text-align: right;
    background: var(--papel);
  }

  /* el haz de la baliza: gira en el plano del suelo (por eso la elipse) */
  .plano {
    --r: calc(var(--aw) * 0.12 * var(--z0));
    position: absolute;
    width: 0;
    height: 0;
    /* se dibuja al tamaño de la vista de cerca y se achica: nunca se estira */
    transform: scale(calc(1.2247 / var(--z0)), calc(0.7071 / var(--z0)));
  }
  .haz {
    position: absolute;
    left: 0;
    top: calc(var(--r) * -0.06);
    width: var(--r);
    height: calc(var(--r) * 0.12);
    transform-origin: 0 50%;
    transform: rotate(45deg); /* quieto: derecho hacia el mar */
  }
  .anda .haz {
    animation: girar 10s linear infinite;
  }
  .fuera .haz {
    animation-play-state: paused;
  }
  @keyframes girar {
    from {
      transform: rotate(45deg);
    }
    to {
      transform: rotate(405deg);
    }
  }

  /* de cerca, la tierra de atrás se funde con el papel debajo del texto y de la barra */
  .velo {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(ellipse 50% 62% at 12% 30%, var(--papel) 60%, transparent);
    opacity: clamp(0, calc(1 - var(--p) * 1.6), 1);
  }
  .velo.barra {
    background: linear-gradient(var(--papel) 70px, transparent 130px);
    opacity: clamp(0, calc(1 - var(--p) * 14), 1); /* la barra se va con los primeros píxeles */
  }

  .texto {
    position: relative;
    z-index: 2;
    padding: max(88px, var(--w) * 0.074) var(--margen) 0;
  }
  .coordenadas {
    margin-bottom: calc(var(--w) * 0.011);
    font: 400 11px var(--mono);
    letter-spacing: 0.12em;
    color: var(--tinta-suave);
  }
  h1 {
    font-family: var(--serif);
    font-weight: 400;
    font-size: calc(var(--w) * 0.045);
    line-height: 1;
    letter-spacing: -0.01em;
    max-width: 14em;
    text-wrap: balance;
  }
  .bajada {
    margin-top: calc(var(--w) * 0.011);
    font-size: max(15px, var(--w) * 0.0128);
    line-height: 1.45;
    max-width: 46ch;
  }
  .acciones {
    margin-top: calc(var(--w) * 0.016);
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .acciones a {
    padding: 0.9em 1.35em;
    font-weight: 600;
    font-size: max(14px, var(--w) * 0.011);
    text-decoration: none;
    white-space: nowrap;
  }
  .primario {
    background: var(--tinta);
    color: var(--papel);
  }
  .secundario {
    color: var(--tinta);
    border: 1px solid var(--tinta-suave);
    background: var(--papel);
  }
  .acciones a:focus-visible {
    outline: 2px solid var(--tinta);
    outline-offset: 3px;
  }

  /* al llegar, en el mar: el cabo visto desde la playa, como los perfiles de costa de las cartas */
  .lamina {
    position: absolute;
    z-index: 1;
    right: var(--margen);
    bottom: calc(var(--w) * 0.022);
    width: calc(var(--w) * 0.38);
    opacity: clamp(0, calc((var(--p) - 0.9) * 10), 1);
  }
  /* con recorrido se pinta de entrada en su propia capa (casi transparente no es invisible para
     el navegador): si no, la primera vez que asoma traba el scroll un instante */
  .anda .lamina {
    will-change: opacity;
    opacity: clamp(0.001, calc((var(--p) - 0.9) * 10), 1);
  }

  /* pantallas angostas: el texto arriba y el recorrido en la ventana de abajo */
  @media (max-width: 900px) {
    .recorrido {
      --alto: 100svh;
      /* la costa entera entra a lo ancho; si la ventana es muy baja, se achica para entrar a lo alto */
      --aw: min(136vw, 96cqh * var(--prop));
      --z0: 5.7;
      --ax: 86.7%;
      --ay: 27.1%;
    }
    .recorrido:not(.anda) .fija {
      height: auto;
      min-height: 100svh;
    }
    .recorrido:not(.anda) .ventana {
      flex-basis: 92vw;
    }
    .fija {
      display: flex;
      flex-direction: column;
    }
    .texto {
      padding-top: 84px;
    }
    .coordenadas {
      margin-bottom: 14px;
    }
    h1 {
      font-size: clamp(34px, 10.4vw, 56px);
    }
    .bajada {
      margin-top: 16px;
      font-size: 17px;
      max-width: 36ch;
      text-wrap: balance;
    }
    .acciones {
      margin-top: 22px;
    }
    .acciones a {
      font-size: 15px;
    }
    .ventana {
      order: 3;
      position: relative;
      flex: 1 0 68vw;
      margin-top: 12px;
      overflow: hidden;
      container-type: size;
    }
    .capa {
      right: auto;
      left: calc(var(--aw) * -0.144);
      /* de cerca, el filo del cabo queda arriba de la ventana, mida lo que mida */
      translate: 0 calc((1 - var(--p)) * (30px + 0.97 * var(--aw) / var(--prop) - 100cqh));
    }
    .rotulo {
      --desde: var(--t);
    }
    /* el hito queda contra el borde izquierdo: el texto va del otro lado de la línea */
    .rotulo.borde span {
      right: auto;
      left: 7px;
      text-align: left;
    }
    .velo {
      inset: 0 0 auto;
      height: 40px;
      background: linear-gradient(var(--papel), transparent);
      opacity: 1;
    }
    .velo.barra {
      display: none;
    }
    /* con recorrido el cabo ya se vio de cerca; sin recorrido, la vista desde la playa va
       entera entre el texto y la maqueta */
    .anda .lamina {
      display: none;
    }
    .lamina {
      order: 2;
      position: static;
      width: auto;
      margin: 28px var(--margen) 0;
    }
  }
</style>
