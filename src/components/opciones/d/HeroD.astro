---
// Opción D · Planta con el cabo levantado.
// La planta de la costa (la del hero actual) y, sobre el lugar real del cabo, su vista desde la
// playa parada como un desplegable: reemplaza a la lámina suelta que estaba a la derecha.
// Como el cabo queda al oeste (izquierda) de la planta, el texto pasa a la derecha, sobre el mar.
// Todo lo que va sobre el mapa se ubica en unidades del mapa (100 = 1 km) por medio de --u.
import mapa from '../../../data/mapa.json';
import MapaD from './MapaD.astro';
import CaboD from './CaboD.astro';

const GAP = 260; // el mapa se extiende esto al oeste de su marco, para que entre la rampa de la meseta
const K = 1.5; // unidades de mapa por unidad del dibujo del cabo
const PIE = 738; // y del mapa donde apoya el cabo levantado (la costa en la punta)
const ANCHO = mapa.marco.w + GAP, ALTO = mapa.costaY + 520;
const [bx] = mapa.lugares.baliza;
const CAJA = { x: -GAP, y: 320, w: GAP + 760, h: 480 };
const LINTERNA = { x: bx, y: PIE - 257.4 * K }; // centro de la linterna: 257,4 unidades del dibujo sobre la playa (ver CaboD)
const MIRA: [number, number] = [bx + 230, 781]; // la playa, unos 2,3 km al sudeste
const BARCO = { x: 1812, y: 676 }; // frente a la boca del río, del lado del mar
const agenda = 'https://calendar.app.google/ucnmS77YVC4ax2TE9';

// haz de la baliza, en grabado: un abanico de rayas finas, cada una con su ritmo de cortes
const rayos = [510, 300, 440, 250, 500, 270, 420, 310, 490].map((r1, i) => {
  const a = ((i - 4) * 1.6 * Math.PI) / 180, r0 = i % 2 ? 46 : 24;
  const p = (r: number) => `${(r * Math.cos(a)).toFixed(1)} ${(r * Math.sin(a)).toFixed(1)}`;
  // cada rayo es un trazo largo y, después de un respiro, otro más corto
  const medio = r0 + (r1 - r0) * (0.52 + (i % 3) * 0.09);
  return `M${p(r0)}L${p(medio)}M${p(medio + 9)}L${p(r1)}`;
}).join('');
// posición y tamaño en unidades del mapa (x ya corrido por el gap)
const pos = (x: number, y: number, w: number, h: number) => `--x:${x + GAP};--y:${y};--w:${w};--h:${h}`;
---
<section class="hero" aria-labelledby="hero-titulo">
  <div class="texto">
    <p class="volanta">53°47′09″ S · 67°42′07″ O</p>
    <h1 id="hero-titulo"><span>Un laboratorio </span><span>en el borde </span><span>del continente</span></h1>
    <p class="bajada">Inteligencia artificial, satélites y software en producción. Hechos con tiempo, cerca del mar.</p>
    <div class="acciones">
      <a class="primario" href={agenda} target="_blank" rel="noopener">Agendar una reunión →</a>
      <a class="secundario" href="#laboratorio">Conocer el laboratorio ↓</a>
    </div>
  </div>

  <div class="escena" role="img" aria-label="Mapa grabado de la costa norte de Río Grande, Tierra del Fuego, visto en planta. Sobre su lugar se levanta el Cabo Domingo, dibujado como se ve desde la playa, con la baliza encendida en el filo. Siguen la Misión Salesiana, la Ruta 3, la ciudad con la Torre de Agua y la desembocadura del río Grande, a la que entra un barco.">
    <div class="arte" style={`--ancho:${ANCHO};--alto:${ALTO}`}>
      <div class="pos" style={pos(-GAP, 0, ANCHO, ALTO)}><MapaD gap={GAP} mira={MIRA} /></div>
      <div class="pos" style={pos(CAJA.x, CAJA.y, CAJA.w, CAJA.h)}><CaboD k={K} pie={PIE} caja={CAJA} /></div>

      <svg class="haz" style={`--x:${LINTERNA.x + GAP};--y:${LINTERNA.y}`} viewBox="0 -45 520 90" aria-hidden="true">
        <defs>
          <linearGradient id="d-haz" gradientUnits="userSpaceOnUse" x1="0" x2="520" y1="0" y2="0">
            <stop offset="0" stop-color="var(--tinta)" />
            <stop offset="0.55" stop-color="var(--tinta)" stop-opacity="0.7" />
            <stop offset="1" stop-color="var(--tinta)" stop-opacity="0" />
          </linearGradient>
        </defs>
        <!-- el trazo va como atributo: en una hoja de estilos externa, url(#…) no encuentra el degradé -->
        <path d={rayos} stroke="url(#d-haz)" />
      </svg>

      <div class="barco pos" style={pos(BARCO.x - 26, BARCO.y - 28, 52, 34)}>
        <svg viewBox="-26 -24 52 34" aria-hidden="true">
          <!-- recorte de papel alrededor, para que no lo crucen las líneas del mar -->
          <path d="M-21 -6.5L-15 3H15L19 -5H11V-12H2V-5H-9Q-15 -5 -21 -6.5Z" fill="var(--papel)" stroke="var(--papel)" stroke-width="5" stroke-linejoin="round" />
          <path d="M-25 5.2h9M-12 6h23M15 5.2h9" class="agua" />
          <path d="M-21 -6.5L-15 3H15L19 -5H-9Q-15 -5 -21 -6.5Z" fill="var(--papel)" stroke-width="1" />
          <path d="M-17.5 -1H16.8" stroke-width="0.5" />
          <path d="M2 -5V-12H11V-5M4.3 -10h4.4v2.4H4.3Z" fill="var(--papel)" stroke-width="0.8" />
          <path d="M-4 -5V-20M-4 -17L-13 -8M-4 -20l4.5 1.6L-4 -17" stroke-width="0.7" />
          <path d="M22 1.5h9M24 -2h6" class="estela" />
        </svg>
      </div>

      <p class="rotulo" aria-hidden="true">
        <span>53°41′14″ S · 67°50′51″ O</span>
        <span><i>◀</i> Vista desde la playa<span class="largo">, al sudeste</span></span>
        <span class="largo">Dibujo a partir de fotografías</span>
      </p>
    </div>
  </div>
</section>

<script>
  // lo que no se ve en pantalla se pausa
  const hero = document.querySelector('.hero');
  if (hero) new IntersectionObserver(([e]) => hero.classList.toggle('fuera', !e.isIntersecting)).observe(hero);
</script>

<style>
  .hero {
    --u: calc(103vw / 2372); /* px por unidad del mapa: entra de la rampa de la meseta a la boca del río */
    --tierra: clamp(12.5vw, 25svh, 19vw); /* de la costa al borde de abajo */
    --techo: calc(var(--tierra) + 150 * var(--u)); /* hasta donde llegan las líneas del mar bajo el texto */
    --alto-hero: max(680px, 100svh, 50vw); /* en pantallas muy apaisadas baja un poco del pliegue, para no achicar el titular */
    position: relative;
    height: var(--alto-hero);
    overflow: hidden;
  }
  .hero.fuera :global(*) {
    animation-play-state: paused !important;
  }

  /* --- texto: a la derecha, sobre el mar, centrado entre la barra y las líneas de agua --- */
  .texto {
    position: absolute;
    z-index: 2;
    top: 84px;
    bottom: var(--techo);
    left: 54.5vw;
    right: var(--margen);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .volanta {
    margin-bottom: 18px;
    font: 400 11px var(--mono);
    letter-spacing: 0.12em;
    color: var(--tinta-suave);
  }
  h1 {
    font-family: var(--serif);
    font-weight: 400;
    /* tres líneas: el cuerpo se achica si la pantalla es baja, para no pisar el mar */
    font-size: clamp(40px, min(5.6vw, (var(--alto-hero) - var(--techo) - 84px - 186px) / 3), 84px);
    line-height: 1;
    letter-spacing: -0.01em;
  }
  h1 span {
    display: block; /* tres líneas fijas en escritorio; en el teléfono corre como texto */
  }
  .bajada {
    margin-top: 18px;
    font-size: clamp(16px, 1.32vw, 19px);
    line-height: 1.45;
    max-width: 37ch;
  }
  .acciones {
    margin-top: 26px;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .acciones a {
    padding: 15px 22px;
    font-weight: 600;
    font-size: 16px;
    text-decoration: none;
    white-space: nowrap;
  }
  .primario {
    background: var(--tinta);
    color: var(--papel);
  }
  .secundario {
    color: var(--tinta);
    border: 1px solid var(--tinta-suave);
    background: var(--papel);
  }
  .acciones a:focus-visible {
    outline: 2px solid var(--tinta);
    outline-offset: 3px;
  }

  /* --- escena: la planta abajo, con la costa a una altura fija sobre el borde --- */
  .escena {
    position: absolute;
    inset: 0;
  }
  .arte {
    position: absolute;
    left: 0;
    top: calc(100% - var(--tierra) - 738 * var(--u));
    width: calc(var(--ancho) * var(--u));
    height: calc(var(--alto) * var(--u));
  }
  .pos {
    position: absolute;
    left: calc(var(--x) * var(--u));
    top: calc(var(--y) * var(--u));
    width: calc(var(--w) * var(--u));
    height: calc(var(--h) * var(--u));
  }

  /* --- haz de la baliza: barre el mar despacio, de arriba hacia la costa, y vuelve a empezar --- */
  .haz {
    --largo: 520;
    --desde: -54deg;
    --hasta: 13deg;
    position: absolute;
    left: calc(var(--x) * var(--u));
    top: calc((var(--y) - var(--largo) * 45 / 520) * var(--u));
    width: calc(var(--largo) * var(--u));
    height: calc(var(--largo) * 90 / 520 * var(--u));
    overflow: visible;
    fill: none;
    stroke-width: 0.7px;
    stroke-linecap: round;
    transform-origin: 0 50%;
    transform: rotate(-9deg);
    animation: barrer 13s linear 2.4s infinite backwards;
  }
  .haz path {
    vector-effect: non-scaling-stroke;
  }
  @keyframes barrer {
    0% {
      transform: rotate(var(--desde));
      opacity: 0;
    }
    9%,
    80% {
      opacity: 1;
    }
    90%,
    100% {
      transform: rotate(var(--hasta));
      opacity: 0;
    }
  }

  /* --- barco: viene de mar abierto, dobla la punta y se queda frente a la boca --- */
  .barco {
    animation: arrimar 17s cubic-bezier(0.25, 0.6, 0.3, 1) 1s backwards;
  }
  .barco svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
    fill: none;
    stroke: var(--tinta);
    stroke-linecap: round;
    stroke-linejoin: round;
    animation: bajar 17s cubic-bezier(0.55, 0, 0.45, 1) 1s backwards;
  }
  .barco .agua {
    stroke-width: 0.7;
  }
  .barco .estela {
    stroke-width: 0.6;
    opacity: 0;
    animation: estela 17s linear 1s backwards;
  }
  @keyframes arrimar {
    from {
      transform: translateX(calc(440 * var(--u)));
    }
  }
  @keyframes bajar {
    from {
      transform: translateY(calc(-150 * var(--u)));
    }
  }
  @keyframes estela {
    0%,
    80% {
      opacity: 1;
    }
  }

  /* --- rótulo del cabo: solo coordenadas y desde dónde se lo mira --- */
  .rotulo {
    position: absolute;
    left: var(--margen);
    top: calc(386 * var(--u));
    transform: translateY(-100%);
    display: grid;
    gap: 5px;
    font: 400 9.5px var(--mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--tinta-suave);
    white-space: nowrap;
    animation: aparecer 0.6s ease-out 1.7s backwards;
  }
  @keyframes aparecer {
    from {
      opacity: 0;
    }
  }
  .rotulo i {
    font-style: normal;
    color: var(--tinta);
  }

  @media (max-width: 1240px) {
    .acciones a {
      padding: 13px 16px;
      font-size: 15px;
    }
    /* el rótulo tiene que entrar a la izquierda de la baliza */
    .rotulo {
      font-size: 8.5px;
    }
    .rotulo .largo {
      display: none;
    }
  }

  /* --- teléfono y tableta: texto arriba, y abajo la escena cerrada sobre el cabo --- */
  @media (max-width: 900px), (max-aspect-ratio: 11/10) {
    .hero {
      --u: calc(100vw / 1060); /* tableta: del cabo a la misión */
      height: auto;
      min-height: var(--alto-hero);
      display: flex;
      flex-direction: column;
    }
    .texto {
      position: relative;
      inset: auto;
      display: block;
      padding: 100px var(--margen) 0;
    }
    h1 {
      font-size: clamp(38px, 11.4vw, 64px);
      text-wrap: balance;
    }
    h1 span {
      display: inline;
    }
    .volanta {
      margin-bottom: 14px;
    }
    .bajada {
      font-size: 18px;
    }
    .acciones a {
      padding: 15px 22px;
      font-size: 16px;
    }
    .escena {
      position: relative;
      inset: auto;
      flex: none;
      margin-top: auto;
      /* de 215 (aire para el haz) a 330 unidades tierra adentro de la costa */
      height: calc(853 * var(--u));
      overflow: hidden;
    }
    .arte {
      top: calc(-215 * var(--u));
      left: calc(-110 * var(--u)); /* arranca 150 unidades al oeste del marco */
    }
    .haz {
      --largo: 330;
      --desde: -26deg;
      --hasta: 12deg;
    }
    .barco {
      display: none; /* la boca del río queda fuera del encuadre */
    }
    .rotulo {
      left: calc(110 * var(--u) + var(--margen));
    }
  }
  @media (max-width: 520px) {
    .hero {
      --u: calc(100vw / 850); /* teléfono: solo el cabo, entero */
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .haz,
    .barco,
    .barco svg,
    .barco .estela,
    .rotulo {
      animation: none;
    }
  }
</style>
