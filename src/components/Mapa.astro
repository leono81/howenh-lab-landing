---
// Mapa de la costa norte de Río Grande en grabado de una tinta.
// La geometría es real (OSM, ver scripts/mapa.mjs); acá solo se le da estilo.
import mapa from '../data/mapa.json';
const { marco, capas: c, lugares } = mapa;

// líneas de agua: distancias a la costa (en unidades, 100 = 1 km), cada vez más separadas y suaves
const lineasMar = [5, 11, 18, 26, 35, 46, 59, 74, 92, 113, 137].map((d, i, a) => ({ d, w: 1.25 - (i / a.length) * 0.6, o: 1 - (i / a.length) * 0.75 }));
const lineasChicas = [3, 7, 12, 18].map((d, i) => ({ d, w: 0.9, o: 1 - i * 0.2 }));
---
<svg class="mapa" viewBox={`0 0 ${marco.w} ${marco.h}`} style={`--costa:${(mapa.costaY / marco.h).toFixed(4)}`} aria-hidden="true">
  <defs>
    <clipPath id="m-mar"><path d={c.mar} /></clipPath>
    <clipPath id="m-estuario"><path d={c.estuario} clip-rule="evenodd" /></clipPath>
    <clipPath id="m-lagunas"><path d={c.lagunas.join('')} /></clipPath>
    <!-- el relieve se apaga tierra adentro: manda la costa -->
    <linearGradient id="m-fundido" gradientUnits="userSpaceOnUse" x1="0" x2="0" y1={mapa.costaY} y2={mapa.costaY + 480}>
      <stop offset="0" stop-color="#fff" />
      <stop offset="0.3" stop-color="#fff" />
      <stop offset="1" stop-color="#fff" stop-opacity="0.15" />
    </linearGradient>
    <mask id="m-tierra" maskUnits="userSpaceOnUse" x="0" y="0" width={marco.w} height={marco.h}>
      <rect width={marco.w} height={marco.h} fill="url(#m-fundido)" />
    </mask>
    <pattern id="m-rayado" width="3.2" height="3.2" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
      <line x1="0" y1="0" x2="0" y2="3.2" stroke="var(--tinta)" stroke-width="1.1" />
    </pattern>
    <pattern id="m-rayado-suave" width="4" height="4" patternUnits="userSpaceOnUse" patternTransform="rotate(-45)">
      <line x1="0" y1="0" x2="0" y2="4" stroke="var(--tinta-suave)" stroke-width="0.8" />
    </pattern>
    <!-- humedal: el signo clásico de mallín, rayitas con matas -->
    <pattern id="m-mallin" width="22" height="11" patternUnits="userSpaceOnUse">
      <path d="M2 8h9M6.5 8v-3.5M4.5 8l-1.5-2.5M8.5 8l1.5-2.5M13 3h7M16.5 3v-2.5" stroke="var(--tinta-suave)" stroke-width="0.7" fill="none" />
    </pattern>
    <pattern id="m-puntos" width="5" height="5" patternUnits="userSpaceOnUse">
      <circle cx="1.2" cy="1.2" r="0.55" fill="var(--tinta-suave)" />
      <circle cx="3.7" cy="3.7" r="0.45" fill="var(--tinta-suave)" />
    </pattern>
  </defs>

  <!-- mar: líneas de agua paralelas a la costa -->
  <g clip-path="url(#m-mar)" fill="none" stroke-linejoin="round" stroke-linecap="round">
    {[...lineasMar].reverse().map((l) => (
      <>
        <path d={c.lineaCosta} stroke="var(--tinta)" stroke-opacity={l.o} stroke-width={l.d * 2 + l.w} />
        <path d={c.lineaCosta} stroke="var(--papel)" stroke-width={Math.max(0.1, l.d * 2 - l.w)} />
      </>
    ))}
  </g>

  <!-- relieve: hachures del DEM (meseta, barranca del cabo, cañadones) -->
  <g fill="none" stroke-linecap="round" mask="url(#m-tierra)">
    {c.hachures.map((g) => <path d={g.d} stroke-width={g.w} stroke={g.suave ? 'var(--tinta-suave)' : 'var(--tinta)'} />)}
  </g>
  <!-- estepa: matas de coirón -->
  <path d={c.estepa} fill="none" stroke="var(--tinta-suave)" stroke-width="0.55" stroke-linecap="round" mask="url(#m-tierra)" />

  <!-- playas, arenas y mallines de la boca -->
  <path d={c.playa + c.arenas} fill="url(#m-puntos)" />
  <path d={c.humedal} fill="url(#m-mallin)" fill-rule="evenodd" />

  <!-- estuario del río Grande -->
  <path d={c.estuario} fill="var(--papel)" fill-rule="evenodd" />
  <g clip-path="url(#m-estuario)" fill="none" stroke-linejoin="round">
    {[...lineasChicas].reverse().map((l) => (
      <>
        <path d={c.estuario} stroke="var(--tinta)" stroke-opacity={l.o} stroke-width={l.d * 2 + l.w} />
        <path d={c.estuario} stroke="var(--papel)" stroke-width={l.d * 2 - l.w} />
      </>
    ))}
  </g>
  <path d={c.rioLinea} fill="none" stroke="var(--tinta)" stroke-width="1.6" stroke-linejoin="round" />
  <path d={c.arroyos} fill="none" stroke="var(--tinta-suave)" stroke-width="0.7" />
  <path d={c.estuario} fill="none" stroke="var(--tinta)" stroke-width="1.3" fill-rule="evenodd" />

  <!-- lagunas de la estepa -->
  <g clip-path="url(#m-lagunas)" fill="none" stroke-linejoin="round">
    {[...lineasChicas].reverse().map((l) => (
      <>
        <path d={c.lagunas.join('')} stroke="var(--tinta)" stroke-opacity={l.o * 0.8} stroke-width={l.d * 2 + l.w} />
        <path d={c.lagunas.join('')} stroke="var(--papel)" stroke-width={l.d * 2 - l.w} />
      </>
    ))}
  </g>
  <path d={c.lagunas.join('')} fill="none" stroke="var(--tinta)" stroke-width="1.1" />

  <!-- ciudad: manzanas rayadas, calles en blanco -->
  <path d={c.trama} fill="none" stroke="url(#m-rayado)" stroke-width="9" stroke-linecap="round" stroke-linejoin="round" />
  <path d={c.trama} fill="none" stroke="var(--papel)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
  <path d={c.avenidas} fill="none" stroke="var(--papel)" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round" />

  <!-- aeropuerto -->
  <path d={c.plataformas} fill="url(#m-rayado-suave)" stroke="var(--tinta)" stroke-width="0.7" />
  <path d={c.rodajes} fill="none" stroke="var(--tinta)" stroke-width="1.6" />
  <path d={c.pista} fill="none" stroke="var(--tinta)" stroke-width="6" />
  <path d={c.pista} fill="none" stroke="var(--papel)" stroke-width="0.6" stroke-dasharray="6 6" />

  <!-- Ruta 3: doble línea -->
  <path d={c.ruta} fill="none" stroke="var(--tinta-suave)" stroke-width="3.4" stroke-linejoin="round" />
  <path d={c.ruta} fill="none" stroke="var(--papel)" stroke-width="1.8" stroke-linejoin="round" />

  <!-- la costa -->
  <path d={c.lineaCosta} fill="none" stroke="var(--tinta)" stroke-width="2.2" stroke-linejoin="round" />

  <!-- marcas provisorias de los lugares (las reemplazan las viñetas) -->
  <g class="marcas">
    {Object.entries(lugares).filter(([n]) => n !== 'cabo').map(([n, [x, y]]) => (
      <g transform={`translate(${x} ${y})`}>
        <circle r="5" fill="var(--papel)" stroke="var(--tinta)" stroke-width="1.6" />
        <text class="rotulo" y="-11" text-anchor="middle">{n}</text>
      </g>
    ))}
  </g>
</svg>

<style>
  .mapa {
    display: block;
    width: 100%;
    height: auto;
  }
  .rotulo {
    font: 500 13px var(--mono);
    fill: var(--tinta);
    paint-order: stroke;
    stroke: var(--papel);
    stroke-width: 4px;
  }
</style>
