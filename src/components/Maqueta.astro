---
// Maqueta isométrica de la costa norte de Río Grande, en grabado de una tinta.
// La geometría llega ya proyectada desde scripts/maqueta.mjs (relieve levantado, lo oculto
// quitado); acá solo se le da estilo. Las únicas piezas que usan una matriz son las líneas
// de agua: el truco de trazos anchos tinta/papel necesita la planta, y como la costa corre
// casi recta el grosor de esas líneas prácticamente no cambia.
import m from '../data/maqueta.json';
import MaquetaMision from './MaquetaMision.astro';
import MaquetaTorre from './MaquetaTorre.astro';
import MaquetaBaliza from './MaquetaBaliza.astro';
// Sin bordes: el mar sigue hasta el borde de la pantalla (el svg deja ver lo que queda fuera de su
// marco) y la tierra se apaga en el papel con un contorno irregular (la silueta de maqueta.mjs).
// Al cargar se imprime: la costa, el mar, el relieve, la ruta, la ciudad que crece desde la plaza
// de la torre y al final las viñetas.
const { capas: c, cabo, agua, silueta, franja, lugares } = m;
// líneas de agua paralelas a la costa, cada vez más separadas y tenues mar adentro
const lineasMar = [4, 9, 15, 22, 30, 39, 49, 60, 72, 87, 105, 127, 154, 186, 225, 272, 330].map((d, i, a) => ({ d, w: 1.2 - (i / a.length) * 0.65, o: 1 - (i / a.length) * 0.85 }));
// zona que cubren las máscaras: el marco y un margen. No más: las capas con máscara se pintan
// enteras y una zona enorme revienta el límite de textura del navegador en pantallas de 2x
// (la maqueta desaparece). Lo que se ve del mar abierto ya cae dentro del marco.
const zona = { x: -60, y: -60, w: m.ancho + 120, h: m.alto + 120 };
const [tx, ty] = lugares.torre;
const lineasChicas = [3, 7, 12, 18].map((d, i) => ({ d, w: 0.9, o: 1 - i * 0.2 }));
---
<svg class="maqueta" viewBox={`0 0 ${m.ancho} ${m.alto}`} aria-hidden="true">
  <defs>
    <clipPath id="q-franja"><rect x={franja.x} y={franja.y} width={franja.w} height={franja.h} /></clipPath>
    <clipPath id="q-mar"><path d={agua.mar} /></clipPath>
    <clipPath id="q-estuario"><path d={agua.estuario} clip-rule="evenodd" clip-path="url(#q-franja)" /></clipPath>
    <!-- la maqueta se apaga en el papel: capas del mismo contorno irregular, cada vez más opacas -->
    <mask id="q-silueta" maskUnits="userSpaceOnUse" x={zona.x} y={zona.y} width={zona.w} height={zona.h}>
      {silueta.map((capa) => <path d={capa.d} fill="#fff" fill-opacity={capa.o} />)}
    </mask>
    <!-- la ciudad crece desde la plaza de la torre -->
    <radialGradient id="q-g-crece">
      <stop offset="0.8" stop-color="#fff" />
      <stop offset="1" stop-color="#fff" stop-opacity="0" />
    </radialGradient>
    <mask id="q-crece" maskUnits="userSpaceOnUse" x={zona.x} y={zona.y} width={zona.w} height={zona.h}>
      <circle class="semilla" cx={tx} cy={ty} r="900" fill="url(#q-g-crece)" />
    </mask>
    <pattern id="q-rayado" width="2.5" height="2.5" patternUnits="userSpaceOnUse" patternTransform="rotate(30)">
      <line x1="0" y1="0" x2="2.5" y2="0" stroke="var(--tinta)" stroke-width="0.95" />
    </pattern>
    <pattern id="q-rayado-suave" width="3.6" height="3.6" patternUnits="userSpaceOnUse" patternTransform="rotate(-30)">
      <line x1="0" y1="0" x2="3.6" y2="0" stroke="var(--tinta-suave)" stroke-width="0.7" />
    </pattern>
    <!-- agua quieta de las lagunas: rayas finas paralelas a la costa -->
    <pattern id="q-agua" width="3" height="3" patternUnits="userSpaceOnUse" patternTransform="rotate(-30)">
      <line x1="0" y1="1.5" x2="3" y2="1.5" stroke="var(--tinta-suave)" stroke-width="0.6" />
    </pattern>
    <pattern id="q-mallin" width="22" height="11" patternUnits="userSpaceOnUse">
      <path d="M2 8h9M6.5 8v-3.5M4.5 8l-1.5-2.5M8.5 8l1.5-2.5M13 3h7M16.5 3v-2.5" stroke="var(--tinta-suave)" stroke-width="0.7" fill="none" />
    </pattern>
    <pattern id="q-puntos" width="5" height="5" patternUnits="userSpaceOnUse">
      <circle cx="1.2" cy="1.2" r="0.55" fill="var(--tinta-suave)" />
      <circle cx="3.7" cy="3.7" r="0.45" fill="var(--tinta-suave)" />
    </pattern>
  </defs>

  <g mask="url(#q-silueta)">
    <!-- mar: líneas de agua paralelas a la costa -->
    <g class="capa-mar" transform={m.matriz}>
      <g clip-path="url(#q-mar)" fill="none" stroke-linejoin="round" stroke-linecap="round">
        {[...lineasMar].reverse().map((l) => (
          <>
            <path d={agua.costa} stroke="var(--tinta)" stroke-opacity={l.o} stroke-width={l.d * 2 + l.w} />
            <path d={agua.costa} stroke="var(--papel)" stroke-width={Math.max(0.1, l.d * 2 - l.w)} />
          </>
        ))}
      </g>
    </g>

    <g fill="none" stroke-linecap="round" stroke-linejoin="round">
      <!-- playas, arenas y mallines de la boca -->
      <path class="capa-orilla" d={c.playa} fill="url(#q-puntos)" />
      <path class="capa-orilla" d={c.humedal} fill="url(#q-mallin)" fill-rule="evenodd" />

      <!-- estuario del río Grande -->
      <g class="capa-agua" transform={m.matriz}>
        <path d={agua.estuario} fill="var(--papel)" fill-rule="evenodd" clip-path="url(#q-franja)" />
        <g clip-path="url(#q-estuario)">
          {[...lineasChicas].reverse().map((l) => (
            <>
              <path d={agua.estuario} stroke="var(--tinta)" stroke-opacity={l.o} stroke-width={l.d * 2 + l.w} />
              <path d={agua.estuario} stroke="var(--papel)" stroke-width={l.d * 2 - l.w} />
            </>
          ))}
        </g>
      </g>
      <path class="capa-orilla" d={c.rio} stroke="var(--tinta)" stroke-width="1.5" />
      <path class="capa-orilla" d={c.arroyos} stroke="var(--tinta-suave)" stroke-width="0.7" />
      <path class="capa-orilla" d={c.estuario} stroke="var(--tinta)" stroke-width="1.2" />

      <!-- relieve y estepa -->
      {c.hachures.map((g) => <path class="capa-relieve" d={g.d} stroke-width={g.w} stroke={g.suave ? 'var(--tinta-suave)' : 'var(--tinta)'} />)}
      <path class="capa-campo" d={c.estepa} stroke="var(--tinta-suave)" stroke-width="0.5" />
      <path class="capa-campo" d={c.lagunas} fill="url(#q-agua)" stroke="var(--tinta)" stroke-width="1" />

      <!-- ciudad: manzanas rayadas, calles en blanco -->
      <g class="capa-ciudad" mask="url(#q-crece)">
        <path d={c.trama} stroke="url(#q-rayado)" stroke-width="9" />
        <path d={c.trama} stroke="var(--papel)" stroke-width="1.4" />
        <path d={c.avenidas} stroke="var(--papel)" stroke-width="2.6" />
      </g>

      <!-- aeropuerto -->
      <g class="capa-aeropuerto">
        <path d={c.plataformas} fill="url(#q-rayado-suave)" stroke="var(--tinta)" stroke-width="0.7" />
        <path d={c.rodajes} stroke="var(--tinta)" stroke-width="1.3" />
        <path d={c.pista} stroke="var(--tinta)" stroke-width="4.6" stroke-linecap="butt" />
        <path d={c.pista} stroke="var(--papel)" stroke-width="0.6" stroke-dasharray="6 6" stroke-linecap="butt" />
      </g>

      <!-- Ruta 3 y Acceso Norte: doble línea -->
      <path class="capa-ruta" d={c.ruta + c.acceso} stroke="var(--tinta)" stroke-width="3.2" pathLength="1" />
      <path class="capa-ruta" d={c.ruta + c.acceso} stroke="var(--papel)" stroke-width="1.7" pathLength="1" />

      <!-- la costa -->
      <path class="capa-costa" d={c.costa} stroke="var(--tinta)" stroke-width="1.9" pathLength="1" />
    </g>

    <!-- Cabo Domingo: las dos paredes (la del este y la que mira al mar) -->
    <g class="capa-cabo" fill="none" stroke="var(--tinta)" stroke-linecap="round" stroke-linejoin="round">
      <path d={cabo.playa} stroke="var(--tinta-suave)" stroke-width="0.9" />
      <path d={cabo.cara} fill="var(--papel)" stroke="none" />
      <path d={cabo.carcavasFinas} stroke-width="0.4" />
      <path d={cabo.sombra} stroke-width="0.55" />
      <path d={cabo.carcavas} stroke-width="0.8" />
      <path d={cabo.alero} stroke-width="0.55" />
      <path d={cabo.capas} stroke-width="0.6" />
      <path d={cabo.grietas} stroke-width="0.5" />
      <path d={cabo.base} stroke-width="1.1" />
      <path d={cabo.pie} stroke-width="0.7" />
      <path d={cabo.filo} stroke-width="1.5" />
    </g>
  </g>

  <!-- viñetas, en los mismos ejes -->
  <MaquetaMision x={lugares.mision[0]} y={lugares.mision[1]} escala={1.45} />
  <MaquetaTorre x={lugares.torre[0]} y={lugares.torre[1]} escala={1.75} />
  <MaquetaBaliza x={lugares.baliza[0]} y={lugares.baliza[1]} escala={2.1} />
</svg>

<style>
  .maqueta {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
    /* la impresión, una sola vez: la costa se traza, aparece el mar, se levanta el cabo con su
       relieve, se traza la ruta, la ciudad crece desde la plaza de la torre y al final las viñetas */
    --i0: 0.15s;
    --i1: 0.9s;
    --i2: 1.3s;
    --i3: 1.9s;
    --i4: 2.9s;
  }
  @keyframes q-tinta {
    from {
      opacity: 0;
    }
  }
  /* trazo que se dibuja de punta a punta (pathLength = 1) */
  @keyframes q-trazo {
    from {
      stroke-dasharray: 1 1.02;
      stroke-dashoffset: 1.01;
    }
    to {
      stroke-dasharray: 1 1.02;
      stroke-dashoffset: 0;
    }
  }
  /* rayitas que crecen: cada tramo mide menos de 13 */
  @keyframes q-crecer {
    from {
      stroke-dasharray: 13 17;
      stroke-dashoffset: 15;
    }
    to {
      stroke-dasharray: 13 17;
      stroke-dashoffset: 0;
    }
  }
  @keyframes q-brotar {
    from {
      transform: scale(0);
    }
  }
  .maqueta .capa-costa {
    animation: q-trazo 1.1s cubic-bezier(0.5, 0, 0.3, 1) var(--i0) backwards;
  }
  .maqueta :is(.capa-mar, .capa-agua, .capa-orilla) {
    animation: q-tinta 1s ease-out var(--i1) backwards;
  }
  .maqueta .capa-cabo {
    animation: q-tinta 0.8s ease-out var(--i2) backwards;
  }
  .maqueta .capa-relieve {
    animation: q-crecer 0.8s ease-out calc(var(--i2) + 0.15s) backwards;
  }
  .maqueta .capa-campo {
    animation: q-tinta 0.9s ease-out calc(var(--i2) + 0.4s) backwards;
  }
  .maqueta .capa-ruta {
    animation: q-trazo 0.9s ease-in-out calc(var(--i2) + 0.3s) backwards;
  }
  .maqueta .semilla {
    transform-box: fill-box;
    transform-origin: center;
    animation: q-brotar 2.3s cubic-bezier(0.3, 0.1, 0.25, 1) var(--i3) backwards;
  }
  .maqueta .capa-aeropuerto {
    animation: q-tinta 0.7s ease-out calc(var(--i3) + 0.9s) backwards;
  }
  .maqueta :global(.maqueta-baliza) {
    animation: q-tinta 0.5s ease-out calc(var(--i2) + 0.6s) backwards;
  }
  .maqueta :global(.maqueta-torre) {
    animation: q-tinta 0.5s ease-out calc(var(--i3) + 0.2s) backwards;
  }
  .maqueta :global(.maqueta-mision) {
    animation: q-tinta 0.5s ease-out var(--i4) backwards;
  }
  @media (prefers-reduced-motion: reduce) {
    .maqueta,
    .maqueta :global(*) {
      animation: none !important;
    }
  }
</style>
