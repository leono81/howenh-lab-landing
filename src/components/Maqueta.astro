---
// Maqueta isométrica de la costa norte de Río Grande, en grabado de una tinta.
// La geometría llega ya proyectada desde scripts/maqueta.mjs (relieve levantado, lo oculto
// quitado); acá solo se le da estilo. Las únicas piezas que usan una matriz son las líneas
// de agua: el truco de trazos anchos tinta/papel necesita la planta, y como la costa corre
// casi recta el grosor de esas líneas prácticamente no cambia.
import m from '../data/maqueta.json';
import MaquetaMision from './MaquetaMision.astro';
import MaquetaTorre from './MaquetaTorre.astro';
import MaquetaBaliza from './MaquetaBaliza.astro';
const { capas: c, cabo, bloque, agua, fundidos: fu, franja, lugares } = m;
const lineasMar = [4, 9, 15, 22, 30, 39, 49, 60, 72].map((d, i, a) => ({ d, w: 1.2 - (i / a.length) * 0.6, o: 1 - (i / a.length) * 0.8 }));
const lineasChicas = [3, 7, 12, 18].map((d, i) => ({ d, w: 0.9, o: 1 - i * 0.2 }));
---
<svg class="maqueta" viewBox={`0 0 ${m.ancho} ${m.alto}`} aria-hidden="true">
  <defs>
    <clipPath id="q-franja"><rect x={franja.x} y={franja.y} width={franja.w} height={franja.h} /></clipPath>
    <clipPath id="q-mar"><path d={agua.mar} clip-path="url(#q-franja)" /></clipPath>
    <clipPath id="q-estuario"><path d={agua.estuario} clip-rule="evenodd" clip-path="url(#q-franja)" /></clipPath>
    <!-- el bloque se funde con el papel tierra adentro y hacia el oeste, pasando el cabo -->
    {Object.entries(fu).map(([k, g]) => (
      <>
        <linearGradient id={`q-g-${k}`} gradientUnits="userSpaceOnUse" x1={g.x1} y1={g.y1} x2={g.x2} y2={g.y2}>
          <stop offset="0" stop-color="#fff" />
          <stop offset="1" stop-color="#fff" stop-opacity="0" />
        </linearGradient>
        <mask id={`q-${k}`} maskUnits="userSpaceOnUse" x="0" y="0" width={m.ancho} height={m.alto}>
          <rect width={m.ancho} height={m.alto} fill={`url(#q-g-${k})`} />
        </mask>
      </>
    ))}
    <pattern id="q-rayado" width="2.5" height="2.5" patternUnits="userSpaceOnUse" patternTransform="rotate(30)">
      <line x1="0" y1="0" x2="2.5" y2="0" stroke="var(--tinta)" stroke-width="0.95" />
    </pattern>
    <pattern id="q-rayado-suave" width="3.6" height="3.6" patternUnits="userSpaceOnUse" patternTransform="rotate(-30)">
      <line x1="0" y1="0" x2="3.6" y2="0" stroke="var(--tinta-suave)" stroke-width="0.7" />
    </pattern>
    <pattern id="q-mallin" width="22" height="11" patternUnits="userSpaceOnUse">
      <path d="M2 8h9M6.5 8v-3.5M4.5 8l-1.5-2.5M8.5 8l1.5-2.5M13 3h7M16.5 3v-2.5" stroke="var(--tinta-suave)" stroke-width="0.7" fill="none" />
    </pattern>
    <pattern id="q-puntos" width="5" height="5" patternUnits="userSpaceOnUse">
      <circle cx="1.2" cy="1.2" r="0.55" fill="var(--tinta-suave)" />
      <circle cx="3.7" cy="3.7" r="0.45" fill="var(--tinta-suave)" />
    </pattern>
  </defs>

  <g mask="url(#q-oeste)">
    <!-- mar: líneas de agua paralelas a la costa -->
    <g transform={m.matriz}>
      <g clip-path="url(#q-mar)" fill="none" stroke-linejoin="round" stroke-linecap="round">
        {[...lineasMar].reverse().map((l) => (
          <>
            <path d={agua.costa} stroke="var(--tinta)" stroke-opacity={l.o} stroke-width={l.d * 2 + l.w} />
            <path d={agua.costa} stroke="var(--papel)" stroke-width={Math.max(0.1, l.d * 2 - l.w)} />
          </>
        ))}
      </g>
    </g>

    <g mask="url(#q-sesgo)"><g mask="url(#q-fondo)" fill="none" stroke-linecap="round" stroke-linejoin="round">
      <!-- playas, arenas y mallines de la boca -->
      <path d={c.playa} fill="url(#q-puntos)" />
      <path d={c.humedal} fill="url(#q-mallin)" fill-rule="evenodd" />

      <!-- estuario del río Grande -->
      <g transform={m.matriz}>
        <path d={agua.estuario} fill="var(--papel)" fill-rule="evenodd" clip-path="url(#q-franja)" />
        <g clip-path="url(#q-estuario)">
          {[...lineasChicas].reverse().map((l) => (
            <>
              <path d={agua.estuario} stroke="var(--tinta)" stroke-opacity={l.o} stroke-width={l.d * 2 + l.w} />
              <path d={agua.estuario} stroke="var(--papel)" stroke-width={l.d * 2 - l.w} />
            </>
          ))}
        </g>
      </g>
      <path d={c.rio} stroke="var(--tinta)" stroke-width="1.5" />
      <path d={c.arroyos} stroke="var(--tinta-suave)" stroke-width="0.7" />
      <path d={c.estuario} stroke="var(--tinta)" stroke-width="1.2" />

      <!-- relieve y estepa -->
      {c.hachures.map((g) => <path d={g.d} stroke-width={g.w} stroke={g.suave ? 'var(--tinta-suave)' : 'var(--tinta)'} />)}
      <path d={c.estepa} stroke="var(--tinta-suave)" stroke-width="0.5" />
      <path d={c.lagunas} stroke="var(--tinta)" stroke-width="1" />

      <!-- ciudad: manzanas rayadas, calles en blanco -->
      <path d={c.trama} stroke="url(#q-rayado)" stroke-width="9" />
      <path d={c.trama} stroke="var(--papel)" stroke-width="1.4" />
      <path d={c.avenidas} stroke="var(--papel)" stroke-width="2.6" />

      <!-- aeropuerto -->
      <path d={c.plataformas} fill="url(#q-rayado-suave)" stroke="var(--tinta)" stroke-width="0.7" />
      <path d={c.rodajes} stroke="var(--tinta)" stroke-width="1.3" />
      <path d={c.pista} stroke="var(--tinta)" stroke-width="4.6" stroke-linecap="butt" />
      <path d={c.pista} stroke="var(--papel)" stroke-width="0.6" stroke-dasharray="6 6" stroke-linecap="butt" />

      <!-- Ruta 3: doble línea -->
      <path d={c.ruta} stroke="var(--tinta)" stroke-width="3.2" />
      <path d={c.ruta} stroke="var(--papel)" stroke-width="1.7" />

      <!-- la costa -->
      <path d={c.costa} stroke="var(--tinta)" stroke-width="1.9" />
    </g></g>

    <!-- Cabo Domingo: las dos paredes (la del este y la que mira al mar) -->
    <g fill="none" stroke="var(--tinta)" stroke-linecap="round" stroke-linejoin="round">
      <path d={cabo.playa} stroke="var(--tinta-suave)" stroke-width="0.9" />
      <path d={cabo.cara} fill="var(--papel)" stroke="none" />
      <path d={cabo.carcavasFinas} stroke-width="0.4" />
      <path d={cabo.sombra} stroke-width="0.55" />
      <path d={cabo.carcavas} stroke-width="0.8" />
      <path d={cabo.alero} stroke-width="0.55" />
      <path d={cabo.capas} stroke-width="0.6" />
      <path d={cabo.grietas} stroke-width="0.5" />
      <path d={cabo.base} stroke-width="1.1" />
      <path d={cabo.pie} stroke-width="0.7" />
      <path d={cabo.filo} stroke-width="1.5" />
    </g>

    <!-- el zócalo del bloque del lado del mar -->
    <g fill="none" stroke="var(--tinta)" stroke-linecap="round" stroke-linejoin="round">
      <path d={bloque.frente} fill="var(--papel)" stroke="none" />
      <path d={bloque.estratosFrente} stroke="var(--tinta-suave)" stroke-width="0.6" />
      <path d={bloque.borde} stroke-width="1.1" />
    </g>
  </g>

  <!-- el corte este del bloque, pasando la boca del río -->
  <g mask="url(#q-fondo)" fill="none" stroke="var(--tinta)" stroke-linecap="round" stroke-linejoin="round">
    <path d={bloque.corte} fill="var(--papel)" stroke="none" />
    <path d={bloque.estratos} stroke="var(--tinta-suave)" stroke-width="0.6" />
    <path d={bloque.perfil} stroke-width="1.3" />
  </g>

  <!-- viñetas, en los mismos ejes -->
  <MaquetaMision x={lugares.mision[0]} y={lugares.mision[1]} escala={1.45} />
  <MaquetaTorre x={lugares.torre[0]} y={lugares.torre[1]} escala={1.75} />
  <MaquetaBaliza x={lugares.baliza[0]} y={lugares.baliza[1]} escala={2.1} />
</svg>

<style>
  .maqueta {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
