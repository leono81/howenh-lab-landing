---
// Productos: Kenos con su lugar propio (es el más robusto y el de otro rubro, Leono 2026-11-10) y,
// después, los de facturación con cómo se conectan (Teken es el motor y no se ofrece al público:
// aparece solo en el diagrama). Tari queda afuera hasta que esté en producción.
import { iso, pol, lin, rayas } from '../data/iso';

// Kenos: CENIT no se nombra hasta que Leono lo confirme (PRODUCT.md)
const NOMBRAR_CLIENTE = false;
const kenosEnUso = NOMBRAR_CLIENTE
  ? 'Lo usan profesionales con su suscripción y CENIT, un centro de kinesiología de Buenos Aires con tres sedes, donde lo implementamos en persona.'
  : 'Lo usan profesionales con su suscripción y un centro de kinesiología de Buenos Aires con tres sedes, donde lo implementamos en persona.';
// sin «facturación electrónica» ni «envío de la presentación»: Kenos todavía no los hace (assets/sistema/marcas/kenos.md)
const kenosHace = ['Turnos y agenda por profesional', 'Pacientes e historia', 'Órdenes y sesiones', 'Liquidación a obras sociales y prepagas'];

// la viñeta de Kenos: la agenda de la semana como un rompecabezas, en los ejes isométricos (x, las
// horas; y, los días). Cada casilla es una pieza que cae y encaja hasta que la semana queda armada;
// las rayadas son los turnos tomados.
const CEL = 13, HORAS = 8, DIAS = 5, GROSOR = 3;
const X = HORAS * CEL, Y = DIAS * CEL;
const tomados = [[0, 0], [0, 1], [0, 3], [1, 1], [1, 2], [2, 0], [2, 4], [3, 2], [3, 3], [4, 1], [4, 4], [5, 0], [5, 2], [6, 3], [6, 4], [7, 1]];
const tabla = {
  techo: pol(iso(0, 0), iso(X, 0), iso(X, Y), iso(0, Y)),
  frente: pol(iso(0, 0), iso(X, 0), iso(X, 0, -GROSOR), iso(0, 0, -GROSOR)),
  lado: pol(iso(X, 0), iso(X, Y), iso(X, Y, -GROSOR), iso(X, 0, -GROSOR)),
  sombra: rayas(iso(X, 0), iso(X, 0, -GROSOR), iso(X, Y), iso(X, Y, -GROSOR), 9),
  casillas: Array.from({ length: HORAS - 1 }, (_, h) => lin(iso((h + 1) * CEL, 0), iso((h + 1) * CEL, Y))).join('') + Array.from({ length: DIAS - 1 }, (_, d) => lin(iso(0, (d + 1) * CEL), iso(X, (d + 1) * CEL))).join(''),
};
// en cada borde entre dos piezas, una lleva la lengüeta y la otra el hueco (al azar, pero fijo)
let semilla = 11;
const azar = () => (semilla = (semilla * 16807) % 2147483647) / 2147483647;
const entreHoras = Array.from({ length: HORAS - 1 }, () => Array.from({ length: DIAS }, () => (azar() < 0.5 ? 1 : -1))); // +1: la lengüeta va hacia la hora siguiente
const entreDias = Array.from({ length: HORAS }, () => Array.from({ length: DIAS - 1 }, () => (azar() < 0.5 ? 1 : -1))); // +1: hacia el día siguiente
// un borde de A a B con su lengüeta: s = 1 sale (hacia n), s = -1 entra, 0 es recto
const MEDIO = 1.56, FONDO = 1.7, R = Math.hypot(MEDIO, FONDO);
const borde = (a: number[], b: number[], n: number[], s: number) => {
  if (!s) return [a];
  const u = [(b[0] - a[0]) / CEL, (b[1] - a[1]) / CEL];
  const m = [(a[0] + b[0]) / 2, (a[1] + b[1]) / 2];
  const q = [m[0] + s * n[0] * FONDO, m[1] + s * n[1] * FONDO];
  const a1 = Math.atan2(-FONDO, -MEDIO);
  const arco = Array.from({ length: 11 }, (_, i) => {
    const ang = a1 - (i / 10) * ((265 * Math.PI) / 180);
    return [q[0] + R * Math.cos(ang) * u[0] + R * Math.sin(ang) * s * n[0], q[1] + R * Math.cos(ang) * u[1] + R * Math.sin(ang) * s * n[1]];
  });
  return [a, ...arco];
};
// una pieza en coordenadas de la agenda: su contorno y, si es un turno tomado, su rayado
const pieza = (h: number, d: number) => {
  const [x0, x1, y0, y1] = [h * CEL, (h + 1) * CEL, d * CEL, (d + 1) * CEL];
  const contorno = [
    ...borde([x0, y0], [x1, y0], [0, -1], d > 0 ? -entreDias[h][d - 1] : 0),
    ...borde([x1, y0], [x1, y1], [1, 0], h < HORAS - 1 ? entreHoras[h][d] : 0),
    ...borde([x1, y1], [x0, y1], [0, 1], d < DIAS - 1 ? entreDias[h][d] : 0),
    ...borde([x0, y1], [x0, y0], [-1, 0], h > 0 ? -entreHoras[h - 1][d] : 0),
  ];
  const tomado = tomados.some(([a, b]) => a === h && b === d);
  const t = 3; // el rayado, adentro, lejos de las lengüetas
  const raya = tomado ? [1, 2, 3].map((k) => [[x0 + t + (k * (CEL - 2 * t)) / 4, y0 + t], [x0 + t + (k * (CEL - 2 * t)) / 4, y1 - t]]) : [];
  return { contorno, raya, tomado, centro: [(x0 + x1) / 2, (y0 + y1) / 2] };
};
// las piezas esperan al lado de la agenda, del lado de las horas de la tarde: amontonadas,
// mezcladas y giradas. De ahí sale cada una, se levanta un poco y va a su casilla.
const MONTON = { x0: X + 10, x1: X + 46, y0: -4, y1: Y + 4 };
const ubicar = (pts: number[][], de: number[], a: number[], giro: number) => {
  const [c, s] = [Math.cos(giro), Math.sin(giro)];
  return pts.map(([x, y]) => {
    const [dx, dy] = [x - de[0], y - de[1]];
    return [a[0] + dx * c - dy * s, a[1] + dx * s + dy * c];
  });
};
const proyectar = (pts: number[][]) => pts.map(([x, y]) => iso(x, y));
const trazos = (segs: number[][][], z = 0) => segs.map(([a, b]) => lin(iso(a[0], a[1], z), iso(b[0], b[1], z))).join('');
// el segundo acto: armada la semana, los turnos tomados se marcan atendidos y pasan, de a uno, a la
// presentación para las obras sociales y prepagas: un lote prolijo delante de la agenda
const LOTE = { x: 52, y: -66 }, CAPA = 1.3;
const ARMADO = 24; // segundos: se arma, se atiende, se presenta, y vuelve a empezar
const ATENDIDO = 9.3 / ARMADO;
const tilde = (c: number[]) => [[c[0] - 3.4, c[1] + 0.4], [c[0] - 1.1, c[1] + 2.9], [c[0] + 3.8, c[1] - 3.2]];
let enLote = 0;
const piezas = Array.from({ length: HORAS * DIAS }, (_, i) => pieza(i % HORAS, Math.floor(i / HORAS)))
  .map((p) => ({ p, orden: azar() }))
  .sort((a, b) => a.orden - b.orden)
  .map(({ p }, i) => {
    const lugar = [MONTON.x0 + azar() * (MONTON.x1 - MONTON.x0), MONTON.y0 + azar() * (MONTON.y1 - MONTON.y0)];
    const giro = (azar() - 0.5) * 2.2;
    const enMonton = ubicar(p.contorno, p.centro, lugar, giro);
    const rayaMonton = p.raya.map((seg) => ubicar(seg, p.centro, lugar, giro));
    const a = (0.8 + i * 0.17) / ARMADO;
    // los tomados, en el orden en que llegaron, se apilan en el lote: cada uno un poco más arriba
    const j = p.tomado ? enLote++ : 0;
    const z = j * CAPA;
    const L = (10.8 + j * 0.28) / ARMADO;
    const enElLote = ubicar(p.contorno, p.centro, [LOTE.x, LOTE.y], 0);
    return {
      tomado: p.tomado,
      monton: pol(...proyectar(enMonton)),
      casilla: pol(...proyectar(p.contorno)),
      lote: pol(...enElLote.map(([x, y]) => iso(x, y, z))),
      rayaMonton: trazos(rayaMonton),
      rayaCasilla: trazos(p.raya),
      rayaLote: trazos(p.raya.map((seg) => ubicar(seg, p.centro, [LOTE.x, LOTE.y], 0)), z),
      tildeCasilla: lin(...tilde(p.centro).map(([x, y]) => iso(x, y))),
      tildeLote: lin(...tilde([LOTE.x, LOTE.y]).map(([x, y]) => iso(x, y, z))),
      a,
      b: a + 0.7 / ARMADO,
      L,
      Lb: L + 0.7 / ARMADO,
    };
  })
  // la que sale primero va arriba de todo, así no pasa por debajo del montón
  .reverse();
const k3 = (v: number) => v.toFixed(3);
// el marco del dibujo: la agenda con sus rótulos (a la derecha) y el montón (abajo a la izquierda)
const bordes = [iso(0, 0), iso(X, 0), iso(X, Y), iso(0, Y), iso(MONTON.x1 + 9, MONTON.y0 - 9), iso(MONTON.x1 + 9, MONTON.y1 + 9), iso(MONTON.x0 - 9, MONTON.y1 + 9), iso(LOTE.x + 16, LOTE.y - 22), iso(LOTE.x - 30, LOTE.y - 22), iso(LOTE.x + 10, LOTE.y + 8, 24)];
// el rótulo del lote, impreso en el plano, delante de la pila
const PRIMER_LOTE = (10.8 + 0.7) / ARMADO;
const VB = (() => {
  const xs = bordes.map((p) => p[0]), ys = bordes.map((p) => p[1]);
  const [x0, x1, y0, y1] = [Math.min(...xs) - 6, Math.max(...xs) + 30, Math.min(...ys) - 30, Math.max(...ys) + 22];
  return { x: Math.round(x0), y: Math.round(y0), w: Math.round(x1 - x0), h: Math.round(y1 - y0) };
})();

// la letra de la agenda, impresa sobre su mismo plano: los días a lo largo del borde derecho, las
// horas a lo largo del borde de adelante. Cada matriz lleva el eje x del texto y su "abajo" a los
// ejes de la agenda, sin espejarlo (los dos determinantes son positivos).
const C = Math.cos(Math.PI / 6), S = 0.5, ALTO_LETRA = 2.6;
const DIAS_NOMBRE = ['lunes', 'martes', 'miércoles', 'jueves', 'viernes'];
const PRIMERA_HORA = 8;
const r1 = (v: number) => Math.round(v * 10) / 10;
// el texto corre hacia afuera del borde x = 0 (arriba a la derecha) y su "abajo" va hacia -y
const enDias = ([px, py]: number[]) => `matrix(${r1(C)} ${-S} ${r1(C)} ${S} ${r1(px)} ${r1(py)})`;
// el texto corre hacia afuera del borde y = 0 (abajo a la derecha) y su "abajo" va hacia +x
const enHoras = ([px, py]: number[]) => `matrix(${r1(C)} ${S} ${r1(-C)} ${S} ${r1(px)} ${r1(py)})`;
const dias = DIAS_NOMBRE.map((t, d) => ({ t: t.slice(0, 3).toUpperCase().replace('MIE', 'MIÉ'), m: enDias(iso(-4.5, d * CEL + CEL / 2 - ALTO_LETRA / 2)) }));
const horas = Array.from({ length: HORAS }, (_, h) => ({ t: `${String(PRIMERA_HORA + h).padStart(2, '0')}:00`, m: enHoras(iso(h * CEL + CEL / 2 + ALTO_LETRA / 2, -5)) }));

// el símbolo de la medicina como lo pidió Leono (2026-11-10): el caduceo, la vara con dos serpientes
// enroscadas y alas arriba. Grabado como la antena de la estación: en los ejes isométricos, la vara es
// un cilindro con su lado a la sombra rayado, cada serpiente una cinta con borde de tinta, y lo que
// queda detrás de la vara se dibuja antes. Las alas van en el plano que mira a quien mira.
const VARA = { r: 1.7, alto: 66 };
const varaLados = lin(iso(VARA.r, -VARA.r, 0), iso(VARA.r, -VARA.r, VARA.alto)) + lin(iso(-VARA.r, VARA.r, 0), iso(-VARA.r, VARA.r, VARA.alto));
const varaSombra = rayas(iso(0, 0, 0), iso(0, 0, VARA.alto), iso(-VARA.r, VARA.r, 0), iso(-VARA.r, VARA.r, VARA.alto), 4);
const varaTope = iso(0, 0, VARA.alto + 2.2);
// las dos serpientes: la misma hélice, media vuelta corridas, así se cruzan adelante y atrás
const serpienteEn = (fase: number) => {
  const pts = Array.from({ length: 121 }, (_, i) => {
    const t = i / 120, a = fase + Math.PI * 4.5 * t;
    return [5.4 * Math.cos(a), 5.4 * Math.sin(a), 5 + 46 * t] as [number, number, number];
  });
  // la cabeza: sube un poco más y mira hacia la vara, enfrentada con la otra
  const [x, y] = pts[pts.length - 1];
  pts.push([x * 0.85, y * 0.85, 54.5], [x * 0.5, y * 0.5, 57]);
  return pts;
};
// en tramos de adelante (x − y > 0, la cara que mira a quien mira) y de atrás, en orden, para dibujarla subiendo
const enTramos = (pts: [number, number, number][]) => {
  const tramos: { d: string; adelante: boolean; k: number }[] = [];
  let actual = [pts[0]], lado = pts[0][0] - pts[0][1] > 0;
  for (const p of pts.slice(1)) {
    const l = p[0] - p[1] > 0;
    actual.push(p);
    if (l !== lado) {
      tramos.push({ d: lin(...actual.map((q) => iso(...q))), adelante: lado, k: tramos.length });
      (actual = [p]), (lado = l);
    }
  }
  tramos.push({ d: lin(...actual.map((q) => iso(...q))), adelante: lado, k: tramos.length });
  return tramos;
};
const serpientes = [Math.PI / 4, Math.PI / 4 + Math.PI].map((fase) => serpienteEn(fase));
const tramosSerpientes = serpientes.flatMap((sp) => enTramos(sp));
const cabezas = serpientes.map((sp) => iso(...sp[sp.length - 1]));
// las alas: en el plano de la vara que mira de frente (la dirección (1, 1, 0) es la horizontal de la pantalla)
const enAla = (u: number, z: number) => iso(u / Math.SQRT2, u / Math.SQRT2, z);
const ala = (lado: number) => {
  const q = (u: number, z: number) => enAla(lado * u, z).map((v) => +v.toFixed(2)).join(' ');
  // el borde de arriba sube desde la vara y se abre hasta la punta; el de abajo son cuatro plumas
  const borde =
    `M${q(2, 61)}C${q(6, 70)} ${q(13, 76)} ${q(24, 77)}` +
    `Q${q(26.5, 73)} ${q(21, 70)}Q${q(20.5, 67.2)} ${q(16, 66.5)}Q${q(15.2, 63.6)} ${q(11, 63.5)}Q${q(10, 61)} ${q(6, 61.4)}Q${q(4, 60.3)} ${q(2, 60)}Z`;
  const plumas = `M${q(21, 70)}L${q(14.5, 72.6)}M${q(16, 66.5)}L${q(10.5, 69.2)}M${q(11, 63.5)}L${q(6.8, 65.6)}`;
  return { borde, plumas };
};
const alas = [ala(1), ala(-1)];

// yon.com.ar existe pero todavía no tiene landing: se enlaza cuando la tenga
const productos = [
  {
    nombre: 'Hown',
    para: 'Quien factura sin mostrador: oficios y servicios',
    texto: 'Un bot de Telegram: le mandás un audio o un texto y te devuelve la factura de ARCA (A, B o C) con su PDF.',
    sitio: ['hown.howenh-labs.com', 'https://hown.howenh-labs.com/'],
  },
  {
    nombre: 'Yon',
    para: 'Comercios de mostrador',
    texto: 'Vende, cobra y factura en el mismo toque; lleva el stock y los clientes, y sigue vendiendo sin señal: factura cuando vuelve la conexión.',
  },
  {
    nombre: 'Kaux',
    para: 'Estudios contables',
    texto: 'Arma los archivos de ARCA para la carga masiva (Libro IVA Digital, sueldos) y controla los vencimientos.',
  },
];

// ---------- el diagrama: una carta de rutas, en dos disposiciones (ancha y angosta) ----------
type N = [number, number];
type Rotulo = { t: string; en: N; ancla: 'arriba' | 'abajo' | 'derecha' | 'izquierda'; tipo: 'nombre' | 'nota' | 'ruta' };
const curva = (a: N, b: N, vertical: boolean) => {
  if (vertical) {
    const m = (b[1] - a[1]) / 2;
    return `M${a[0]} ${a[1]}C${a[0]} ${a[1] + m} ${b[0]} ${b[1] - m} ${b[0]} ${b[1]}`;
  }
  const m = (b[0] - a[0]) / 2;
  return `M${a[0]} ${a[1]}C${a[0] + m} ${a[1]} ${b[0] - m} ${b[1]} ${b[0]} ${b[1]}`;
};
const disposiciones = [
  {
    clave: 'ancho',
    vb: [1000, 400],
    vertical: false,
    nodos: { hown: [120, 110], yon: [120, 300], teken: [520, 205], arca: [880, 110], kaux: [880, 300] } as Record<string, N>,
    rutas: {
      hown: [[134, 110], [504, 199]],
      yon: [[134, 300], [504, 211]],
      ida: [[536, 198], [866, 104]],
      vuelta: [[866, 116], [536, 210]],
      kaux: [[532, 219], [866, 300]],
    } as Record<string, [N, N]>,
    rotulos: [
      { t: 'Hown', en: [120, 90], ancla: 'arriba', tipo: 'nombre' },
      { t: 'bot de Telegram', en: [120, 128], ancla: 'abajo', tipo: 'nota' },
      { t: 'Yon', en: [120, 280], ancla: 'arriba', tipo: 'nombre' },
      { t: 'app de mostrador', en: [120, 318], ancla: 'abajo', tipo: 'nota' },
      { t: 'Teken', en: [520, 166], ancla: 'arriba', tipo: 'nombre' },
      { t: 'el motor', en: [520, 186], ancla: 'arriba', tipo: 'nota' },
      { t: 'ARCA', en: [880, 68], ancla: 'arriba', tipo: 'nombre' },
      { t: 'factura electrónica', en: [880, 92], ancla: 'arriba', tipo: 'nota' },
      { t: 'Kaux', en: [880, 258], ancla: 'arriba', tipo: 'nombre' },
      { t: 'estudio contable', en: [880, 282], ancla: 'arriba', tipo: 'nota' },
      { t: 'comprobante', en: [622, 176], ancla: 'arriba', tipo: 'ruta' },
      { t: 'CAE', en: [836, 124], ancla: 'abajo', tipo: 'ruta' },
      { t: 'venta, en vivo', en: [784, 308], ancla: 'abajo', tipo: 'ruta' },
    ] as Rotulo[],
  },
  {
    clave: 'alto',
    vb: [400, 660],
    vertical: true,
    nodos: { hown: [90, 90], yon: [310, 90], teken: [200, 330], arca: [90, 570], kaux: [310, 570] } as Record<string, N>,
    rutas: {
      hown: [[90, 104], [193, 316]],
      yon: [[310, 104], [207, 316]],
      ida: [[194, 346], [96, 556]],
      vuelta: [[84, 556], [184, 346]],
      kaux: [[212, 346], [310, 556]],
    } as Record<string, [N, N]>,
    rotulos: [
      { t: 'Hown', en: [90, 46], ancla: 'arriba', tipo: 'nombre' },
      { t: 'bot de Telegram', en: [90, 74], ancla: 'arriba', tipo: 'nota' },
      { t: 'Yon', en: [310, 46], ancla: 'arriba', tipo: 'nombre' },
      { t: 'app de mostrador', en: [310, 74], ancla: 'arriba', tipo: 'nota' },
      { t: 'Teken', en: [226, 318], ancla: 'derecha', tipo: 'nombre' },
      { t: 'el motor', en: [226, 344], ancla: 'derecha', tipo: 'nota' },
      { t: 'ARCA', en: [90, 588], ancla: 'abajo', tipo: 'nombre' },
      { t: 'factura electrónica', en: [90, 620], ancla: 'abajo', tipo: 'nota' },
      { t: 'Kaux', en: [310, 588], ancla: 'abajo', tipo: 'nombre' },
      { t: 'estudio contable', en: [310, 620], ancla: 'abajo', tipo: 'nota' },
      { t: 'comprobante', en: [106, 478], ancla: 'izquierda', tipo: 'ruta' },
      { t: 'CAE', en: [118, 440], ancla: 'izquierda', tipo: 'ruta' },
      { t: 'venta, en vivo', en: [270, 452], ancla: 'derecha', tipo: 'ruta' },
    ] as Rotulo[],
  },
];
// el recorrido de un comprobante, en un ciclo de 20 s: sale de Hown, va por Teken a ARCA, vuelve
// con el CAE, la factura llega al comercio y la venta al estudio contable. Después, lo mismo desde Yon.
const CICLO = 20;
const tramos = (canal: string, t: number) => [
  { ruta: canal, ida: true, a: t, b: t + 0.08 },
  { ruta: 'ida', ida: true, a: t + 0.09, b: t + 0.16 },
  { ruta: 'vuelta', ida: true, a: t + 0.19, b: t + 0.26 },
  { ruta: canal, ida: false, a: t + 0.27, b: t + 0.35 },
  { ruta: 'kaux', ida: true, a: t + 0.27, b: t + 0.36 },
];
const viaje = [...tramos('hown', 0), ...tramos('yon', 0.5)];
const pct = (vb: number[], [x, y]: N) => `left:${((x / vb[0]) * 100).toFixed(2)}%;top:${((y / vb[1]) * 100).toFixed(2)}%`;
const k = (v: number) => v.toFixed(3);
---
<section class="seccion productos" id="productos" aria-labelledby="prod-titulo">
  <h2 id="prod-titulo">Nuestras plataformas</h2>
  <p class="entrada">Además de los proyectos para el territorio, Howenh crea sus propios SaaS: los diseñamos, los programamos y los mantenemos seguros.</p>

  <article class="kenos" aria-labelledby="kenos-titulo">
    <div class="kenos-texto">
      <div class="kenos-cabeza">
        <h3 id="kenos-titulo"><img class="logo-kenos" src="/kenos-logo-tinta.png" alt="Kenos" width="603" height="514" /></h3>
        <!-- el caduceo, el símbolo de la medicina: se traza solo cuando llega a la pantalla, primero la
             vara, después las dos serpientes que suben enroscándose, y al final se abren las alas -->
        <svg class="asclepio" viewBox="-34 -84 68 90" aria-hidden="true">
          <g class="alas">
            {alas.map((a) => (
              <>
                <path class="ala" d={a.borde} pathLength="1" />
                <path class="pluma" d={a.plumas} />
              </>
            ))}
          </g>
          {tramosSerpientes.map((t) => !t.adelante && (
            <g style={`--k: ${t.k}`}>
              <path class="cinta-borde" d={t.d} pathLength="1" />
              <path class="cinta" d={t.d} pathLength="1" />
            </g>
          ))}
          <g class="vara">
            <path d={varaLados} pathLength="1" />
            <path class="vara-sombra" d={varaSombra} />
            <circle cx={varaTope[0]} cy={varaTope[1]} r="2.4" />
