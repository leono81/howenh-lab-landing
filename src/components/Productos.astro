  <figure class="ecosistema">
    {
      disposiciones.map((d) => (
        <div class={`carta carta-${d.clave}`}>
          <svg viewBox={`0 0 ${d.vb[0]} ${d.vb[1]}`} aria-hidden="true" data-vive data-quieto="2.4">
            <defs>
              {Object.entries(d.rutas).map(([n, [a, b]]) => (
                <path id={`e-${d.clave}-${n}`} d={curva(a, b, d.vertical)} />
              ))}
            </defs>
            <g fill="none" stroke="var(--tinta)" stroke-width="1" stroke-linecap="round">
              {Object.keys(d.rutas).map((n) => (
                <use href={`#e-${d.clave}-${n}`} stroke-dasharray={n === 'kaux' ? '4 4' : undefined} />
              ))}
            </g>
            <g stroke="var(--tinta)" stroke-width="1.2">
              {['hown', 'yon', 'kaux'].map((n) => (
                <rect x={d.nodos[n][0] - 6} y={d.nodos[n][1] - 6} width="12" height="12" fill="var(--papel)" />
              ))}
              <rect x={d.nodos.teken[0] - 13} y={d.nodos.teken[1] - 13} width="26" height="26" fill="var(--papel)" />
              <rect x={d.nodos.teken[0] - 6} y={d.nodos.teken[1] - 6} width="12" height="12" fill="var(--tinta)" />
              <rect x={d.nodos.arca[0] - 6} y={d.nodos.arca[1] - 6} width="12" height="12" fill="var(--papel)" stroke="var(--tinta-suave)" stroke-dasharray="2 2" />
            </g>
            {viaje.map((v) => (
              <g opacity="0">
                <path d="M0 -4.5L4.5 0L0 4.5L-4.5 0Z" fill="var(--acento)" />
                <animateMotion dur={`${CICLO}s`} repeatCount="indefinite" calcMode="linear" keyPoints={v.ida ? '0;0;1;1' : '1;1;0;0'} keyTimes={`0;${k(v.a)};${k(v.b)};1`}>
                  <mpath href={`#e-${d.clave}-${v.ruta}`} />
                </animateMotion>
                <animate attributeName="opacity" values="0;1;0" keyTimes={`0;${k(v.a)};${k(v.b)}`} calcMode="discrete" dur={`${CICLO}s`} repeatCount="indefinite" />
              </g>
            ))}
          </svg>
          {d.rotulos.map((r) => (
            <span class={`e e-${r.tipo} a-${r.ancla}`} style={pct(d.vb, r.en)}>
              {r.t}
            </span>
          ))}
        </div>
      ))
    }
    <figcaption>
      Hown y Yon emiten cada comprobante a través de Teken, el motor que habla con ARCA. Si el comercio trabaja con un estudio que usa Kaux, la venta puede llegar sola a su Libro IVA.
    </figcaption>
  </figure>
</section>

<script>
  // Kenos, cuando llega a la pantalla: la vara de Asclepio se traza una vez, y lo que hace aparece
  // de a poco, al ritmo del rompecabezas (el reloj del svg de la agenda, que corre solo en pantalla).
  // Sin JS o con movimiento reducido, todo está a la vista desde el principio.
  const kenos = document.querySelector<HTMLElement>('.kenos');
  const agenda = kenos?.querySelector<SVGSVGElement>('.agenda');
  if (kenos && agenda && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const items = [...kenos.querySelectorAll<HTMLElement>('.hace li')];
    const CICLO = 24, DESARMA = 0.9 * CICLO;
    let cuadro = 0, visible = false;
    const seguir = () => {
      cuadro = 0;
      const t = agenda.getCurrentTime() % CICLO;
      items.forEach((li) => li.toggleAttribute('data-ve', t >= +li.dataset.desde! && t < DESARMA));
      if (visible) cuadro = requestAnimationFrame(seguir);
    };
    kenos.classList.add('espera', 'al-ritmo');
    new IntersectionObserver(
      ([v]) => {
        visible = v.isIntersecting;
        if (visible) {
          kenos.classList.replace('espera', 'llega');
          cuadro ||= requestAnimationFrame(seguir);
        }
      },
      { threshold: 0.3 },
    ).observe(kenos);
  }
</script>

