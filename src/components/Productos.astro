        </svg>
      </div>
      <p class="que">Para profesionales y centros de salud.</p>
      <p>Turnos, pacientes y la administración del consultorio, con las obras sociales y las prepagas, en un solo sistema.</p>
      <p class="sitio-kenos"><a href="https://www.kenos.app/" target="_blank" rel="noopener">kenos.app ↗</a></p>
    </div>
    <figure class="agenda-lamina">
      <!-- lo que hace Kenos, al lado del rompecabezas: cada cosa aparece cuando la animación la muestra -->
      <ul class="hace">
        {kenosHace.map((h, i) => <li data-desde={[1, 4.5, 9.4, 11.6][i]}>{h}</li>)}
      </ul>
    <svg class="agenda" viewBox={`${VB.x} ${VB.y} ${VB.w} ${VB.h}`} role="img" aria-label="La agenda de la semana, de lunes a viernes y de 8 a 15, dibujada en perspectiva como un rompecabezas que se arma pieza por pieza" data-vive data-quieto="12">
      <g stroke="var(--tinta)" stroke-linejoin="round">
        <path d={tabla.frente} fill="var(--papel)" stroke-width="0.35" />
        <path d={tabla.lado} fill="var(--papel)" stroke-width="0.35" />
        <path d={tabla.sombra} stroke-width="0.2" />
        <path d={tabla.techo} fill="var(--aguada-tierra)" stroke-width="0.4" />
      </g>
      <!-- las casillas vacías, apenas marcadas, esperando su pieza -->
      <path d={tabla.casillas} fill="none" stroke="var(--tinta-suave)" stroke-width="0.2" stroke-dasharray="1 1.4" />
      <!-- las piezas: salen del montón de al lado, de a una, y encajan en su día y su hora -->
      <g stroke-linejoin="round">
        {
          piezas.map((p) => {
            // los libres: montón → casilla; los tomados siguen: casilla → lote
            const forma = p.tomado ? [p.monton, p.monton, p.casilla, p.casilla, p.lote, p.lote, p.monton, p.monton] : [p.monton, p.monton, p.casilla, p.casilla, p.monton, p.monton];
            const tiempos = p.tomado ? [0, p.a, p.b, p.L, p.Lb, 0.94, 0.941, 1] : [0, p.a, p.b, 0.94, 0.941, 1];
            const curvas = Array.from({ length: forma.length - 1 }, (_, k) => (k === 1 || (p.tomado && k === 3) ? '0.45 0 0.25 1' : '0 0 1 1')).join(';');
            const kt = tiempos.map(k3).join(';');
            const rayas = p.tomado ? [p.rayaMonton, p.rayaMonton, p.rayaCasilla, p.rayaCasilla, p.rayaLote, p.rayaLote, p.rayaMonton, p.rayaMonton] : [];
            const salto = p.tomado ? { v: '0 0;0 0;0 -9;0 0;0 0;0 -9;0 0;0 0', k: [0, p.a, (p.a + p.b) / 2, p.b, p.L, (p.L + p.Lb) / 2, p.Lb, 1] } : { v: '0 0;0 0;0 -9;0 0;0 0', k: [0, p.a, (p.a + p.b) / 2, p.b, 1] };
            return (
              <g>
                <path d={p.casilla} fill="var(--papel)" stroke={p.tomado ? 'var(--tinta)' : 'var(--tinta-suave)'} stroke-width={p.tomado ? 0.32 : 0.26}>
                  <animate attributeName="d" values={forma.join(';')} keyTimes={kt} calcMode="spline" keySplines={curvas} dur={`${ARMADO}s`} repeatCount="indefinite" />
                </path>
                {p.tomado && (
                  <path d={p.rayaCasilla} fill="none" stroke="var(--tinta-suave)" stroke-width="0.22">
                    <animate attributeName="d" values={rayas.join(';')} keyTimes={kt} calcMode="spline" keySplines={curvas} dur={`${ARMADO}s`} repeatCount="indefinite" />
                    {/* cuando se atiende, el rayado de «tomado» deja lugar al tilde */}
                    <animate attributeName="opacity" values="1;1;0;0;1" keyTimes={`0;${k3(ATENDIDO)};${k3(ATENDIDO + 0.01)};0.95;1`} dur={`${ARMADO}s`} repeatCount="indefinite" />
                  </path>
                )}
                {/* atendido: un tilde, y con él viaja al lote */}
                {p.tomado && (
                  <path d={p.tildeCasilla} fill="none" stroke="var(--tinta)" stroke-width="0.7" stroke-linecap="round" stroke-linejoin="round" opacity="0">
                    <animate attributeName="d" values={`${p.tildeCasilla};${p.tildeCasilla};${p.tildeLote};${p.tildeLote}`} keyTimes={`0;${k3(p.L)};${k3(p.Lb)};1`} dur={`${ARMADO}s`} repeatCount="indefinite" />
                    <animate attributeName="opacity" values="0;0;1;1;0;0" keyTimes={`0;${k3(ATENDIDO)};${k3(ATENDIDO + 0.01)};0.9;0.935;1`} dur={`${ARMADO}s`} repeatCount="indefinite" />
                  </path>
                )}
                <!-- en el camino se levanta un poco: va por arriba de la agenda -->
                <animateTransform attributeName="transform" type="translate" values={salto.v} keyTimes={salto.k.map(k3).join(';')} dur={`${ARMADO}s`} repeatCount="indefinite" />
                <!-- al final se desarma: se apaga y el montón vuelve a aparecer -->
                <animate attributeName="opacity" values="1;1;0;0;1" keyTimes="0;0.9;0.935;0.95;1" dur={`${ARMADO}s`} repeatCount="indefinite" />
              </g>
            );
          })
        }
      </g>
      <!-- el rótulo del lote: aparece cuando llega el primer turno atendido -->
      <g class="letra-agenda letra-lote" opacity="0">
        <text transform={enDias(iso(LOTE.x + 10, LOTE.y - 15))}>PRESENTACIÓN</text>
        <text transform={enDias(iso(LOTE.x + 10, LOTE.y - 19.5))}>OBRAS SOCIALES Y PREPAGAS</text>
        <animate attributeName="opacity" values="0;0;1;1;0;0" keyTimes={`0;${k3(PRIMER_LOTE)};${k3(PRIMER_LOTE + 0.02)};0.9;0.935;1`} dur={`${ARMADO}s`} repeatCount="indefinite" />
      </g>
      <!-- los días y las horas, sobre el plano de la agenda -->
      <g class="letra-agenda">
        {dias.map((d) => <text transform={d.m}>{d.t}</text>)}
        {horas.map((h) => <text transform={h.m}>{h.t}</text>)}
      </g>
    </svg>
    <figcaption>{kenosEnUso}</figcaption>
    </figure>
  </article>

