---
// Opción A · «Maqueta a sangre». La maqueta isométrica es la gran imagen del hero: se va a
// sangre por la derecha (pasando el cabo), por abajo (la esquina del bloque) y, cuando el ancho
// alcanza, por la izquierda (la ciudad); el texto vive en el papel de arriba a la izquierda y
// el resto es mar abierto.
// Encima de la maqueta, sin tocarla, van tres piezas que se mueven: el destello de la
// linterna, el haz que barre el mar y un barco que llega a la boca del río.
// Todo se ubica en unidades de la maqueta: --u es cuántos px mide una unidad.
import Maqueta from './Maqueta.astro';
import m from '../data/maqueta.json';
import { iso, pol, lin } from '../data/iso';
const agenda = 'https://calendar.app.google/ucnmS77YVC4ax2TE9';

// la linterna: el pie de la baliza está en lugares.baliza y MaquetaBaliza la dibuja a escala 2.1,
// con la linterna entre 9,2 y 11,2 m
const [bx, by] = m.lugares.baliza;
const luz = { x: bx, y: by - 10.2 * 2.1 };

// haz: abanico de rayas finas en planta (apunta a +x, hacia la ciudad); la matriz isométrica
// lo acuesta sobre el mar y el giro lo hace barrer
const R = 640;
// cada raya arranca más lejos cuanto más vecinas tiene: cerca de la linterna hay una sola,
// y el abanico se va poblando sin empastarse
const rayos = [-4, -3, -2, -1, 0, 1, 2, 3, 4].map((k) => {
  const a = (k * 1.2 * Math.PI) / 180;
  const r0 = k === 0 ? 14 : Math.abs(k) === 4 ? 46 : k % 2 ? 150 : 84;
  const r1 = R * (k % 2 ? 0.7 : 1);
  const p = (r: number) => `${(r * Math.cos(a)).toFixed(1)} ${(r * Math.sin(a)).toFixed(1)}`;
  return `M${p(r0)}L${p(r1)}`;
}).join('');
// destello de la linterna: estrella de rayitas, como se graba una luz
const destello = Array.from({ length: 12 }, (_, i) => {
  const a = (i * Math.PI) / 6, r1 = i % 2 ? 6.5 : 9.5;
  return `M${(4 * Math.cos(a)).toFixed(1)} ${(4 * Math.sin(a)).toFixed(1)}L${(r1 * Math.cos(a)).toFixed(1)} ${(r1 * Math.sin(a)).toFixed(1)}`;
}).join('');

// barco: lancha de pesca chica, en los ejes de la maqueta, con la proa a +x (hacia la boca).
// Medidas en metros aproximados. Se ven la banda que da al mar, la cubierta y los techos.
const L = 11, B = 3; // media eslora, media manga
const zc = (x: number) => 2.1 + 1.3 * Math.max(0, x / L) ** 2; // la cubierta sube hacia la proa
const xs = [-L, -L * 0.5, L * 0.2, L * 0.65, L], an = [0.85, 1, 1, 0.62, 0];
const borda = (lado: number) => xs.map((x, i) => iso(x, lado * B * an[i], zc(x)));
const flot = xs.map((x, i) => iso(x * 0.94, -B * an[i] * 0.8, 0));
const barco = {
  casco: pol(...borda(-1), ...[...flot].reverse()),
  cubierta: pol(...borda(-1), ...borda(1).reverse().slice(1)),
  timonera: pol(iso(-8, -1.7, 2.1), iso(-3, -1.7, 2.1), iso(-3, -1.7, 5.1), iso(-8, -1.7, 5.1)) + pol(iso(-3, -1.7, 2.1), iso(-3, 1.7, 2.1), iso(-3, 1.7, 5.1), iso(-3, -1.7, 5.1)),
  ventanas: lin(iso(-7.2, -1.7, 4.2), iso(-3.8, -1.7, 4.2)) + lin(iso(-3, -1.1, 4.2), iso(-3, 1.1, 4.2)),
  techo: pol(iso(-8.4, -2.1, 5.1), iso(-2.6, -2.1, 5.1), iso(-2.6, 2.1, 5.1), iso(-8.4, 2.1, 5.1)),
  palo: lin(iso(2, 0, zc(2)), iso(2, 0, 11)) + lin(iso(2, 0, 4.1), iso(7, 0, 6)),
  jarcia: lin(iso(2, 0, 11), iso(L, 0, zc(L))) + lin(iso(2, 0, 11), iso(-3, 0, 5.1)),
  agua: lin(iso(-L * 0.9, -B - 0.9, 0), iso(-L * 0.2, -B - 0.9, 0)) + lin(iso(0, -B - 1.9, 0), iso(L * 0.6, -B - 1.9, 0)),
  estela: lin(iso(-L - 1, -1.6, 0), iso(-L - 11, -3.4, 0)) + lin(iso(-L - 1, 1.6, 0), iso(-L - 11, 3.4, 0)) + lin(iso(-L - 13, -0.6, 0), iso(-L - 18, -0.9, 0)),
};
// recorrido del barco, en unidades de la maqueta: entra por el borde de mar y fondea frente a la boca
const llegada = { x: 461, y: 1004 }, salida = { x: 1054, y: 698 };

// --- avión: aterriza y despega en la pista real, hacia el oeste (contra el viento del oeste) ---
// El suelo de la maqueta viene de scripts/maqueta.mjs: proyección y cabeceras de la pista en (a, y, z).
const { OX, OY, costaY, pista } = m.suelo;
const C = Math.cos(Math.PI / 6), S = 0.5;
const enPantalla = (a: number, y: number, z = 0): [number, number] => [OX - C * (a + y - costaY), OY + S * (a - y + costaY) - z];
const [este, oeste] = pista;
const largoPista = Math.hypot(oeste[0] - este[0], oeste[1] - este[1]);
const fa = (oeste[0] - este[0]) / largoPista, fy = (oeste[1] - este[1]) / largoPista; // hacia adelante
const sobrePista = (k: number, z: number) => {
  // k: unidades desde la cabecera este (negativo: antes de la pista); z: altura sobre la pista
  const zs = este[2] + ((oeste[2] - este[2]) * Math.min(1, Math.max(0, k / largoPista)));
  return { aire: enPantalla(este[0] + fa * k, este[1] + fy * k, zs + z), suelo: enPantalla(este[0] + fa * k, este[1] + fy * k, zs) };
};
// recorrido: aproximación sobre la ciudad, toque, carrera hasta frenar; después despegue y trepada
const tramos = [sobrePista(-300, 78), sobrePista(22, 0), sobrePista(150, 0), sobrePista(8, 0), sobrePista(128, 0), sobrePista(470, 92)];
const varsAvion = tramos
  .map((t, i) => `--ax${i}:${t.aire[0].toFixed(1)};--ay${i}:${t.aire[1].toFixed(1)};--sx${i}:${t.suelo[0].toFixed(1)};--sy${i}:${t.suelo[1].toFixed(1)}`)
  .join(';');
// el dibujo, en metros, en ejes del avión (x hacia la nariz, y hacia el ala izquierda), llevado a
// los ejes de la maqueta y proyectado sin desplazamiento (el centro del avión en 0,0)
const ESC = 1.35;
const la = -fy, ly = fa; // hacia el ala
const pa = (x: number, y: number, z = 0): [number, number] => {
  const a = (fa * x + la * y) * ESC, b = (fy * x + ly * y) * ESC;
  return [-C * (a + b), S * (a - b) - z * ESC];
};
const poly = (...p: [number, number][]) => 'M' + p.map(([u, v]) => `${u.toFixed(1)} ${v.toFixed(1)}`).join('L') + 'Z';
const avion = {
  fuselaje: poly(pa(17, 0), pa(15.6, 1.2), pa(13, 1.9), pa(-13, 1.9), pa(-17, 0.6), pa(-17.6, 0), pa(-17, -0.6), pa(-13, -1.9), pa(13, -1.9), pa(15.6, -1.2)),
  alas: poly(pa(4, 1.8), pa(-5, 16.5), pa(-8, 16.5), pa(-4.5, 1.8)) + poly(pa(4, -1.8), pa(-5, -16.5), pa(-8, -16.5), pa(-4.5, -1.8)),
  cola: poly(pa(-13.5, 1.4), pa(-16.6, 6.2), pa(-18, 6.2), pa(-17, 1)) + poly(pa(-13.5, -1.4), pa(-16.6, -6.2), pa(-18, -6.2), pa(-17, -1)),
  motores: [6, -6].map((y) => poly(pa(2.6, y + 0.9), pa(2.6, y - 0.9), pa(-1.2, y - 0.9), pa(-1.2, y + 0.9))).join(''),
  deriva: poly(pa(-12, 0, 0.4), pa(-16.6, 0, 7.6), pa(-18.2, 0, 7.6), pa(-17.4, 0, 0.4)),
  ventanillas: 'M' + [pa(11, 1.1), pa(-11, 1.1)].map(([u, v]) => `${u.toFixed(1)} ${v.toFixed(1)}`).join('L'),
};
const sombra = avion.fuselaje + avion.alas + avion.cola;

// --- satélite: cruza el cielo por una órbita punteada, de la estepa hacia el mar abierto ---
// en unidades de la maqueta (el cielo es lo que queda arriba y a la derecha del bloque)
const orbita = 'M700 70 Q1380 120 1700 820';
---
<section class="hero-a" aria-labelledby="hero-titulo">
  <div class="ventana">
    <div class="plano">
      <div role="img" aria-label="Maqueta grabada de la costa norte de Río Grande, Tierra del Fuego, vista desde el mar: adelante la ciudad con la Torre de Agua junto a la desembocadura del río Grande; detrás el aeropuerto, la Ruta 3 y la Misión Salesiana; al fondo, el Cabo Domingo con su baliza encendida sobre el acantilado. Un barco chico llega a la boca del río.">
        <Maqueta />
      </div>
      <div class="barco" aria-hidden="true" style={`--x:${llegada.x};--y:${llegada.y};--dx:${salida.x - llegada.x};--dy:${salida.y - llegada.y}`}>
        <svg viewBox="-24 -27 74 38">
          <g transform="scale(1.8)" fill="none" stroke="var(--tinta)" stroke-linejoin="round" stroke-linecap="round">
            <path class="estela" d={barco.estela} stroke="var(--tinta-suave)" stroke-width="0.4" />
            <path d={barco.agua} stroke="var(--tinta-suave)" stroke-width="0.4" />
            <path d={barco.casco} fill="var(--tinta)" stroke-width="0.5" />
            <path d={barco.cubierta} fill="var(--papel)" stroke-width="0.5" />
            <path d={barco.timonera} fill="var(--papel)" stroke-width="0.45" />
            <path d={barco.ventanas} stroke-width="0.6" />
            <path d={barco.techo} fill="var(--tinta)" stroke-width="0.4" />
            <path d={barco.palo} stroke-width="0.5" />
            <path d={barco.jarcia} stroke-width="0.25" />
          </g>
        </svg>
      </div>
      <svg class="cielo" aria-hidden="true" viewBox={`0 0 ${m.ancho} ${m.alto}`}>
        <path id="a-orbita" d={orbita} fill="none" stroke="var(--tinta-suave)" stroke-width="0.9" stroke-dasharray="1.5 5" stroke-linecap="round" />
        <g class="satelite">
          <g transform="scale(1.6)" fill="var(--papel)" stroke="var(--tinta)" stroke-width="0.7" stroke-linejoin="round">
            <path d="M-16 -3.2h10v6.4h-10zM6 -3.2h10v6.4h-10z" />
            <path d="M-13.5 -3.2v6.4M-11 -3.2v6.4M-8.5 -3.2v6.4M8.5 -3.2v6.4M11 -3.2v6.4M13.5 -3.2v6.4M-16 0h10M6 0h10" fill="none" stroke-width="0.4" />
            <path d="M-6 0h2.6M6 0h-2.6" fill="none" />
            <path d="M-3.4 -3.6h6.8v7.2h-6.8z" fill="var(--tinta)" />
            <path d="M0 3.6v3M-2.4 8.6a2.6 1.4 0 0 1 4.8 0" fill="none" stroke-width="0.6" />
          </g>
          <animateMotion class="vuelo" dur="70s" begin="4.5s" repeatCount="indefinite" rotate="auto" keyPoints="0;1" keyTimes="0;1" calcMode="linear">
            <mpath href="#a-orbita" />
          </animateMotion>
        </g>
      </svg>
      <div class="sombra-avion" aria-hidden="true" style={varsAvion}>
        <svg viewBox="-30 -30 60 60"><path d={sombra} fill="var(--tinta)" /></svg>
      </div>
      <div class="avion" aria-hidden="true" style={varsAvion}>
        <svg viewBox="-30 -30 60 60">
          <g stroke="var(--tinta)" stroke-linejoin="round" stroke-linecap="round">
            <path d={avion.alas + avion.cola} fill="var(--tinta)" stroke-width="0.4" />
            <path d={avion.motores} fill="var(--papel)" stroke-width="0.5" />
            <path d={avion.fuselaje} fill="var(--papel)" stroke-width="0.7" />
            <path d={avion.ventanillas} fill="none" stroke-width="0.6" stroke-dasharray="0.6 1" />
            <path d={avion.deriva} fill="var(--papel)" stroke-width="0.6" />
          </g>
        </svg>
      </div>
      <div class="haz" aria-hidden="true" style={`--x:${luz.x};--y:${luz.y.toFixed(1)};--r:${R}`}>
        <svg viewBox={`0 -56 ${R} 112`}>
          <defs>
            <radialGradient id="a-haz" gradientUnits="userSpaceOnUse" cx="0" cy="0" r={R}>
              <stop offset="0" style="stop-color:var(--tinta)" />
              <stop offset="0.45" style="stop-color:var(--tinta)" stop-opacity="0.55" />
              <stop offset="1" style="stop-color:var(--tinta)" stop-opacity="0" />
            </radialGradient>
          </defs>
          <path d={rayos} fill="none" stroke="url(#a-haz)" stroke-width="1" stroke-linecap="round" />
        </svg>
      </div>
      <svg class="destello" aria-hidden="true" viewBox="-12 -12 24 24" style={`--x:${luz.x};--y:${luz.y.toFixed(1)}`}>
        <path d={destello} fill="none" stroke="var(--tinta)" stroke-width="0.8" stroke-linecap="round" />
      </svg>
    </div>
  </div>

  <div class="texto">
    <p class="coordenadas">53°47′09″ S · 67°42′07″ O</p>
    <h1 id="hero-titulo">Un laboratorio en el borde del continente</h1>
    <p class="bajada">Inteligencia artificial, satélites y software en producción. Hechos con tiempo, cerca del mar.</p>
    <div class="acciones">
      <a class="primario" href={agenda} target="_blank" rel="noopener">Agendar una reunión →</a>
      <a class="secundario" href="#laboratorio">Conocer el laboratorio ↓</a>
    </div>
  </div>

</section>

<script>
  // lo que no está en pantalla no se anima
  const hero = document.querySelector('.hero-a');
  const cielo = hero?.querySelector<SVGSVGElement>('.cielo');
  const quieto = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (cielo && quieto) {
    // SMIL no escucha a CSS: el satélite queda a mitad de órbita
    cielo.pauseAnimations();
    cielo.setCurrentTime(4.5 + 35);
  }
  if (hero)
    new IntersectionObserver(([e]) => {
      hero.classList.toggle('fuera', !e.isIntersecting);
      if (cielo && !quieto) e.isIntersecting ? cielo.unpauseAnimations() : cielo.pauseAnimations();
    }).observe(hero);
</script>

<style>
  .hero-a {
    --alto: max(680px, 100svh);
    /* px por unidad de la maqueta: la escala la da el ancho (la ciudad se corta contra el borde
       izquierdo) hasta donde deja el alto: el cabo debajo de la barra y la boca del río adentro */
    --u: min(100vw * 0.00068, (var(--alto) - 100px) / 803);
    --w: calc(var(--u) * 1443); /* el texto se mide con la misma escala que el dibujo */
    position: relative;
    height: var(--alto);
    overflow: hidden;
  }
  /* el dibujo se funde en diagonal antes de llegar al texto: el papel del titular queda limpio */
  .ventana {
    position: absolute;
    inset: 0;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(150deg, transparent calc(var(--w) * 0.4), #000 calc(var(--w) * 0.432));
    mask-image: linear-gradient(150deg, transparent calc(var(--w) * 0.4), #000 calc(var(--w) * 0.432));
  }
  /* y debajo de la barra: un velo de papel para que el relieve no le llegue a los enlaces */
  .ventana::after {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 104px;
    background: linear-gradient(var(--papel) 64px, transparent);
  }
  /* el plano de la maqueta (1732 × 1111 unidades); lo que va encima se ubica con --x y --y */
  .plano {
    position: absolute;
    right: calc(var(--u) * -182);
    bottom: calc(var(--u) * -52);
    width: calc(var(--u) * 1732);
    height: calc(var(--u) * 1111);
  }
  .barco,
  .haz,
  .destello {
    position: absolute;
    left: calc(var(--u) * var(--x));
    top: calc(var(--u) * var(--y));
  }

  /* la linterna se enciende */
  .destello {
    width: calc(var(--u) * 24);
    height: calc(var(--u) * 24);
    margin: calc(var(--u) * -12) 0 0 calc(var(--u) * -12);
    animation: a-encender 0.9s 3.3s cubic-bezier(0.2, 0.7, 0.2, 1) backwards;
  }
  @keyframes a-encender {
    from {
      opacity: 0;
      transform: scale(0.3);
    }
  }

  /* el haz: la matriz isométrica acuesta el abanico; el giro lo lleva del horizonte a la costa.
     Aparece cuando la linterna ya está encendida */
  .haz {
    width: 0;
    height: 0;
    transform: matrix(-0.866025, 0.5, -0.866025, -0.5, 0, 0);
    animation: a-asomar 1.2s 3.8s backwards;
  }
  @keyframes a-asomar {
    from {
      opacity: 0;
    }
  }
  .haz svg {
    position: absolute;
    left: 0;
    top: calc(var(--u) * -56);
    width: calc(var(--u) * var(--r));
    height: calc(var(--u) * 112);
    transform-origin: 0 50%;
    transform: rotate(-52deg);
    /* el ciclo arranca 10 s adelantado: la primera pasada empieza donde el haz ya se ve largo,
       apuntando al mar de adelante, y no asomando por el borde derecho */
    animation: a-barrer 24s linear -10s infinite;
  }
  @keyframes a-barrer {
    0% {
      transform: rotate(-110deg);
      opacity: 0;
    }
    4%,
    80% {
      opacity: 1;
    }
    86%,
    100% {
      transform: rotate(-27deg);
      opacity: 0;
    }
  }

  /* el barco entra desde el borde de mar y fondea frente a la boca del río */
  .barco {
    width: calc(var(--u) * 74);
    height: calc(var(--u) * 38);
    margin: calc(var(--u) * -27) 0 0 calc(var(--u) * -24);
    animation: a-llegar 26s cubic-bezier(0.25, 0.5, 0.3, 1) 3.4s backwards;
  }
  .barco svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
    animation: a-vaiven 5s ease-in-out infinite alternate;
  }
  .estela {
    opacity: 0;
    animation: a-estela 26s linear 3.4s backwards;
  }
  @keyframes a-llegar {
    from {
      transform: translate(calc(var(--u) * var(--dx)), calc(var(--u) * var(--dy)));
      opacity: 0;
    }
    8% {
      opacity: 1;
    }
  }
  @keyframes a-estela {
    0%,
    70% {
      opacity: 1;
    }
  }
  @keyframes a-vaiven {
    from {
      transform: translateY(-0.7px) rotate(-0.8deg);
    }
    to {
      transform: translateY(0.7px) rotate(0.8deg);
    }
  }
  /* el avión: aterriza, frena, se va a la plataforma; después despega y trepa hacia el oeste.
     La sombra lo sigue por el suelo: cuanto más alto vuela, más lejos queda. */
  .avion,
  .sombra-avion {
    position: absolute;
    left: 0;
    top: 0;
    width: calc(var(--u) * 60);
    height: calc(var(--u) * 60);
    margin: calc(var(--u) * -30) 0 0 calc(var(--u) * -30);
    opacity: 0;
    animation: a-volar 44s linear 5.5s infinite;
  }
  .sombra-avion {
    animation-name: a-sombra;
  }
  .avion svg,
  .sombra-avion svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  @keyframes a-volar {
    0% {
      transform: translate(calc(var(--u) * var(--ax0)), calc(var(--u) * var(--ay0)));
      opacity: 0;
    }
    2% {
      opacity: 1;
    }
    16% {
      transform: translate(calc(var(--u) * var(--ax1)), calc(var(--u) * var(--ay1)));
      animation-timing-function: cubic-bezier(0.2, 0.6, 0.35, 1);
    }
    25%,
    31% {
      transform: translate(calc(var(--u) * var(--ax2)), calc(var(--u) * var(--ay2)));
      opacity: 1;
    }
    33%,
    55% {
      transform: translate(calc(var(--u) * var(--ax2)), calc(var(--u) * var(--ay2)));
      opacity: 0;
    }
    56% {
      transform: translate(calc(var(--u) * var(--ax3)), calc(var(--u) * var(--ay3)));
      opacity: 0;
    }
    58% {
      transform: translate(calc(var(--u) * var(--ax3)), calc(var(--u) * var(--ay3)));
      opacity: 1;
      animation-timing-function: cubic-bezier(0.55, 0, 0.9, 0.6);
    }
    67% {
      transform: translate(calc(var(--u) * var(--ax4)), calc(var(--u) * var(--ay4)));
      animation-timing-function: cubic-bezier(0.3, 0.2, 0.6, 1);
    }
    80% {
      opacity: 1;
    }
    84%,
    100% {
      transform: translate(calc(var(--u) * var(--ax5)), calc(var(--u) * var(--ay5)));
      opacity: 0;
    }
  }
  @keyframes a-sombra {
    0% {
      transform: translate(calc(var(--u) * var(--sx0)), calc(var(--u) * var(--sy0)));
      opacity: 0;
    }
    2% {
      opacity: 0.12;
    }
    16% {
      transform: translate(calc(var(--u) * var(--sx1)), calc(var(--u) * var(--sy1)));
      opacity: 0.28;
      animation-timing-function: cubic-bezier(0.2, 0.6, 0.35, 1);
    }
    25%,
    31% {
      transform: translate(calc(var(--u) * var(--sx2)), calc(var(--u) * var(--sy2)));
      opacity: 0.28;
    }
    33%,
    55% {
      transform: translate(calc(var(--u) * var(--sx2)), calc(var(--u) * var(--sy2)));
      opacity: 0;
    }
    56% {
      transform: translate(calc(var(--u) * var(--sx3)), calc(var(--u) * var(--sy3)));
      opacity: 0;
    }
    58% {
