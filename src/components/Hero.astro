---
import Mapa from './Mapa.astro';
import Vista from './Vista.astro';
import { encuadre, type Proyeccion } from '../data/proyeccion';
interface Props {
  proyeccion?: Proyeccion;
}
const { proyeccion = 'plano' } = Astro.props;
const enc = encuadre(proyeccion);
// la costa del mapa cae a esta altura del hero; margin-top en % se mide sobre el ancho
const subir = ((enc.costaY / enc.ancho) * 100).toFixed(3);
const agenda = 'https://calendar.app.google/ucnmS77YVC4ax2TE9';
---
<section class="hero" aria-labelledby="hero-titulo">
  <div class="texto">
    <h1 id="hero-titulo">Un laboratorio en el borde del continente</h1>
    <p class="bajada">Inteligencia artificial, satélites y software en producción. Hechos con tiempo, cerca del mar.</p>
    <div class="acciones">
      <a class="primario" href={agenda} target="_blank" rel="noopener">Agendar una reunión →</a>
      <a class="secundario" href="#laboratorio">Conocer el laboratorio ↓</a>
    </div>
  </div>

  <div class={`arte ${proyeccion}`} style={`--subir:${subir}`} role="img" aria-label="Mapa grabado de la costa norte de Río Grande, Tierra del Fuego: el Cabo Domingo con su baliza, la Misión Salesiana, la Ruta 3, la ciudad y la desembocadura del río Grande.">
    <Mapa proyeccion={proyeccion} />
  </div>

  <div class="lamina">
    <Vista />
  </div>

  <p class="coordenadas">53°47′09″ S · 67°42′07″ O</p>
</section>

<style>
  .hero {
    position: relative;
    height: max(680px, 100svh);
    overflow: hidden;
  }
  .texto {
    position: relative;
    z-index: 2;
    padding: 132px var(--margen) 0;
    max-width: calc(var(--margen) * 2 + 620px);
  }
  h1 {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(46px, 5.6vw, 84px);
    line-height: 1;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }
  .bajada {
    margin-top: 18px;
    font-size: 19px;
    line-height: 1.45;
    max-width: 36ch;
  }
  .acciones {
    margin-top: 26px;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .acciones a {
    padding: 15px 22px;
    font-weight: 600;
    font-size: 16px;
    text-decoration: none;
  }
  .primario {
    background: var(--tinta);
    color: var(--papel);
  }
  .secundario {
    color: var(--tinta);
    border: 1px solid var(--tinta-suave);
    background: var(--papel);
  }
  .acciones a:focus-visible {
    outline: 2px solid var(--tinta);
    outline-offset: 3px;
  }
  .arte {
    position: absolute;
    left: 0;
    width: calc(100% * var(--zoom, 1));
    top: 74%;
    margin-top: calc(-1% * var(--subir) * var(--zoom, 1));
  }
  .arte.caballera {
    --zoom: 1.45;
    left: -24%;
    top: 75%;
  }
  .arte.isometrica {
    --zoom: 1.45;
    left: -22%;
    top: 58%;
  }
  .lamina {
    position: absolute;
    z-index: 1;
    right: var(--margen);
    top: 21%;
    width: min(54vw, 860px);
  }
  .coordenadas {
    position: absolute;
    z-index: 2;
    right: var(--margen);
    top: 96px;
    font: 400 11px var(--mono);
    letter-spacing: 0.12em;
    color: var(--tinta-suave);
  }
  @media (max-width: 820px) {
    .lamina {
      display: none;
    }
    /* en el teléfono se acerca al cabo y la misión */
    .arte {
      --zoom: 2.6;
      left: -12%;
      top: 70%;
    }
    .texto {
      padding-top: 100px;
    }
    .coordenadas {
      top: auto;
      bottom: 12px;
    }
  }
</style>
