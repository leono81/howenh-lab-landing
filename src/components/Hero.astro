---
const agenda = 'https://calendar.app.google/ucnmS77YVC4ax2TE9';
---
<section class="hero" aria-labelledby="hero-titulo">
  <div class="texto">
    <h1 id="hero-titulo">Un laboratorio en el borde del continente</h1>
    <p class="bajada">Inteligencia artificial, satélites y software en producción. Hechos con tiempo, cerca del mar.</p>
    <div class="acciones">
      <a class="primario" href={agenda} target="_blank" rel="noopener">Agendar una reunión →</a>
      <a class="secundario" href="#laboratorio">Conocer el laboratorio ↓</a>
    </div>
  </div>

  <div class="arte" role="img" aria-label="Grabado de la costa norte de Río Grande, Tierra del Fuego, vista desde el mar: la ciudad, la Misión Salesiana y el faro del Cabo Domingo sobre la estepa.">
    <canvas class="relieve"></canvas>
    <svg class="vinetas" aria-hidden="true"></svg>
  </div>

  <p class="coordenadas">53°47′09″ S · 67°42′07″ O</p>
</section>

<style>
  .hero {
    position: relative;
    height: max(680px, 100svh);
    overflow: hidden;
  }
  .texto {
    position: relative;
    z-index: 2;
    padding: 132px var(--margen) 0;
    max-width: calc(var(--margen) * 2 + 620px);
  }
  h1 {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(46px, 5.6vw, 84px);
    line-height: 1;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }
  .bajada {
    margin-top: 18px;
    font-size: 19px;
    line-height: 1.45;
    max-width: 36ch;
  }
  .acciones {
    margin-top: 26px;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .acciones a {
    padding: 15px 22px;
    font-weight: 600;
    font-size: 16px;
    text-decoration: none;
  }
  .primario {
    background: var(--tinta);
    color: var(--papel);
  }
  .secundario {
    color: var(--tinta);
    border: 1px solid var(--tinta-suave);
    background: var(--papel);
  }
  .acciones a:focus-visible {
    outline: 2px solid var(--tinta);
    outline-offset: 3px;
  }
  .arte {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 60%;
  }
  .relieve,
  .vinetas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .relieve {
    -webkit-mask-image: linear-gradient(transparent, #000 26%), linear-gradient(to right, transparent, #000 9%, #000 91%, transparent);
    -webkit-mask-composite: source-in;
    mask-image: linear-gradient(transparent, #000 26%), linear-gradient(to right, transparent, #000 9%, #000 91%, transparent);
    mask-composite: intersect;
  }
  .vinetas {
    overflow: visible;
    pointer-events: none;
  }
  .coordenadas {
    position: absolute;
    z-index: 2;
    right: var(--margen);
    top: 96px;
    font: 400 11px var(--mono);
    letter-spacing: 0.12em;
    color: var(--tinta-suave);
  }
  :global(.barco) {
    position: absolute;
    left: 0;
    top: 0;
    width: 86px;
    height: auto;
    will-change: transform;
    pointer-events: none;
  }
  /* vida de las viñetas: lenta y chica, como el faro */
  .vinetas :global(.aspas) {
    transform-box: fill-box;
    transform-origin: center;
    animation: girar 14s linear infinite;
  }
  .vinetas :global(.oveja) {
    animation: pastar var(--d, 26s) ease-in-out infinite alternate;
  }
  .vinetas :global(.humo) {
    animation: humo 7s ease-out infinite;
    animation-delay: var(--r, 0s);
    opacity: 0;
  }
  .vinetas :global(.ventana) {
    animation: luz 9s ease-in-out infinite;
    animation-delay: var(--r, 0s);
  }
  @keyframes girar {
    to {
      transform: rotate(360deg);
    }
  }
  @keyframes pastar {
    to {
      transform: translateX(var(--x, 14px));
    }
  }
  @keyframes humo {
    0% {
      opacity: 0;
      transform: translate(0, 0);
    }
    20% {
      opacity: 0.7;
    }
    100% {
      opacity: 0;
      transform: translate(10px, -22px);
    }
  }
  @keyframes luz {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.35;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .vinetas :global(*) {
      animation: none !important;
    }
    .vinetas :global(.humo) {
      opacity: 0.5;
    }
  }
  @media (max-width: 820px) {
    .texto {
      padding-top: 100px;
    }
    .arte {
      height: 46%;
    }
    .coordenadas {
      top: auto;
      bottom: 12px;
    }
  }
</style>

<script>
  import { Panorama } from '../scripts/panorama';
  import { teñir } from '../scripts/grabado';
  import meta from '../data/relieve.json';

  const cargar = (src: string) =>
    new Promise<HTMLImageElement>((ok, mal) => {
      const i = new Image();
      i.onload = () => ok(i);
      i.onerror = mal;
      i.src = src;
    });
  const ease = (t: number) => 1 - Math.pow(1 - Math.min(1, Math.max(0, t)), 3);
  const NS = 'http://www.w3.org/2000/svg';

  function svg(tag: string, attrs: Record<string, string | number>, padre?: Element) {
    const el = document.createElementNS(NS, tag);
    for (const [k, v] of Object.entries(attrs)) el.setAttribute(k, String(v));
    padre?.appendChild(el);
    return el;
  }

  /** Viñetas en tinta, más grandes que su escala real, apoyadas en el relieve. */
  function vinetas(capa: SVGSVGElement, p: Panorama, tinta: string, papel: string) {
    capa.innerHTML = '';
    const defs = svg('defs', {}, capa);
    const trama = svg('pattern', { id: 'trama', width: 3, height: 3, patternUnits: 'userSpaceOnUse', patternTransform: 'rotate(35)' }, defs);
    svg('line', { x1: 0, y1: 0, x2: 0, y2: 3, stroke: tinta, 'stroke-width': 1.1 }, trama);
    const trazo = { stroke: tinta, 'stroke-width': 1.4, 'stroke-linejoin': 'round' };
    const lugar = (k: 'faro' | 'mision' | 'ciudad') => {
      const [x, f] = meta.lugares[k];
      return p.proyectar(x, f, p.alturaEn(x, f));
    };
    const escala = Math.min(1.5, Math.max(0.85, capa.clientWidth / 1100));

    // Baliza del cabo: torre a bandas
    const [fx, fy] = lugar('faro');
    const faro = svg('g', { transform: `translate(${fx} ${fy}) scale(${escala})` }, capa);
    svg('rect', { x: -6, y: -40, width: 12, height: 40, fill: papel, ...trazo }, faro);
    for (const y of [-34, -22, -10]) svg('rect', { x: -6, y, width: 12, height: 6, fill: tinta }, faro);
    svg('rect', { x: -8, y: -45, width: 16, height: 5, fill: tinta }, faro);
    svg('path', { d: 'M-5 -45 L0 -52 L5 -45 Z', fill: tinta }, faro);

    // Misión: capilla, galpones, molino y ovejas
    const [mx, my] = lugar('mision');
    const mision = svg('g', { transform: `translate(${mx} ${my}) scale(${escala})` }, capa);
    svg('rect', { x: -46, y: -16, width: 40, height: 16, fill: 'url(#trama)', ...trazo }, mision);
    svg('path', { d: 'M-48 -16 L-26 -26 L-4 -16 Z', fill: papel, ...trazo }, mision);
    svg('rect', { x: -2, y: -26, width: 16, height: 26, fill: papel, ...trazo }, mision);
    svg('path', { d: 'M-4 -26 L6 -40 L16 -26 Z', fill: 'url(#trama)', ...trazo }, mision);
    svg('path', { d: 'M6 -40 V-48 M3 -45 H9', ...trazo, fill: 'none' }, mision);
    svg('rect', { x: 18, y: -12, width: 30, height: 12, fill: 'url(#trama)', ...trazo }, mision);
    svg('path', { d: 'M62 0 L66 -30 L70 0 M63 -10 H69 M64 -20 H68', ...trazo, fill: 'none' }, mision);
    const aspas = svg('g', { class: 'aspas' }, mision);
    svg('path', { d: 'M66 -42 V-18 M54 -30 H78 M58 -38 L74 -22 M58 -22 L74 -38', ...trazo, 'stroke-width': 1, fill: 'none' }, aspas);
    [[-60, 6, '24s', '16px'], [-36, 9, '31s', '-12px'], [26, 7, '28s', '14px'], [44, 10, '35s', '-10px']].forEach(([x, y, d, dx]) => {
      const o = svg('g', { class: 'oveja', style: `--d:${d};--x:${dx}` }, mision);
      svg('ellipse', { cx: x, cy: y, rx: 4.5, ry: 3, fill: papel, ...trazo, 'stroke-width': 1 }, o);
      svg('circle', { cx: +x + 4.5, cy: +y - 1.5, r: 1.6, fill: tinta }, o);
    });

    // Ciudad: casas bajas y algunos bloques, ventanas que se encienden, humo de chimeneas
    const [cx, cy] = lugar('ciudad');
    const ciudad = svg('g', { transform: `translate(${cx} ${cy}) scale(${escala})` }, capa);
    const edificios: [number, number, number][] = [
      [-80, 10, 9], [-69, 12, 14], [-55, 9, 8], [-44, 14, 22], [-28, 10, 11], [-16, 12, 16], [-2, 9, 9], [9, 16, 28], [27, 11, 13], [40, 9, 8], [51, 13, 18], [66, 10, 10], [78, 12, 12],
    ];
    let semilla = 3;
    const azar = () => ((semilla = (semilla * 16807) % 2147483647) / 2147483647);
    edificios.forEach(([x, w, h], i) => {
      svg('rect', { x, y: -h, width: w, height: h, fill: i % 3 ? 'url(#trama)' : papel, ...trazo }, ciudad);
      if (h > 12) for (let k = 0; k < Math.floor(h / 8); k++) {
        svg('rect', { class: 'ventana', x: x + 3, y: -h + 4 + k * 7, width: 2.4, height: 2.4, fill: '#f2c14e', style: `--r:${(azar() * 9).toFixed(1)}s` }, ciudad);
      }
    });
    for (const [x, y] of [[-66, -16], [-26, -13], [70, -12]]) {
      svg('path', { d: `M${x} ${y} v-4`, ...trazo, fill: 'none' }, ciudad);
      for (let k = 0; k < 2; k++) svg('path', { class: 'humo', d: `M${x} ${y - 6} q 3 -4 0 -8 q -3 -4 0 -8`, stroke: tinta, 'stroke-width': 0.8, fill: 'none', style: `--r:${k * 3.5}s` }, ciudad);
    }

    // Órbita de un satélite sobre el mar
    const W = capa.clientWidth;
    const orbita = svg('path', { d: `M${W * 0.52} -40 Q ${W * 0.8} 10 ${W * 1.05} 120`, stroke: tinta, 'stroke-opacity': 0.5, 'stroke-width': 1, 'stroke-dasharray': '1 6', fill: 'none' }, capa) as SVGPathElement;
    const sat = svg('g', {}, capa);
    svg('rect', { x: -2.5, y: -2.5, width: 5, height: 5, fill: tinta }, sat);
    svg('path', { d: 'M-9 0 H-3 M3 0 H9', stroke: tinta, 'stroke-width': 2.4 }, sat);
    return { orbita, sat };
  }

  async function iniciar() {
    const arte = document.querySelector<HTMLElement>('.hero .arte')!;
    const canvas = arte.querySelector<HTMLCanvasElement>('.relieve')!;
    const capa = arte.querySelector<SVGSVGElement>('.vinetas')!;
    const [relieve, barcoImg] = await Promise.all([cargar('/img/relieve.png'), cargar('/img/barco.png')]);
    const lienzo = document.createElement('canvas');
    lienzo.width = relieve.width;
    lienzo.height = relieve.height;
    const lc = lienzo.getContext('2d')!;
    lc.drawImage(relieve, 0, 0);
    const css = getComputedStyle(document.documentElement);
    const tinta = css.getPropertyValue('--tinta').trim();
    const papel = css.getPropertyValue('--papel').trim();
    const p = new Panorama(canvas, meta, lc.getImageData(0, 0, relieve.width, relieve.height), tinta, papel);
    let v = vinetas(capa, p, tinta, papel);

    const rgb = tinta.match(/\w\w/g)!.map((h) => parseInt(h, 16)) as [number, number, number];
    const barco = teñir(barcoImg, [0.04, 0.17, 0.3, 0.58], rgb);
    barco.className = 'barco';
    arte.appendChild(barco);
    // el barco llega desde mar abierto hacia la desembocadura, cerca de la ciudad
    const barcoEn = (t: number) => {
      const a = ease((t - 2) / 16);
      const [cx] = meta.lugares.ciudad;
      return p.proyectar(560 - a * (560 - cx - 60), 250 - a * 40);
    };
    const ubicar = (t: number) => {
      const [x, y] = barcoEn(t);
      const s = 0.7 + 0.3 * ((y / arte.clientHeight) || 0);
      barco.style.transform = `translate(${x - 43}px, ${y - 70 + Math.sin(t * 1.3) * 1.2}px) scaleX(-1) scale(${s})`;
      const largo = v.orbita.getTotalLength();
      const q = v.orbita.getPointAtLength(((t * 0.035) % 1.2) * largo);
      v.sat.setAttribute('transform', `translate(${q.x} ${q.y}) rotate(25)`);
    };

    addEventListener('resize', () => {
      p.medir();
      v = vinetas(capa, p, tinta, papel);
    });

    if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
      ubicar(18);
      p.dibujar(1, 0, 1);
      return;
    }
    let visible = true;
    new IntersectionObserver(([e]) => (visible = e.isIntersecting)).observe(arte);
    const t0 = performance.now();
    const cuadro = (ahora: number) => {
      requestAnimationFrame(cuadro);
      if (!visible || document.hidden) return;
      const t = (ahora - t0) / 1000;
      p.dibujar(ease(t / 1.8), t, ease((t - 2.2) / 1));
      ubicar(t);
    };
    requestAnimationFrame(cuadro);
  }

  iniciar();
</script>
