---
// Hero: la maqueta isométrica de la costa a sangre; el texto vive en el papel de arriba a la
// izquierda y el resto es mar abierto. La maqueta se apaga en el papel con un borde irregular.
// Todo lo que se mueve va con SMIL dentro de un solo svg (.cielo) superpuesto a la maqueta, en sus
// mismas unidades: la luz de la baliza, el barco, los camiones de la Ruta 3, el avión, el
// satélite y el mar. Con animaciones CSS sobre divs encima de la maqueta enmascarada, Chrome la
// re-rasteriza en cada cuadro y en pantallas de 2x la maqueta desaparece; con SMIL no pasa.
import Maqueta from './Maqueta.astro';
import Taiyin from './Taiyin.astro';
import m from '../data/maqueta.json';
import { iso, pol, lin, rayas, type P } from '../data/iso';
const agenda = 'https://calendar.app.google/ucnmS77YVC4ax2TE9';

const { OX, OY, costaY, AMAX, pista } = m.suelo;
const C = Math.cos(Math.PI / 6), S = 0.5;
// del suelo de la maqueta (a a lo largo de la costa, y tierra adentro, z alto) a la pantalla
const enPantalla = (a: number, y: number, z = 0): P => [OX - C * (a + y - costaY), OY + S * (a - y + costaY) - z];
const f1 = (v: number) => (Math.round(v * 10) / 10).toString();
const camino = (pts: P[]) => 'M' + pts.map(([u, v]) => `${f1(u)} ${f1(v)}`).join('L');
let semilla = 7;
const azar = () => (semilla = (semilla * 16807) % 2147483647) / 2147483647;

// ---------- la luz de la baliza ----------
// La linterna (MaquetaBaliza a escala 2,1, linterna a 10,2 m). El haz gira en planta (una vuelta
// cada 12 s) y la matriz isométrica lo acuesta sobre el mar: se ve mientras barre el mar (de 190°
// a 350°, con 270° mar adentro) y se apaga sobre la tierra. Cuando apunta a quien mira (315°) la
// linterna destella.
const [bx, by] = m.lugares.baliza;
const luz = { x: bx, y: by - 10.2 * 2.1 };
// en el teléfono, con el scroll, la ventana va de la baliza a la Torre de Agua (en unidades de la maqueta)
const [tx, ty] = m.lugares.torre;
const paseo = `--paseo-x: ${f1(bx - tx)}; --paseo-y: ${f1(by - ty)}`;
const VUELTA = 12, FASE = 3.6 - (190 / 360) * VUELTA; // a los 3,6 s el haz ya asoma sobre el mar
const R = 620;
const cuna = (abre: number, r0: number, r1: number) => {
  const a = (abre * Math.PI) / 180, p = (r: number, s: number) => `${f1(r * Math.cos(s * a))} ${f1(r * Math.sin(s * a))}`;
  return `M${p(r0, -1)}L${p(r1, -1)}A${r1} ${r1} 0 0 1 ${p(r1, 1)}L${p(r0, 1)}Z`;
};
// En una sola tinta la luz es papel: el haz aclara el grabado que pisa (el mar se ve más blanco
// donde pasa) y lo marcan dos bordes finos de tinta, con un par de rayos tenues adentro.
const rayo = (g: number, r0: number, r1: number) => {
  const a = (g * Math.PI) / 180;
  return `M${f1(r0 * Math.cos(a))} ${f1(r0 * Math.sin(a))}L${f1(r1 * Math.cos(a))} ${f1(r1 * Math.sin(a))}`;
};
const bordesHaz = rayo(-6.2, 12, R * 0.92) + rayo(6.2, 12, R * 0.92);
const rayosHaz = rayo(-3.6, 40, R * 0.62) + rayo(-1.6, 26, R * 0.8) + rayo(0, 18, R) + rayo(1.6, 26, R * 0.8) + rayo(3.6, 40, R * 0.62);
const estrella = (n: number, r0: number, r1: number, r2: number) =>
  Array.from({ length: n }, (_, i) => {
    const a = (i * 2 * Math.PI) / n, r = i % 2 ? r1 : r2;
    return `M${f1(r0 * Math.cos(a))} ${f1(r0 * Math.sin(a))}L${f1(r * Math.cos(a))} ${f1(r * Math.sin(a))}`;
  }).join('');

// ---------- el barco ----------
// Lancha de pesca en los ejes de la maqueta (metros, ×1,8). Navega paralela a la costa, lento,
// cruza todo el cuadro y sale; más adelante vuelve otro, más afuera, en sentido contrario.
const L = 11, B = 3;
const zc = (x: number) => 2.1 + 1.3 * Math.max(0, x / L) ** 2;
const xs = [-L, -L * 0.5, L * 0.2, L * 0.65, L], an = [0.85, 1, 1, 0.62, 0];
const hacerBarco = (s: number) => {
  // s = 1: la proa a +a (hacia la ciudad); s = -1: hacia el cabo. Se ve la banda que da al mar.
  const q = (x: number, y: number, z: number) => iso(s * x, y, z);
  const borda = (lado: number) => xs.map((x, i) => q(x, lado * B * an[i], zc(x)));
  const flot = xs.map((x, i) => q(x * 0.94, -B * an[i] * 0.8, 0));
  return {
    casco: pol(...borda(-1), ...[...flot].reverse()),
    cubierta: pol(...borda(-1), ...borda(1).reverse().slice(1)),
    timonera: pol(q(-8, -1.7, 2.1), q(-3, -1.7, 2.1), q(-3, -1.7, 5.1), q(-8, -1.7, 5.1)) + pol(q(-3, -1.7, 2.1), q(-3, 1.7, 2.1), q(-3, 1.7, 5.1), q(-3, -1.7, 5.1)),
    ventanas: lin(q(-7.2, -1.7, 4.2), q(-3.8, -1.7, 4.2)) + lin(q(-3, -1.1, 4.2), q(-3, 1.1, 4.2)),
    techo: pol(q(-8.4, -2.1, 5.1), q(-2.6, -2.1, 5.1), q(-2.6, 2.1, 5.1), q(-8.4, 2.1, 5.1)),
    palo: lin(q(2, 0, zc(2)), q(2, 0, 11)) + lin(q(2, 0, 4.1), q(7, 0, 6)),
    jarcia: lin(q(2, 0, 11), q(L, 0, zc(L))) + lin(q(2, 0, 11), q(-3, 0, 5.1)),
    proa: lin(q(L + 1, -1.2, 0), q(L + 5, -2.6, 0)) + lin(q(L + 1, 1.2, 0), q(L + 4, 2.4, 0)),
    estela: lin(q(-L - 1, -1.6, 0), q(-L - 13, -3.8, 0)) + lin(q(-L - 1, 1.6, 0), q(-L - 13, 3.8, 0)) + lin(q(-L - 15, -0.6, 0), q(-L - 22, -1, 0)) + lin(q(-L - 17, 2, 0), q(-L - 24, 2.6, 0)),
  };
};
const barcos = [
  // dur: lo que tarda en cruzar; el ciclo de 130 s deja un rato de mar sin barcos entre uno y otro
  { dibujo: hacerBarco(1), d: camino([enPantalla(-120, costaY - 165), enPantalla(AMAX + 160, costaY - 165)]), empieza: 0.0, termina: 0.46, escala: 1.8 },
  { dibujo: hacerBarco(-1), d: camino([enPantalla(AMAX + 160, costaY - 290), enPantalla(-120, costaY - 290)]), empieza: 0.52, termina: 0.98, escala: 1.65 },
];
const CICLO_MAR = 130;

// ---------- camiones por la Ruta 3 ----------
// Del oeste, pasando el cabo, por la costa hasta la rotonda; de ahí por el Acceso Norte y las
// avenidas hasta la plaza de la torre (scripts/maqueta.mjs). Entra uno cada 15 s y cada uno tarda
// 30 s: nunca hay más de dos en pantalla. El dibujo va girado para que, con rotate="auto",
// quede derecho cuando el camión avanza hacia la ciudad (+a, a 150° en pantalla).
// Caja y cabina en los ejes de la maqueta (metros, ×1,7), mirando a +a.
const T = 1.7;
const tq = (x: number, y: number, z: number) => iso(x * T, y * T, z * T);
const camion = {
  caja: pol(tq(-8, -1.3, 1), tq(4.5, -1.3, 1), tq(4.5, -1.3, 4.1), tq(-8, -1.3, 4.1)),
  cajaFrente: pol(tq(4.5, -1.3, 1), tq(4.5, 1.3, 1), tq(4.5, 1.3, 4.1), tq(4.5, -1.3, 4.1)),
  cajaTecho: pol(tq(-8, -1.3, 4.1), tq(4.5, -1.3, 4.1), tq(4.5, 1.3, 4.1), tq(-8, 1.3, 4.1)),
  cabina: pol(tq(5, -1.2, 1), tq(7.6, -1.2, 1), tq(7.6, -1.2, 3.4), tq(5, -1.2, 3.4)),
  cabinaFrente: pol(tq(7.6, -1.2, 1), tq(7.6, 1.2, 1), tq(7.6, 1.2, 3.4), tq(7.6, -1.2, 3.4)),
  cabinaTecho: pol(tq(5, -1.2, 3.4), tq(7.6, -1.2, 3.4), tq(7.6, 1.2, 3.4), tq(5, 1.2, 3.4)),
  vidrio: pol(tq(7.6, -1, 2.3), tq(7.6, 1, 2.3), tq(7.6, 1, 3.1), tq(7.6, -1, 3.1)),
  ruedas: [-6.5, -4.6, 1.8, 6.4].map((x) => `M${tq(x, -1.35, 0.55).map(f1).join(' ')}h0`).join(''),
};
const camiones = [{ empieza: 4.5 }, { empieza: 19.5 }];
const VIAJE = 30;

// ---------- el avión ----------
// Aterriza y despega en la pista real, hacia el oeste (contra el viento del oeste). La sombra lo
// sigue por el suelo: cuanto más alto vuela, más lejos queda.
const [este, oeste] = pista;
const largoPista = Math.hypot(oeste[0] - este[0], oeste[1] - este[1]);
const fa = (oeste[0] - este[0]) / largoPista, fy = (oeste[1] - este[1]) / largoPista;
const sobrePista = (k: number, z: number) => {
  const zs = este[2] + (oeste[2] - este[2]) * Math.min(1, Math.max(0, k / largoPista));
  return { aire: enPantalla(este[0] + fa * k, este[1] + fy * k, zs + z), suelo: enPantalla(este[0] + fa * k, este[1] + fy * k, zs) };
};
const tramos = [sobrePista(-300, 78), sobrePista(22, 0), sobrePista(150, 0), sobrePista(8, 0), sobrePista(128, 0), sobrePista(470, 92)];
const tramo = (pts: P[]) => {
  const l1 = Math.hypot(pts[1][0] - pts[0][0], pts[1][1] - pts[0][1]), l2 = Math.hypot(pts[2][0] - pts[1][0], pts[2][1] - pts[1][1]);
  return { d: camino(pts), k: (l1 / (l1 + l2)).toFixed(4) };
};
const llega = { aire: tramo([0, 1, 2].map((i) => tramos[i].aire)), suelo: tramo([0, 1, 2].map((i) => tramos[i].suelo)) };
const sale = { aire: tramo([3, 4, 5].map((i) => tramos[i].aire)), suelo: tramo([3, 4, 5].map((i) => tramos[i].suelo)) };
const CICLO = '44s', ARRANQUE = '5.5s';
// llegada: aproxima (0-16 %), toca y frena (16-25 %), se va a la plataforma (31-33 %)
const LLEGA = { keyTimes: '0;0.16;0.25;1', splines: '0 0 1 1;0.2 0.6 0.35 1;0 0 1 1', opacidad: '0;1;1;0;0', tiempos: '0;0.02;0.31;0.33;1', sombra: '0;0.12;0.28;0.28;0;0', tiemposSombra: '0;0.02;0.16;0.31;0.33;1' };
// salida: espera (hasta 56 %), carrera acelerando (56-67 %), trepa (67-84 %)
const SALE = { keyTimes: '0;0.56;0.67;0.84;1', splines: '0 0 1 1;0.55 0 0.9 0.6;0.3 0.2 0.6 1;0 0 1 1', opacidad: '0;0;1;1;0;0', tiempos: '0;0.555;0.58;0.8;0.84;1', sombra: '0;0;0.28;0.28;0;0', tiemposSombra: '0;0.555;0.58;0.67;0.84;1' };
const ESC = 1.35;
const la = -fy, ly = fa;
const pa = (x: number, y: number, z = 0): P => {
  const a = (fa * x + la * y) * ESC, b = (fy * x + ly * y) * ESC;
  return [-C * (a + b), S * (a - b) - z * ESC];
};
const avion = {
  fuselaje: pol(pa(17, 0), pa(15.6, 1.2), pa(13, 1.9), pa(-13, 1.9), pa(-17, 0.6), pa(-17.6, 0), pa(-17, -0.6), pa(-13, -1.9), pa(13, -1.9), pa(15.6, -1.2)),
  alas: pol(pa(4, 1.8), pa(-5, 16.5), pa(-8, 16.5), pa(-4.5, 1.8)) + pol(pa(4, -1.8), pa(-5, -16.5), pa(-8, -16.5), pa(-4.5, -1.8)),
  cola: pol(pa(-13.5, 1.4), pa(-16.6, 6.2), pa(-18, 6.2), pa(-17, 1)) + pol(pa(-13.5, -1.4), pa(-16.6, -6.2), pa(-18, -6.2), pa(-17, -1)),
  motores: [6, -6].map((y) => pol(pa(2.6, y + 0.9), pa(2.6, y - 0.9), pa(-1.2, y - 0.9), pa(-1.2, y + 0.9))).join(''),
  deriva: pol(pa(-12, 0, 0.4), pa(-16.6, 0, 7.6), pa(-18.2, 0, 7.6), pa(-17.4, 0, 0.4)),
  ventanillas: camino([pa(11, 1.1), pa(-11, 1.1)]),
};
const sombraAvion = avion.fuselaje + avion.alas + avion.cola;

// ---------- el satélite ----------
// Sube desde el mar, pasa sobre el cabo y la estepa y se pone antes de llegar al texto: un arco
// de órbita que no cruza ni la barra ni el titular (en 1440 × 900 va de (1440, 520) a (720, 200)
// con la cima en (1100, 110)). Debajo, la línea hasta el suelo y la huella que se enciende.
const [mx, my] = m.lugares.mision;
const O0: P = [bx + 126, by + 305], O1: P = [bx - 176, by - 314], O2: P = [mx - 196, my - 202];
const orbita = `M${f1(O0[0])} ${f1(O0[1])} Q${f1(O1[0])} ${f1(O1[1])} ${f1(O2[0])} ${f1(O2[1])}`;
// En los ejes de la maqueta, como el camión y la torre: x a lo largo de la costa, y tierra
// adentro, z arriba. Se ven el techo, la cara que da al mar (-y) y la que da a la ciudad (+x).
// Cuerpo con aislante rayado (más oscuro en la cara a la sombra), dos alas de paneles con su
// canto, antena parabólica que mira a la tierra, cámara, mástil y una luz que parpadea.
const sat = (() => {
  const X = 4, Y = 5, Z = 4; // medio cuerpo
  const caja = {
    techo: pol(iso(-X, -Y, Z), iso(X, -Y, Z), iso(X, Y, Z), iso(-X, Y, Z)),
    frente: pol(iso(-X, -Y, -Z), iso(X, -Y, -Z), iso(X, -Y, Z), iso(-X, -Y, Z)),
    lado: pol(iso(X, -Y, -Z), iso(X, Y, -Z), iso(X, Y, Z), iso(X, -Y, Z)),
  };
  // aislante: rayas diagonales en el frente, apretadas en el lado (a la sombra)
  const aislante = rayas(iso(-X, -Y, -Z), iso(-X, -Y, Z), iso(X, -Y, -Z), iso(X, -Y, Z), 7);
  const sombra = rayas(iso(X, -Y, -Z), iso(X, -Y, Z), iso(X, Y, -Z), iso(X, Y, Z), 12);
  const costuras = lin(iso(-X, -Y, 0), iso(X, -Y, 0), iso(X, Y, 0));
  // un ala: de x0 a x1, ancho ±6, espesor ±0,6; celdas de 5 × 2
  const ala = (x0: number, x1: number) => {
    const W = 6, E = 0.6;
    let celdas = '';
    for (let i = 1; i < 5; i++) {
      const x = x0 + ((x1 - x0) * i) / 5;
      celdas += lin(iso(x, -W, E), iso(x, W, E));
    }
    celdas += lin(iso(x0, 0, E), iso(x1, 0, E));
    const [a, b] = [Math.min(x0, x1), Math.max(x0, x1)];
    return {
      cara: pol(iso(a, -W, E), iso(b, -W, E), iso(b, W, E), iso(a, W, E)),
      canto: pol(iso(a, -W, -E), iso(b, -W, -E), iso(b, -W, E), iso(a, -W, E)) + (b > 0 ? pol(iso(b, -W, -E), iso(b, W, -E), iso(b, W, E), iso(b, -W, E)) : ''),
      celdas,
      brazo: lin(iso(x0 > 0 ? X : -X, 0, 0), iso(x0, 0, 0)),
    };
  };
  // antena parabólica abajo, mirando a la tierra; la cámara al frente, también hacia abajo
  const aro = (cx: number, cy: number, z: number, r: number) => pol(...Array.from({ length: 28 }, (_, i) => iso(cx + r * Math.cos((i * Math.PI) / 14), cy + r * Math.sin((i * Math.PI) / 14), z)));
  return {
    caja,
    aislante,
    sombra,
    costuras,
    lejos: ala(-8, -30),
    cerca: ala(8, 30),
    plato: aro(0, 1, -Z - 3.2, 4.2),
    hondo: aro(0, 1, -Z - 2.4, 2.4),
    sosten: lin(iso(0, 1, -Z), iso(0, 1, -Z - 2.4)) + lin(iso(0, 1, -Z - 3.2), iso(0, 1, -Z - 6)),
    camara: pol(iso(1.2, -Y, -Z + 1.2), iso(3.4, -Y, -Z + 1.2), iso(3.4, -Y - 1.6, -Z + 1.2), iso(1.2, -Y - 1.6, -Z + 1.2)) + pol(iso(1.2, -Y - 1.6, -Z + 1.2), iso(3.4, -Y - 1.6, -Z + 1.2), iso(3.4, -Y - 1.6, -Z - 1), iso(1.2, -Y - 1.6, -Z - 1)),
    mastil: lin(iso(-1.5, -1.5, Z), iso(-1.5, -1.5, Z + 6.5)),
    luz: iso(-1.5, -1.5, Z + 7.3),
    pie: iso(0, 1, -Z - 6),
  };
})();
const ESC_SAT = 1.45;

// ---------- el mar ----------
// Olas sueltas, cortas y paralelas a la costa, que aparecen, avanzan un poco hacia la orilla y se
// van; cada una a su ritmo.
const deriva = enPantalla(0, 9).map((v, i) => v - enPantalla(0, 0)[i]);
const olas = Array.from({ length: 34 }, () => {
  const a = 30 + azar() * (AMAX - 60), y = costaY - 26 - azar() ** 0.75 * 330, l = 5 + azar() * 6;
  const p0 = enPantalla(a - l, y), p1 = enPantalla(a, y + 1.4), p2 = enPantalla(a + l, y);
  return { d: `M${f1(p0[0])} ${f1(p0[1])}Q${f1(p1[0])} ${f1(p1[1])} ${f1(p2[0])} ${f1(p2[1])}`, dur: (6 + azar() * 5).toFixed(1), desde: (azar() * 10).toFixed(1), w: (0.5 + azar() * 0.5).toFixed(2) };
});
---
<section class="hero-a" aria-labelledby="hero-titulo">
  <!-- el texto va antes que la maqueta en el HTML: el svg pesa ~1 MB y, si el texto llegaba
       después, el teléfono pintaba la maqueta arriba y la corría al llegar el texto (CLS 0,52) -->
  <div class="texto">
    <p class="coordenadas entra" style="--d: 3.7s">53°47′09″ S · 67°42′07″ O</p>
    <h1 class="entra" id="hero-titulo" style="--d: 0s">Un laboratorio en el borde del continente</h1>
    <p class="bajada entra" style="--d: 4.3s">Inteligencia artificial, satélites y software en producción. Hechos con tiempo, cerca del mar.</p>
    <div class="acciones entra" style="--d: 4.6s">
      <a class="primario" href={agenda} target="_blank" rel="noopener">Agendar una reunión →</a>
      <a class="secundario" href="#laboratorio">Conocer el laboratorio ↓</a>
    </div>
    <div class="entra" style="--d: 4.9s"><Taiyin /></div>
  </div>
  <div class="ventana">
    <div class="plano" style={paseo}>
      <div role="img" aria-label="Maqueta grabada de la costa norte de Río Grande, Tierra del Fuego, vista desde el mar: adelante la ciudad con la Torre de Agua junto a la desembocadura del río Grande; detrás el aeropuerto, la Ruta 3 y la Misión Salesiana; al fondo, el Cabo Domingo con su baliza encendida sobre el acantilado. Por el mar pasa un barco, por la ruta llegan camiones a la ciudad, un avión aterriza y despega y un satélite cruza el cielo.">
        <Maqueta />
      </div>
      <svg class="cielo" aria-hidden="true" viewBox={`0 0 ${m.ancho} ${m.alto}`}>
        <defs>
          <radialGradient id="a-luz" gradientUnits="userSpaceOnUse" cx="0" cy="0" r={R}>
            <stop offset="0" style="stop-color:var(--papel)" stop-opacity="0.95" />
            <stop offset="0.45" style="stop-color:var(--papel)" stop-opacity="0.6" />
            <stop offset="1" style="stop-color:var(--papel)" stop-opacity="0" />
          </radialGradient>
          <radialGradient id="a-rayo" gradientUnits="userSpaceOnUse" cx="0" cy="0" r={R}>
            <stop offset="0" style="stop-color:var(--acento)" />
            <stop offset="0.5" style="stop-color:var(--acento)" stop-opacity="0.5" />
            <stop offset="1" style="stop-color:var(--acento)" stop-opacity="0" />
          </radialGradient>
          <radialGradient id="a-aura">
            <stop offset="0" style="stop-color:var(--papel)" />
            <stop offset="0.55" style="stop-color:var(--papel)" stop-opacity="0.85" />
            <stop offset="1" style="stop-color:var(--papel)" stop-opacity="0" />
          </radialGradient>
          <path id="a-orbita" d={orbita} />
          <linearGradient id="a-orbita-g" gradientUnits="userSpaceOnUse" x1={O0[0]} y1={O0[1]} x2={O2[0]} y2={O2[1]}>
            <stop offset="0" style="stop-color:var(--tinta-suave)" stop-opacity="0" />
            <stop offset="0.18" style="stop-color:var(--tinta-suave)" stop-opacity="0.7" />
            <stop offset="0.82" style="stop-color:var(--tinta-suave)" stop-opacity="0.7" />
            <stop offset="1" style="stop-color:var(--tinta-suave)" stop-opacity="0" />
          </linearGradient>
          <path id="a-ruta" d={m.recorrido} />
        </defs>

        <!-- el mar: olas sueltas que van hacia la orilla -->
        <g class="olas" fill="none" stroke="var(--tinta-suave)" stroke-linecap="round" opacity="0">
          {olas.map((o) => (
            <path d={o.d} stroke-width={o.w} opacity="0">
              <animate attributeName="opacity" values="0;0.9;0" dur={`${o.dur}s`} begin={`-${o.desde}s`} repeatCount="indefinite" />
              <animateTransform attributeName="transform" type="translate" from="0 0" to={`${f1(deriva[0])} ${f1(deriva[1])}`} dur={`${o.dur}s`} begin={`-${o.desde}s`} repeatCount="indefinite" />
            </path>
          ))}
          <animate attributeName="opacity" from="0" to="1" begin="2.2s" dur="1.5s" fill="freeze" />
        </g>

        <!-- barcos: uno hacia la ciudad, después otro más afuera hacia el cabo -->
        {barcos.map((b) => (
          <g opacity="0">
            <g transform={`scale(${b.escala})`} fill="none" stroke="var(--tinta)" stroke-linejoin="round" stroke-linecap="round">
              <path d={b.dibujo.estela + b.dibujo.proa} stroke="var(--tinta-suave)" stroke-width="0.4" />
              <g>
                <path d={b.dibujo.casco} fill="var(--tinta)" stroke-width="0.5" />
                <path d={b.dibujo.cubierta} fill="var(--papel)" stroke-width="0.5" />
                <path d={b.dibujo.timonera} fill="var(--papel)" stroke-width="0.45" />
                <path d={b.dibujo.ventanas} stroke-width="0.6" />
                <path d={b.dibujo.techo} fill="var(--tinta)" stroke-width="0.4" />
                <path d={b.dibujo.palo} stroke-width="0.5" />
                <path d={b.dibujo.jarcia} stroke-width="0.25" />
                <animateTransform attributeName="transform" type="rotate" values="-1;1;-1" dur="5.5s" repeatCount="indefinite" />
              </g>
            </g>
            <animateMotion path={b.d} dur={`${CICLO_MAR}s`} begin="4s" repeatCount="indefinite" keyPoints="0;0;1;1" keyTimes={`0;${b.empieza};${b.termina};1`} calcMode="linear" />
            <animate attributeName="opacity" values="0;0;1;1;0;0" keyTimes={`0;${b.empieza};${(b.empieza + 0.01).toFixed(3)};${(b.termina - 0.01).toFixed(3)};${b.termina};1`} dur={`${CICLO_MAR}s`} begin="4s" repeatCount="indefinite" />
          </g>
        ))}

        <!-- camiones por la Ruta 3, llegando a la ciudad -->
        {camiones.map((k) => (
          <g opacity="0" stroke="var(--tinta)" stroke-linejoin="round" stroke-linecap="round">
            <g transform="rotate(-150)">
            <path d={camion.cajaTecho} fill="var(--papel)" stroke-width="0.45" />
            <path d={camion.caja} fill="var(--papel)" stroke-width="0.5" />
            <path d={camion.cajaFrente} fill="var(--tinta)" stroke-width="0.4" />
            <path d={camion.cabinaTecho} fill="var(--papel)" stroke-width="0.4" />
            <path d={camion.cabina} fill="var(--tinta)" stroke-width="0.4" />
            <path d={camion.cabinaFrente} fill="var(--papel)" stroke-width="0.45" />
            <path d={camion.vidrio} fill="var(--tinta)" stroke="none" />
            <path d={camion.ruedas} fill="none" stroke-width="1.4" />
            </g>
            <animateMotion dur={`${VIAJE}s`} begin={`${k.empieza}s`} repeatCount="indefinite" rotate="auto">
              <mpath href="#a-ruta" />
            </animateMotion>
            <animate attributeName="opacity" values="0;1;1;0" keyTimes="0;0.05;0.9;1" dur={`${VIAJE}s`} begin={`${k.empieza}s`} repeatCount="indefinite" />
          </g>
        ))}

        <!-- el avión -->
        <g class="vuelos">
          {[{ v: llega, t: LLEGA }, { v: sale, t: SALE }].map(({ v, t }) => (
            <>
              <path d={sombraAvion} fill="var(--tinta)" opacity="0">
                <animateMotion path={v.suelo.d} dur={CICLO} begin={ARRANQUE} repeatCount="indefinite" calcMode="spline" keyPoints={t.keyTimes.split(';').length === 4 ? `0;${v.suelo.k};1;1` : `0;0;${v.suelo.k};1;1`} keyTimes={t.keyTimes} keySplines={t.splines} />
                <animate attributeName="opacity" values={t.sombra} keyTimes={t.tiemposSombra} dur={CICLO} begin={ARRANQUE} repeatCount="indefinite" />
              </path>
              <g stroke="var(--tinta)" stroke-linejoin="round" stroke-linecap="round" opacity="0">
                <path d={avion.alas + avion.cola} fill="var(--tinta)" stroke-width="0.4" />
                <path d={avion.motores} fill="var(--papel)" stroke-width="0.5" />
                <path d={avion.fuselaje} fill="var(--papel)" stroke-width="0.7" />
                <path d={avion.ventanillas} fill="none" stroke-width="0.6" stroke-dasharray="0.6 1" />
                <path d={avion.deriva} fill="var(--papel)" stroke-width="0.6" />
                <animateMotion path={v.aire.d} dur={CICLO} begin={ARRANQUE} repeatCount="indefinite" calcMode="spline" keyPoints={t.keyTimes.split(';').length === 4 ? `0;${v.aire.k};1;1` : `0;0;${v.aire.k};1;1`} keyTimes={t.keyTimes} keySplines={t.splines} />
                <animate attributeName="opacity" values={t.opacidad} keyTimes={t.tiempos} dur={CICLO} begin={ARRANQUE} repeatCount="indefinite" />
              </g>
            </>
          ))}
        </g>

        <!-- la luz de la baliza: el haz que barre el mar y el destello cuando mira hacia acá -->
        <g id="haz-baliza" transform={`translate(${f1(luz.x)} ${f1(luz.y)})`} opacity="0">
          <g transform={`matrix(${-C} ${S} ${-C} ${-S} 0 0)`}>
            <g opacity="0">
              <path d={cuna(11, 6, R * 0.75)} fill="url(#a-luz)" opacity="0.55" />
              <path d={cuna(6.2, 5, R)} fill="url(#a-luz)" />
              <path d={bordesHaz} fill="none" stroke="url(#a-rayo)" stroke-width="0.9" stroke-linecap="round" />
              <path d={rayosHaz} fill="none" stroke="url(#a-rayo)" stroke-width="0.45" stroke-linecap="round" opacity="0.5" />
              <animateTransform attributeName="transform" type="rotate" from="0" to="360" dur={`${VUELTA}s`} begin={`${f1(FASE)}s`} repeatCount="indefinite" />
              <animate attributeName="opacity" values="0;0;1;1;0;0" keyTimes="0;0.5;0.54;0.95;0.985;1" dur={`${VUELTA}s`} begin={`${f1(FASE)}s`} repeatCount="indefinite" />
            </g>
          </g>
          <circle r="20" fill="url(#a-aura)" />
          <g fill="none" stroke="var(--acento)" stroke-linecap="round">
            <path d={estrella(24, 4.2, 9, 15)} stroke-width="0.65" />
            <animate attributeName="opacity" values="0.4;0.4;1;0.4;0.4" keyTimes="0;0.83;0.875;0.92;1" dur={`${VUELTA}s`} begin={`${f1(FASE)}s`} repeatCount="indefinite" />
            <animateTransform attributeName="transform" type="scale" values="0.7;0.7;1.8;0.7;0.7" keyTimes="0;0.83;0.875;0.92;1" dur={`${VUELTA}s`} begin={`${f1(FASE)}s`} repeatCount="indefinite" />
          </g>
          <animate attributeName="opacity" from="0" to="1" begin="3.3s" dur="1s" fill="freeze" />
        </g>

        <!-- el satélite y su órbita -->
        <g class="satelite" opacity="0">
          <use href="#a-orbita" fill="none" stroke="url(#a-orbita-g)" stroke-width="0.9" stroke-dasharray="1.5 5" stroke-linecap="round" />
          <g opacity="0">
            <!-- la línea al suelo y la huella, que se enciende cada tanto -->
            <path d={`M0 ${f1(sat.pie[1] * ESC_SAT + 2)}V150`} stroke="var(--tinta-suave)" stroke-width="0.6" stroke-dasharray="1 3.5" opacity="0.7" />
            <g transform="translate(0 150)">
              <ellipse rx="18" ry="10.4" fill="none" stroke="var(--acento)" stroke-width="0.7">
                <animate attributeName="rx" values="4;26" dur="2.8s" repeatCount="indefinite" />
                <animate attributeName="ry" values="2.3;15" dur="2.8s" repeatCount="indefinite" />
                <animate attributeName="opacity" values="0.9;0" dur="2.8s" repeatCount="indefinite" />
              </ellipse>
              <ellipse rx="3" ry="1.7" fill="var(--acento)" />
            </g>
            <!-- el satélite, en tres dimensiones: de atrás hacia adelante -->
            <g stroke="var(--tinta)" stroke-linejoin="round" stroke-linecap="round" transform={`scale(${ESC_SAT})`}>
              <!-- ala de atrás -->
              <path d={sat.lejos.brazo} fill="none" stroke-width="0.8" />
              <path d={sat.lejos.canto} fill="var(--tinta)" stroke-width="0.4" />
              <path d={sat.lejos.cara} fill="var(--papel)" stroke-width="0.6" />
              <path d={sat.lejos.celdas} fill="none" stroke-width="0.35" />
              <!-- antena parabólica, abajo -->
              <path d={sat.sosten} fill="none" stroke-width="0.5" />
              <path d={sat.plato} fill="var(--papel)" stroke-width="0.6" />
              <path d={sat.hondo} fill="none" stroke-width="0.35" />
              <!-- cuerpo -->
              <path d={sat.caja.frente} fill="var(--papel)" stroke-width="0.6" />
              <path d={sat.aislante} fill="none" stroke-width="0.35" />
              <path d={sat.caja.lado} fill="var(--papel)" stroke-width="0.6" />
              <path d={sat.sombra} fill="none" stroke-width="0.45" />
              <path d={sat.caja.techo} fill="var(--papel)" stroke-width="0.6" />
              <path d={sat.costuras} fill="none" stroke-width="0.35" />
              <path d={sat.camara} fill="var(--tinta)" stroke-width="0.4" />
              <!-- ala de adelante -->
              <path d={sat.cerca.brazo} fill="none" stroke-width="0.8" />
              <path d={sat.cerca.canto} fill="var(--tinta)" stroke-width="0.4" />
              <path d={sat.cerca.cara} fill="var(--papel)" stroke-width="0.6" />
              <path d={sat.cerca.celdas} fill="none" stroke-width="0.35" />
              <!-- mástil con la luz que parpadea -->
              <path d={sat.mastil} fill="none" stroke-width="0.5" />
              <g transform={`translate(${f1(sat.luz[0])} ${f1(sat.luz[1])})`}>
                <circle r="3" fill="none" stroke="var(--acento)" stroke-width="0.4" opacity="0">
                  <animate attributeName="r" values="0.8;0.8;4.2;4.2" keyTimes="0;0.06;0.4;1" dur="1.9s" repeatCount="indefinite" />
                  <animate attributeName="opacity" values="0;0.9;0;0" keyTimes="0;0.06;0.4;1" dur="1.9s" repeatCount="indefinite" />
                </circle>
                <circle r="0.95" fill="var(--acento)" stroke="none" opacity="0.25">
                  <animate attributeName="opacity" values="0.25;1;0.25;0.25" keyTimes="0;0.05;0.22;1" dur="1.9s" repeatCount="indefinite" />
                </circle>
              </g>
            </g>
            <!-- cruza en 40 s y vuelve a subir 12 s después; arranca adelantado para verse ya al cargar -->
            <animateMotion dur="52s" begin="-14s" repeatCount="indefinite" keyPoints="0;1;1" keyTimes="0;0.77;1" calcMode="linear">
              <mpath href="#a-orbita" />
            </animateMotion>
            <animate attributeName="opacity" values="0;1;1;0;0" keyTimes="0;0.08;0.69;0.77;1" dur="52s" begin="-14s" repeatCount="indefinite" />
          </g>
          <animate attributeName="opacity" from="0" to="1" begin="4s" dur="1.5s" fill="freeze" />
        </g>
      </svg>
    </div>
  </div>

</section>

<script>
  // lo que no está en pantalla no se anima; con movimiento reducido, todo quieto en un buen momento
  const hero = document.querySelector('.hero-a');
  const cielo = hero?.querySelector<SVGSVGElement>('.cielo');
  const quieto = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (cielo && quieto) {
    // SMIL no escucha a CSS: queda el avión parado en la pista, el haz sobre el mar, un barco y los camiones en la ruta
    cielo.pauseAnimations();
    cielo.setCurrentTime(5.5 + 0.28 * 44);
    // y la ciudad de la maqueta, ya crecida
    const maqueta = hero?.querySelector<SVGSVGElement>('.maqueta');
    maqueta?.pauseAnimations();
    maqueta?.setCurrentTime(10);
  }
  // el cierre (Nosotros.astro) muestra este mismo haz con <use>, que sigue el reloj de .cielo:
  // corre mientras se vea el hero o el cabo del cierre
  if (hero && cielo && !quieto) {
    const vistos = new Set<Element>();
    const io = new IntersectionObserver((es) => {
      es.forEach((e) => (e.isIntersecting ? vistos.add(e.target) : vistos.delete(e.target)));
      vistos.size ? cielo.unpauseAnimations() : cielo.pauseAnimations();
    });
    io.observe(hero);
    const cabo = document.querySelector('.cabo');
    if (cabo) io.observe(cabo);
  }
</script>

<style>
  .hero-a {
    --alto: max(680px, 100svh);
    /* px por unidad de la maqueta: la escala la da el ancho hasta donde deja el alto */
    --u: min(100vw * 0.00076, (var(--alto) - 90px) / 760);
    --w: calc(var(--u) * 1300); /* el texto se mide con la misma escala que el dibujo */
    position: relative;
    height: var(--alto);
    overflow: hidden;
  }
  /* el papel del titular queda limpio: un claro ovalado alrededor del texto, sin rectas.
     Es papel pintado encima y no una máscara: una máscara CSS sobre .ventana obliga a redibujar
     la maqueta entera en cada cuadro de animación, y en pantallas de 2x la maqueta desaparece. */
  .ventana {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }
  .ventana::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(calc(var(--w) * 0.43) calc(var(--w) * 0.27) at calc(var(--margen) + var(--w) * 0.19) calc(var(--w) * 0.17), var(--papel) 62%, transparent 100%),
      linear-gradient(transparent calc(100% - 140px), var(--papel)); /* abajo se apaga: sigue la página */
  }
  /* el plano de la maqueta; lo que se mueve va en .cielo, con sus mismas unidades */
  .plano {
    position: absolute;
    right: calc(var(--u) * -230);
    bottom: calc(var(--u) * -175);
    width: calc(var(--u) * 1935);
    height: calc(var(--u) * 1229);
  }
  /* en su propia capa: lo que se mueve no obliga a redibujar la maqueta */
  .cielo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
    will-change: transform;
  }

  .texto {
    position: relative;
    z-index: 2;
    padding: max(84px, var(--w) * 0.07) var(--margen) 0;
  }
  .coordenadas {
    white-space: nowrap; /* una línea siempre, con o sin la mono cargada: nada se corre */
    margin-bottom: calc(var(--w) * 0.012);
    font: 400 11px / 16px var(--mono); /* alto fijo: ′ y ″ no están en Martian Mono y salen de otra fuente */
    letter-spacing: 0.12em;
    color: var(--tinta-suave);
  }
  h1 {
    font-family: var(--serif);
    font-weight: 400;
    font-size: calc(var(--w) * 0.05);
    line-height: 1;
    letter-spacing: -0.01em;
    max-width: 14em;
    text-wrap: balance;
  }
  .bajada {
    margin-top: calc(var(--w) * 0.012);
    font-size: max(15px, var(--w) * 0.0142);
    line-height: 1.45;
    max-width: 46ch;
  }
  .acciones {
    margin-top: calc(var(--w) * 0.018);
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .acciones a {
    padding: 0.9em 1.35em;
    font-weight: 600;
    font-size: max(14px, var(--w) * 0.0122);
    text-decoration: none;
    white-space: nowrap;
  }
  .primario {
    background: var(--accion);
    color: var(--papel);
  }
  .secundario {
    color: var(--tinta);
    border: 1px solid var(--tinta-suave);
    background: var(--papel);
  }
  .acciones a:focus-visible {
    outline: 2px solid var(--tinta);
    outline-offset: 3px;
  }

  /* pantallas angostas: el texto arriba; abajo, una ventana de la maqueta sobre el cabo, con la
     baliza y su luz. Al bajar la página la maqueta se corre por la costa (la Misión, el
     aeropuerto) hasta la Torre de Agua (la primera del canvas https://claude.ai/artifact/7ZU4eEx85ctjRm3LZqSMMi,
     elegida el 2026-11-12). El avión y el satélite
     no se muestran. */
  @media (max-width: 900px) {
    .hero-a {
      --u: min(100vw / 460, 1.25px);
      display: flex;
      flex-direction: column;
      height: auto;
      min-height: 100svh;
    }
    .texto {
      padding-top: 92px;
    }
    .coordenadas {
      margin-bottom: 14px;
    }
    h1 {
      font-size: clamp(40px, 11.5vw, 60px);
    }
    .bajada {
      margin-top: 16px;
      font-size: 17px;
      max-width: 36ch;
    }
    .acciones {
      margin-top: 22px;
    }
    .acciones a {
      font-size: 15px;
    }
    .ventana {
      order: 3;
      position: relative;
      inset: auto;
      flex: 1 0 clamp(340px, 100vw, 70svh);
    }
    .ventana::after {
      background: linear-gradient(var(--papel), transparent 24%, transparent calc(100% - 90px), var(--papel));
    }
    .plano {
      right: auto;
      bottom: auto;
      left: calc(47vw - var(--u) * 1578);
      top: calc(38% - var(--u) * 372);
    }
    .vuelos,
    .satelite {
      display: none;
    }
  }
  /* el paseo va atado al scroll de la página: sin JS, y en el compositor. Solo donde hay
     animation-timeline: sin eso la animación terminaría al instante y la ventana quedaría en la
     ciudad. Sin soporte (Firefox, por ahora) o con movimiento reducido, queda en el faro.
     En WebKit (Safari y todo navegador de iPhone; -apple-system-body es solo suyo) también queda
     en el faro: el plano que se mueve es una capa de la maqueta entera y iOS deja pedazos sin
     pintar, con el hero en blanco (captura del 2026-11-13). */
  @supports (animation-timeline: scroll()) and (not (font: -apple-system-body)) {
    @media (max-width: 900px) and (prefers-reduced-motion: no-preference) {
      .plano {
        animation: paseo linear both;
      }
      /* en otra regla a propósito: el minificador junta animation-timeline dentro del shorthand
         `animation`, Chrome no lo acepta ahí y descarta la declaración entera */
      .ventana .plano {
        animation-timeline: scroll(root);
        animation-range: 0 55svh; /* llega a la torre mientras la ventana todavía se ve entera */
      }
    }
  }
  @keyframes paseo {
    to {
      transform: translate(calc(var(--u) * var(--paseo-x)), calc(var(--u) * var(--paseo-y)));
    }
  }
</style>
