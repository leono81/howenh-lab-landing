---
// Pruebas temporales del hero: /pruebas/caballera (el plano inclinado) y /pruebas/isometrica
// (la maqueta con el relieve levantado, scripts/maqueta.mjs).
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import HeroMaqueta from '../../components/HeroMaqueta.astro';
export const getStaticPaths = () => ['caballera', 'isometrica'].map((proyeccion) => ({ params: { proyeccion } }));
const { proyeccion } = Astro.params;
---
<Base>
  {proyeccion === 'isometrica' ? <HeroMaqueta /> : <Hero proyeccion="caballera" />}
</Base>
