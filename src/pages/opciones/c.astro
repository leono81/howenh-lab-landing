---
// Opción C del hero: recorrido con el scroll (del cabo, de cerca, a la costa entera).
import Base from '../../layouts/Base.astro';
import HeroRecorrido from '../../components/opciones/c/HeroRecorrido.astro';
---
<Base>
  <HeroRecorrido />
  <!-- lo que sigue todavía no existe: este bloque solo deja ver cómo el hero suelta la página -->
  <section id="laboratorio" class="sigue">
    <p>Laboratorio</p>
  </section>
</Base>

<style>
  .sigue {
    min-height: 70svh;
    padding: 96px var(--margen);
    border-top: 1px solid var(--tinta-suave);
  }
  .sigue p {
    font: 400 11px var(--mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--tinta-suave);
  }
</style>
