---
// Página base: cabecera, barra y estilos globales. El contenido va en el slot.
const agenda = 'https://calendar.app.google/ucnmS77YVC4ax2TE9';
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Howenh Labs · Laboratorio de inteligencia artificial en Tierra del Fuego</title>
    <meta name="description" content="Howenh Labs es un laboratorio de inteligencia artificial, datos satelitales y software en producción en Tierra del Fuego." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,300..900&family=EB+Garamond:ital,wght@0,400..700;1,400..600&family=Martian+Mono:wght@400..600&display=swap" rel="stylesheet" />
  </head>
  <body>
    <a class="saltar" href="#contenido">Saltar al contenido</a>
    <header class="barra">
      <a class="marca entra" href="/" style="--d: 3.55s"><span class="logo" aria-hidden="true"></span>HOWENH LABS</a>
      <nav class="entra" aria-label="Principal" style="--d: 3.75s">
        <a href="#laboratorio">Laboratorio</a>
        <a href="#proyectos">Proyectos</a>
        <a href="#productos">Productos</a>
        <a href="#nosotros">Nosotros</a>
        <a class="cta" href={agenda} target="_blank" rel="noopener">Agendar reunión</a>
      </nav>
    </header>
    <main id="contenido">
      <slot />
    </main>
    <footer class="pie">
      <a class="marca" href="/"><span class="logo" aria-hidden="true"></span>HOWENH LABS</a>
      <p class="pie-coordenadas">53°47′09″ S · 67°42′07″ O · Río Grande, Tierra del Fuego</p>
      <nav aria-label="Redes">
        <a href="https://www.instagram.com/howenhlabs/" target="_blank" rel="noopener">Instagram</a>
        <a href="https://www.linkedin.com/company/howenh-labs" target="_blank" rel="noopener">LinkedIn</a>
      </nav>
      <p class="pie-derechos">© 2026 Howenh Labs</p>
    </footer>
    <script is:inline>
      // las láminas de abajo (svg[data-vive]) se mueven solo cuando están en pantalla; con
      // movimiento reducido quedan quietas en el segundo que diga data-quieto
      (function () {
        var quieto = matchMedia('(prefers-reduced-motion: reduce)').matches;
        document.querySelectorAll('svg[data-vive]').forEach(function (s) {
          s.pauseAnimations();
          if (quieto) return s.setCurrentTime(+s.dataset.quieto || 0);
          new IntersectionObserver(function (e) {
            e[0].isIntersecting ? s.unpauseAnimations() : s.pauseAnimations();
          }).observe(s);
        });
      })();
    </script>
    <script is:inline>
      // primero el mapa: la letra entra después (.entra, ~3,5 s). Si la persona ya hace algo
      // (scroll, tecla, toque), se muestra todo enseguida: no se la hace esperar.
      (function () {
        var raiz = document.documentElement, ya = function () { raiz.classList.add('sin-intro'); quitar(); };
        var eventos = ['wheel', 'keydown', 'pointerdown', 'touchstart'];
        function quitar() { eventos.forEach(function (n) { removeEventListener(n, ya); }); }
        eventos.forEach(function (n) { addEventListener(n, ya, { passive: true, once: true }); });
      })();
    </script>
  </body>
</html>

<style is:global>
  :root {
    --papel: #f6f7fb;
    --tinta: #1f3a8f;
    --tinta-suave: #5b6fae;
    /* segunda tinta (magenta de carta): la luz, las señales y la acción principal */
    --acento: #b02a78;
    --accion: var(--acento);
    /* aguadas (bruma austral): lavados claros bajo el grabado para el mar, la tierra y la ciudad */
    --aguada-mar: #d6e4f1;
    --aguada-tierra: #e9eaee;
    --aguada-ciudad: #efdde8;
    --serif: 'EB Garamond', serif;
    --sans: 'Archivo', sans-serif;
    --mono: 'Martian Mono', monospace;
    --margen: 48px;
  }
  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }
  body {
    background: var(--papel);
    color: var(--tinta);
    font-family: var(--sans);
  }
  .saltar {
    position: absolute;
    left: -9999px;
  }
  .saltar:focus {
    left: 16px;
    top: 16px;
    z-index: 10;
    background: var(--papel);
    padding: 8px 12px;
  }
  /* la letra entra después del mapa, cada pieza con su demora (--d): baja apenas y se apoya,
     lenta y sin rebote, mientras aparece */
  .entra {
    animation: entrar 1.8s cubic-bezier(0.16, 0.6, 0.2, 1) var(--d, 0s) backwards;
  }
  @keyframes entrar {
    from {
      opacity: 0;
      transform: translateY(-7px);
    }
    40% {
      opacity: 0.85;
    }
  }
  .sin-intro .entra {
    animation: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .entra {
      animation: none;
    }
  }
  .barra {
    position: absolute;
    z-index: 5;
    top: 0;
    left: 0;
    right: 0;
    display: flex;
    align-items: center;
    padding: 28px var(--margen);
    font: 500 12px var(--mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .barra a {
    color: var(--tinta);
    text-decoration: none;
  }
  .marca {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font: 800 15px var(--sans);
    font-stretch: 125%;
    letter-spacing: 0.1em;
  }
  /* el logo (montaña y señal) en tinta: el png es solo la forma, se pinta con el color */
  .logo {
    width: 50px;
    height: 24px;
    background: var(--tinta);
    -webkit-mask: url('/logo.png') center / contain no-repeat;
    mask: url('/logo.png') center / contain no-repeat;
  }
  /* los enlaces se leen aunque el dibujo pase por detrás: un halo de papel */
  .barra nav a:not(.cta),
  .marca {
    text-shadow: 0 0 6px var(--papel), 0 0 3px var(--papel), 0 0 1px var(--papel);
  }
  .barra nav {
    margin-left: auto;
    display: flex;
    gap: 30px;
    align-items: center;
  }
  .barra .cta {
    border: 1px solid var(--tinta);
    padding: 9px 16px;
    background: var(--papel);
  }
  ::selection {
    background: var(--aguada-mar);
    color: var(--tinta);
  }
  a {
    color: var(--tinta);
    text-decoration-color: var(--tinta-suave);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.22em;
  }
  a:hover {
    text-decoration-color: var(--tinta);
  }
  a:focus-visible {
    outline: 2px solid var(--tinta);
    outline-offset: 3px;
  }

  /* las acciones: etiquetas impresas, rectas (las del hero se miden con la lámina) */
  .acciones {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .acciones a {
    padding: 0.9em 1.35em;
    font-weight: 600;
    font-size: clamp(14px, 1.2vw, 17px);
    text-decoration: none;
    white-space: nowrap;
  }
  .primario {
    background: var(--accion);
    color: var(--papel);
  }
  .primario:hover {
    text-decoration: underline 1px;
    text-underline-offset: 0.22em;
  }
  .secundario {
    color: var(--tinta);
    border: 1px solid var(--tinta-suave);
    background: var(--papel);
  }
  .secundario:hover {
    border-color: var(--tinta);
  }

  /* las secciones de abajo del hero: láminas sobre el papel, con aire */
  .seccion {
    padding: clamp(104px, 11vw, 176px) var(--margen) 0;
    scroll-margin-top: 24px;
  }
  .seccion h2 {
    font: 400 clamp(36px, 4.2vw, 64px) / 1.02 var(--serif);
    letter-spacing: -0.01em;
    text-wrap: balance;
    max-width: 15em;
  }
  .seccion h3 {
    font: 400 clamp(30px, 3vw, 44px) / 1.05 var(--serif);
    letter-spacing: -0.01em;
  }
  .entrada {
    margin-top: 20px;
    font-size: clamp(17px, 1.4vw, 20px);
    line-height: 1.5;
    max-width: 46ch;
    text-wrap: pretty;
  }
  .rotulo {
    font: 400 11px var(--mono);
    letter-spacing: 0.12em;
    color: var(--tinta-suave);
  }

  .pie {
    margin-top: clamp(104px, 11vw, 176px);
    padding: 28px var(--margen) 36px;
    border-top: 1px solid var(--tinta-suave);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 32px;
    font: 400 11px var(--mono);
    letter-spacing: 0.08em;
    color: var(--tinta-suave);
  }
  .pie a {
    color: var(--tinta);
  }
  .pie .marca {
    text-decoration: none;
    margin-right: auto;
  }
  .pie nav {
    display: flex;
    gap: 24px;
  }

  @media (max-width: 820px) {
    :root {
      --margen: 16px;
    }
    .pie .marca {
      width: 100%;
    }
    .barra nav a:not(.cta) {
      display: none;
    }
    .marca {
      gap: 8px;
      font-size: 13px;
      white-space: nowrap;
    }
    .logo {
      width: 38px;
      height: 18px;
    }
    .barra .cta {
      padding: 8px 10px;
      font-size: 11px;
      white-space: nowrap;
    }
  }
</style>
